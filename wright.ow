rule ("[DevTool] Toggle damage reduction") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        (Event Player).isDev == True;
        (Event Player).menu == 2;
        Is Button Held(Event Player, Button(Melee)) == True;
    }
    actions {
        Set Player Variable(Event Player, dmgReduc, Not((Event Player).dmgReduc));
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        If((Event Player).dmgReduc);
            Set Damage Received(Event Player, 1);
            Create Effect(All Players(All Teams), Ana Nano Boosted Effect, Color(Team 1), Event Player, 200, Position and Radius);
            Set Player Variable(Event Player, nanoEffect, Last Created Entity);
            Small Message(Event Player, Custom String("  {0}  开发者模式： 已将伤害减免设置为 -99%", Icon String(Bolt)));
        Else;
            Set Damage Received(Event Player, 100);
            Destroy Effect((Event Player).nanoEffect);
            Small Message(Event Player, Custom String("  {0}  开发者模式： 已取消伤害减免", Icon String(Bolt)));
    }
}

rule ("[DevTool] Toggle invincible") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        (Event Player).isDev == True;
        (Event Player).menu == 2;
        Is Button Held(Event Player, Button(Ability 1)) == True;
    }
    actions {
        Set Player Variable(Event Player, invincible, Not((Event Player).invincible));
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        If((Event Player).invincible);
            Set Status(Event Player, Null, Invincible, 999999999999);
            Create Effect(All Players(All Teams), Baptiste Immortality Field Protected Effect, Color(Team 1), Event Player, 200, Position and Radius);
            Set Player Variable At Index(Event Player, invincibleEffect, 3, Last Created Entity);
            Small Message(Event Player, Custom String("  {0}  开发者模式： 已设置为无敌状态", Icon String(Bolt)));
        Else;
            Clear Status(Event Player, Invincible);
            Destroy Effect(Value In Array((Event Player).invincibleEffect, 3));
            Set Player Variable At Index(Event Player, invincibleEffect, 3, Null);
            Small Message(Event Player, Custom String("  {0}  开发者模式： 已取消无敌状态", Icon String(Bolt)));
    }
}

rule ("[DevTool] Toggle air walk") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        (Event Player).isDev == True;
        Is Button Held(Event Player, Button(Primary Fire)) == True;
        (Event Player).menu == 3;
    }
    actions {
        Skip If(Compare((Event Player).isAirWalkEnabled, ==, True), 4);
        Set Gravity(Event Player, False);
        Set Player Variable(Event Player, isAirWalkEnabled, True);
        Small Message(Event Player, Custom String("  {0}  开发者模式： 已开启浮空", Icon String(Bolt)));
        Abort;
        Set Gravity(Event Player, 100);
        Set Player Variable(Event Player, isAirWalkEnabled, False);
        Small Message(Event Player, Custom String("  {0}  开发者模式： 已关闭浮空", Icon String(Bolt)));
    }
}

rule ("[DevTool] Hold air position") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        (Event Player).isDev == True;
        (Event Player).isAirWalkEnabled == True;
        Throttle Of(Event Player) == Vector(False, False, False);
        Is Button Held(Event Player, Button(Jump)) == False;
        Is Button Held(Event Player, Button(Crouch)) == False;
    }
    actions {
        Apply Impulse(Event Player, Up, 0.001, To World, Cancel Contrary Motion);
        Apply Impulse(Event Player, Multiply(Velocity Of(Event Player), -1), 0.001, To World, Cancel Contrary Motion);
    }
}

rule ("[DevTool] Toggle noclip") {
