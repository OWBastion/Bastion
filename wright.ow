rule ("[VishkarEvent]: 治疗光塔 ProMax (全图奶)") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, Null), Compare((Event Player).eventId, ==, 20)), Current Array Element) == True;
    }
    actions {
        If(Compare(Normalized Health(Event Player), ==, 1));
            Skip(2);
            Small Message(Remove From Array(All Players(Team 1), Event Player), Custom String("  {0}  受到来自 {1}（{2}） 治疗光塔 ProMax 的治疗效果", Ability Icon String(Hero(Illari), Button(Ability 2)), Event Player, Hero Of(Event Player)));
        End;
        Start Heal Over Time(All Players(Team 1), Event Player, 2, Round To Integer(Add(50, Divide(Multiply(Max Health(Event Player), 75), 100)), Nearest));
        Wait(2, Abort When False);
        Loop If Condition Is True;
    }
}

rule ("[VishkarEvent]: 魔术大师") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, Null), Compare((Event Player).eventId, ==, 21), Is Communicating Any Emote(Event Player)), Current Array Element) == True;
    }
    actions {
        Set Player Variable(Event Player, targetSilence, True);
        Modify Player Variable(Event Player, mod_speed_event, Add, 60);
        Call Subroutine(updatePlayerStats);
        If(Compare((Event Player).eventEffect, ==, Null));
            Create Effect(If-Then-Else(Is Communicating Any Emote(Event Player), All Players(All Teams), Null), Reaper Wraith Form Effect, Color(Team 1), Event Player, 200, Visible To Position and Radius);
            Set Player Variable(Event Player, eventEffect, Last Created Entity);
        End;
        Wait Until(Not(Is Communicating Any Emote(Event Player)), (Event Player).eventDuration);
        Set Player Variable(Event Player, targetSilence, False);
        Set Player Variable(Event Player, mod_speed_event, Null);
        Call Subroutine(updatePlayerStats);
        Wait(0.25, Ignore Condition);
    }
}

rule ("[VishkarEvent]: 天降神兵") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, Null), Compare((Event Player).eventId, ==, 22), Compare((Event Player).altFormActive, !=, True), Compare(Total Time Elapsed, >=, (Event Player).eventMissionGoal), Is Button Held(Event Player, Button(Reload))), Current Array Element) == True;
    }
    actions {
        Wait(True, Abort When False);
        Set Player Variable(Event Player, altFormActive, True);
        Set Player Variable(Event Player, target, Remove From Array(All Living Players(Team 1), Event Player));
        If(Compare(Count Of((Event Player).target), >, Null));
            Set Player Variable(Event Player, target, First Of(Sorted Array((Event Player).target, Multiply(100, Divide(Health(Current Array Element), Max Health(Current Array Element))))));
            Play Effect(All Players(All Teams), Tracer Recall Disappear Effect, Color(Team 1), Event Player, 200);
            Teleport(Event Player, Nearest Walkable Position(Subtract(Position Of((Event Player).target), Backward)));
            Play Effect(All Players(All Teams), Tracer Recall Reappear Effect, Color(Team 1), Event Player, 200);
            Set Player Health((Event Player).target, Min(Max Health((Event Player).target), Add(Add(Health((Event Player).target), 50), Divide(Multiply(Max Health(Event Player), 60), 100))));
            Set Player Variable(Event Player, eventMissionGoal, Add(Total Time Elapsed, 5));
            Wait(5, Ignore Condition);
            Small Message(Event Player, Custom String("  {0}  天降神兵已就绪", Icon String(Club)));
        End;
        Set Player Variable(Event Player, altFormActive, False);
    }
}

