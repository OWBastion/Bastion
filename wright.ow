rule ("Load CN map title holders") {
    event {
        Ongoing - Global;
    }
    actions {
        Wait(0.032, Ignore Condition);
        Set Global Variable(__currentMapPioneerText___, Global.__currentMapText___);
        Set Global Variable(__currentPioneerText___, Null);
        If(Or(Compare(Global.__currentMap___, ==, Map(Aatlis)), Compare(Global.__currentMap___, ==, 1826)));
            Set Global Variable(__currentMapPioneerText___, Custom String("织金"));
            Set Global Variable(__currentPioneerText___, Custom String("门徒"));
        Else If(Compare(Global.__currentMap___, ==, Map(Watchpoint: Gibraltar)));
            Set Global Variable(__currentMapPioneerText___, If-Then-Else(Compare(Random Integer(False, 99), <, 50), Custom String("守望先锋"), Custom String("黑爪特工")));
            Set Global Variable(__currentPioneerText___, Char In String(Empty Array, False));
        Else If(Compare(Global.__currentMap___, ==, Map(Paraíso)));
            Set Global Variable(__currentMapPioneerText___, Char In String(Empty Array, False));
            Set Global Variable(__currentPioneerText___, Custom String("黄金节拍"));
        Else If(Or(Compare(Global.__currentMap___, ==, Map(Ayutthaya)), Compare(Global.__currentMap___, ==, 1826)));
            Set Global Variable(__currentMapPioneerText___, Custom String("大城"));
            Set Global Variable(__currentPioneerText___, Custom String("守护者"));
        Else If(Or(Compare(Global.__currentMap___, ==, Map(Neon Junction)), Compare(Global.__currentMap___, ==, -6860)));
            Set Global Variable(__currentMapPioneerText___, Custom String("桥元御守"));
            Set Global Variable(__currentPioneerText___, Char In String(Empty Array, False));
        Else If(Or(Compare(Current Map, ==, Map(Antarctic Peninsula)), Compare(Global.__currentMap___, ==, 6177)));
            Set Global Variable(__currentMapPioneerText___, Custom String("科研先锋"));
            Set Global Variable(__currentPioneerText___, Char In String(Empty Array, False));
        Else If(Compare(Global.__currentMap___, ==, Map(Suravasa)));
            Set Global Variable(__currentMapPioneerText___, Custom String("瓦拉纳西"));
            Set Global Variable(__currentPioneerText___, Custom String("守护者"));
        End;
        If(Or(Compare(Global.__currentMap___, ==, Map(Aatlis)), Compare(Global.__currentMap___, ==, 1826)));
            Set Global Variable(mapTitlePlayersByKey, Array(String Split(Custom String("7-4-17"), Custom String("-")), String Split(Custom String("9-8-15-7-3-16-5-6-14-10-11-13-1"), Custom String("-")), String Split(Custom String("9-8-15-7-3-16-5-6-14-10-11-13-1"), Custom String("-")), Empty Array));
        End;
        If(Or(Compare(Current Map, ==, Map(Antarctic Peninsula)), Compare(Global.__currentMap___, ==, 6177)));
            Set Global Variable(mapTitlePlayersByKey, Array(String Split(Custom String("8-7"), Custom String("-")), String Split(Custom String("9-8-7-3-16-5-6-10-13-1"), Custom String("-")), String Split(Custom String("9-8-7-3-16-5-6-10-13-1"), Custom String("-")), Empty Array));
        End;
        If(Or(Compare(Global.__currentMap___, ==, Map(Ayutthaya)), Compare(Global.__currentMap___, ==, 1826)));
            Set Global Variable(mapTitlePlayersByKey, Array(String Split(Custom String("4-17"), Custom String("-")), String Split(Custom String("9-8-7-3-16-5-14-11-13-12-1"), Custom String("-")), String Split(Custom String("9-8-7-3-16-5-14-11-13-12-1"), Custom String("-")), Empty Array));
        End;
        If(Or(Compare(Global.__currentMap___, ==, Map(Blizzard World)), Compare(Global.__currentMap___, ==, 1228)));
            Set Global Variable(mapTitlePlayersByKey, Array(String Split(Empty Array, Custom String("-")), String Split(Custom String("9-8-15-7-3-4-16-5-6-14-13-1"), Custom String("-")), String Split(Custom String("9-8-15-7-3-4-16-5-6-14-13-1"), Custom String("-")), Empty Array));
        End;
        If(Compare(Global.__currentMap___, ==, Map(Busan)));
            Set Global Variable(mapTitlePlayersByKey, Array(String Split(Custom String("9-2"), Custom String("-")), String Split(Empty Array, Custom String("-")), String Split(Empty Array, Custom String("-")), Empty Array));
        End;
        If(Compare(Global.__currentMap___, ==, Map(Circuit Royal)));
            If(Compare(Global.classicMapVariant, ==, 1));
                Set Global Variable(mapTitlePlayersByKey, Array(Empty Array, Empty Array, Empty Array, String Split(Custom String("9-8-7-3-5-13"), Custom String("-"))));
            Else;
                Set Global Variable(mapTitlePlayersByKey, Array(String Split(Custom String("4-17"), Custom String("-")), String Split(Custom String("9-8-7-3-16-5-14-13-12-1"), Custom String("-")), String Split(Custom String("9-8-7-3-16-5-14-13-12-1"), Custom String("-")), String Split(Custom String("9-8-7-3-5-13"), Custom String("-"))));
            End;
