}

rule ("[Bastion] Reset displaced bot") {
    event {
        Ongoing - Each Player;
        Team 2;
        Bastion;
    }
    conditions {
        Distance Between(Position Of(Event Player), Value In Array(Global.bastionPosition, Slot Of(Event Player))) > 2;
    }
    actions {
        Wait(0.5, Abort When False);
        Set Player Variable(Event Player, isInPosition, False);
        Enable Movement Collision With Environment(Event Player);
        Set Status(Event Player, Null, Phased Out, 7);
        Teleport(Event Player, Value In Array(Global.bastionPosition, Slot Of(Event Player)));
        Wait(False, Ignore Condition);
        Start Forcing Player Position(Event Player, Value In Array(Global.bastionPosition, Slot Of(Event Player)), False);
        Wait(False, Ignore Condition);
        Wait Until(Compare(Speed Of(Event Player), <, 1), 2);
        Stop Forcing Player Position(Event Player);
        Loop If Condition Is True;
    }
}

rule ("[Bastion] Lock landing position") {
    event {
        Ongoing - Each Player;
        Team 2;
        Bastion;
    }
    conditions {
        Total Time Elapsed > 10;
        (Event Player).isInPosition == False;
        Is Moving(Event Player) == False;
    }
    actions {
        Wait(5, Abort When False);
        Wait Until(Is Using Ability 1(Event Player), 2);
        Wait(0.5, Abort When False);
        Start Forcing Player Position(Event Player, Position Of(Event Player), False);
        Disable Movement Collision With Environment(Event Player, True);
        Set Player Variable(Event Player, isInPosition, True);
    }
}

rule ("[Bastion] Lock elevated position") {
