rule ("[DevTool] Toggle third person") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Is Button Held(Event Player, Button(Jump)) == True;
        (Event Player).menu == 1;
    }
    actions {
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Call Subroutine(setThirdPerson);
    }
}

disabled rule ("[DevTool] Increase difficulty") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Global.difficulty < 5;
        (Event Player).menu == 1;
        (Event Player).isDev == True;
        Is Button Held(Event Player, Button(Ability 1)) == True;
    }
    actions {
        Modify Global Variable(difficulty, Add, True);
        Call Subroutine(setDifficulty);
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Small Message(Filtered Array(All Players(Team 1), (Current Array Element).isDev), Custom String("  {0}  开发者模式： 已将难度设置为 {1}({2})", Icon String(Bolt), First Of(Global.difficultyText), Global.difficulty));
    }
}

disabled rule ("[DevTool] Decrease difficulty") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Global.difficulty > Null;
        (Event Player).menu == 1;
        (Event Player).isDev == True;
        Is Button Held(Event Player, Button(Reload)) == True;
    }
    actions {
        Modify Global Variable(difficulty, Subtract, True);
        Call Subroutine(setDifficulty);
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Small Message(Filtered Array(All Players(Team 1), (Current Array Element).isDev), Custom String("  {0}  开发者模式： 已将难度设置为 {1}({2})", Icon String(Bolt), First Of(Global.difficultyText), Global.difficulty));
    }
}

rule ("[DevTool] Extend reboot timer") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        (Event Player).menu == 1;
        Or((Event Player).isDev, Compare(Host Player, ==, Event Player)) == True;
        Is Button Held(Event Player, Button(Primary Fire)) == True;
    }
    actions {
        If(And(Compare(Add(Global.rebootTime, 300), <=, 15900), Compare(Global.__currentMap___, !=, Map(Ayutthaya))));
            Modify Global Variable(rebootTime, Add, 300);
            If((Event Player).isDev);
                Small Message(Filtered Array(All Players(Team 1), (Current Array Element).isDev), Custom String("  {0}  开发者模式： 已将自动重开时间延长 5 分钟", Icon String(Bolt)));
            Else;
                Small Message(All Players(All Teams), Custom String("  {0}  模式调整： 房主已将自动重开时间延长 5 分钟", Icon String(Bolt)));
            End;
        Else;
            Small Message(Event Player, Custom String("  {0}  已达到最大上限", Icon String(Warning)));
    }
}

rule ("[DevTool] Reduce reboot timer") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        (Event Player).menu == 1;
        Or((Event Player).isDev, Compare(Host Player, ==, Event Player)) == True;
        Is Button Held(Event Player, Button(Secondary Fire)) == True;
    }
    actions {
        If(And(Compare(Subtract(Global.rebootTime, 300), >=, 300), Compare(Global.__currentMap___, !=, Map(Ayutthaya))));
            Modify Global Variable(rebootTime, Subtract, 300);
            If((Event Player).isDev);
                Small Message(Filtered Array(All Players(Team 1), (Current Array Element).isDev), Custom String("  {0}  开发者模式： 已将自动重开时间缩短 5 分钟", Icon String(Bolt)));
            Else;
                Small Message(All Players(All Teams), Custom String("  {0}  模式调整： 房主已将自动重开时间缩短 5 分钟", Icon String(Bolt)));
            End;
    }
}

rule ("[DevTool] Restart match") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        (Event Player).menu == 2;
        (Event Player).isDev == True;
        Is Button Held(Event Player, Button(Reload)) == True;
    }
    actions {
        Small Message(Filtered Array(All Players(Team 1), (Current Array Element).isDev), Custom String("  {0}  开发者模式： 长按 {1} 进行重启", Icon String(Bolt), Input Binding String(Button(Reload))));
        Wait(2, Abort When False);
        Small Message(Filtered Array(All Players(Team 1), (Current Array Element).isDev), Custom String("  {0}  开发者模式： 正在重启...", Icon String(Bolt)));
        Wait(2, Abort When False);
        Restart Match;
    }
}

rule ("[DevTool] Select host target") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Event Player == Host Player;
        (Event Player).menu == 1;
        Is Button Held(Event Player, Button(Ability 1)) == True;
    }
    actions {
        If(Or(Compare(Global.targetPlayerIndex, ==, Null), Compare(Global.targetPlayerIndex, >=, Count Of(Sorted Array(All Players(Team 1), Current Array Element)))));
            Set Global Variable(targetPlayerIndex, Null);
            Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        End;
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Set Global Variable(targetPlayer, Value In Array(Sorted Array(All Players(Team 1), (Current Array Element).joinTime), Global.targetPlayerIndex));
        Modify Global Variable(targetPlayerIndex, Add, True);
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Small Message(Append To Array(Filtered Array(All Players(Team 1), (Current Array Element).isDev), Host Player), If-Then-Else(Compare(Global.targetPlayer, ==, Null), Custom String("  {0}  没有可标记的玩家", Icon String(Bolt)), Custom String("  {0}  房主操作： 已标记 {1}（{2}）", Icon String(Bolt), Global.targetPlayer, Hero Of(Global.targetPlayer))));
    }
}

rule ("[DevTool] Kick host target") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Event Player == Host Player;
        (Event Player).menu == 1;
        Is Button Held(Event Player, Button(Reload)) == True;
    }
    actions {
        Abort If(Or(Compare(Global.targetPlayer, ==, Null), (Global.targetPlayer).isDev));
        Small Message(Append To Array(Filtered Array(All Players(Team 1), (Current Array Element).isDev), Host Player), Custom String("  {0}  房主操作： 长按 {1} 移除 {2}", Icon String(Bolt), Input Binding String(Button(Reload)), Global.targetPlayer));
        Wait(2, Abort When False);
        Small Message(Append To Array(Filtered Array(All Players(Team 1), (Current Array Element).isDev), Host Player), Custom String("  {0}  房主操作： 即将移除玩家 {1}", Icon String(Bolt), Global.targetPlayer));
        Wait(True, Abort When False);
        Small Message(Append To Array(Filtered Array(All Players(Team 1), (Current Array Element).isDev), Host Player), Custom String("  {0}  房主操作： 已移除玩家 {1}", Icon String(Bolt), Global.targetPlayer));
        Skip If(Array Contains(Global.blackList, Custom String("{0}", Global.targetPlayer)), True);
        Modify Global Variable(blackList, Append To Array, Custom String("{0}", Global.targetPlayer));
        Remove Player(Global.targetPlayer);
        Small Message(All Players(All Teams), Custom String("  {0}  {1} 已被拉入临时黑名单", Icon String(Bolt), Global.targetPlayer));
        Set Global Variable(targetPlayerIndex, Null);
        Set Global Variable(targetPlayer, Null);
    }
}

rule ("[DevTool] Select dev target") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        (Event Player).isDev == True;
        (Event Player).menu == 2;
        Is Button Held(Event Player, Button(Jump)) == True;
    }
    actions {
        If(Or(Compare(Global.targetPlayerIndex, ==, Null), Compare(Global.targetPlayerIndex, >=, Count Of(Sorted Array(All Players(Team 1), Current Array Element)))));
            Set Global Variable(targetPlayerIndex, Null);
            Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        End;
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Set Global Variable(targetPlayer, Value In Array(Sorted Array(All Players(Team 1), (Current Array Element).joinTime), Global.targetPlayerIndex));
        Modify Global Variable(targetPlayerIndex, Add, True);
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Small Message(Filtered Array(All Players(Team 1), (Current Array Element).isDev), If-Then-Else(Compare(Global.targetPlayer, ==, Null), Custom String("  {0}  没有可标记的玩家", Icon String(Bolt)), Custom String("  {0}  开发者模式： 已标记 {1}（{2}）", Icon String(Bolt), Global.targetPlayer, Hero Of(Global.targetPlayer))));
    }
}

