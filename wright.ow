rule ("[Bastion] Pulse secondary fire") {
    event {
        Ongoing - Each Player;
        Team 2;
        Bastion;
    }
    conditions {
        Is True For Any(Array(Compare(Global.difficulty, ==, 5), Global.bastionBotSeconFire), Current Array Element) == True;
        (Event Player).hasNano == False;
        Is Dummy Bot(Event Player) == True;
        Is Alive(Event Player) == True;
        Is Firing Primary(Event Player) == True;
        Ability Cooldown(Event Player, Button(Secondary Fire)) == Null;
        (Event Player).target != False;
    }
    actions {
        Wait(Random Real(0.032, 0.16), Abort When False);
        Press Button(Event Player, Button(Secondary Fire));
        Wait(1.488, Ignore Condition);
