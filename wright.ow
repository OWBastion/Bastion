rule ("[VishkarEvent]: build player event candidate pool") {
    event {
        Subroutine;
        buildCandidatePool;
    }
    actions {
        Set Player Variable(Event Player, eventTempIndex, Filtered Array(Global.eventCatalogId, Compare(Value In Array(Global.eventCatalogWeight, Current Array Element), >, Null)));
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        If(Compare((Event Player).thiefBuffStolen, ==, True));
            Set Player Variable(Event Player, eventTempIndex, Filtered Array((Event Player).eventTempIndex, Compare(Value In Array(Global.eventCatalogType, Current Array Element), !=, Null)));
        Else If(Compare((Event Player).eventForceRoll, !=, Null));
            If(Compare((Event Player).eventForceRoll, <, 42.5));
                Set Player Variable(Event Player, eventTempIndex, Filtered Array((Event Player).eventTempIndex, Compare(Value In Array(Global.eventCatalogType, Current Array Element), ==, Null)));
            Else If(Compare((Event Player).eventForceRoll, <, 80));
                Set Player Variable(Event Player, eventTempIndex, Filtered Array((Event Player).eventTempIndex, Compare(Value In Array(Global.eventCatalogType, Current Array Element), ==, 1)));
            Else;
                Set Player Variable(Event Player, eventTempIndex, Filtered Array((Event Player).eventTempIndex, Compare(Value In Array(Global.eventCatalogType, Current Array Element), ==, 2)));
            End;
        End;
        If(Not(Is True For Any(Array(Array Contains(First Of(Global.phaseHero), Hero Of(Event Player)), Array Contains(Value In Array(Global.phaseHero, True), Hero Of(Event Player)), Array Contains(Value In Array(Global.phaseHero, 2), Hero Of(Event Player)), Array Contains(Value In Array(Global.phaseHero, 3), Hero Of(Event Player)), Compare(Hero Of(Event Player), ==, Hero(Brigitte)), Array Contains(Value In Array(Global.phaseHero, 4), Hero Of(Event Player))), Current Array Element)));
            Set Player Variable(Event Player, eventTempIndex, Filtered Array((Event Player).eventTempIndex, Not(Array Contains(Array(16, 17), Current Array Element))));
        End;
        If(Compare(First Of((Event Player).heart_steel), <=, Null));
            Set Player Variable(Event Player, eventTempIndex, Filtered Array((Event Player).eventTempIndex, Not(Array Contains(Array(50, 59, 60), Current Array Element))));
        End;
        If(And(And(Compare((Event Player).playerOnceEventState, !=, Null), Compare(Count Of((Event Player).playerOnceEventState), >, Null)), Compare(First Of((Event Player).playerOnceEventState), ==, 2)));
            Modify Player Variable(Event Player, eventTempIndex, Remove From Array By Value, 23);
        End;
        If(Compare((Event Player).eventForceRoll, ==, 50));
            Modify Player Variable(Event Player, eventTempIndex, Remove From Array By Value, 38);
        End;
        If(Or(Compare(Global.gamblerHeartsteelJackpot, <, 8), Compare(First Of((Event Player).heart_steel), <, 4)));
            Modify Player Variable(Event Player, eventTempIndex, Remove From Array By Value, 66);
        End;
        If(And(And(And(Compare((Event Player).mod_dmg_perma, >=, Null), Compare((Event Player).mod_speed_perma, >=, Null)), Compare((Event Player).mod_heal_perma, >=, Null)), Compare(First Of((Event Player).heart_steel), >=, Null)));
            Modify Player Variable(Event Player, eventTempIndex, Remove From Array By Value, 65);
        End;
        If(Compare((Event Player).eventLastId, !=, Null));
            Set Player Variable(Event Player, eventCandidateIndex, Filtered Array((Event Player).eventTempIndex, Not(Array Contains((Event Player).eventLastId, Current Array Element))));
            If(Compare(Count Of((Event Player).eventCandidateIndex), >, Null));
                Set Player Variable(Event Player, eventTempIndex, (Event Player).eventCandidateIndex);
            End;
        End;
        Set Player Variable(Event Player, eventTempIndex, Filtered Array((Event Player).eventTempIndex, Compare(Index Of Array Value((Event Player).eventTempIndex, Current Array Element), ==, Current Array Index)));
    }
}

rule ("[VishkarEvent]: set player event") {
    event {
        Subroutine;
        rejecSampling;
    }
    actions {
        Set Player Variable(Event Player, eventLoopCount, Null);
        Set Player Variable(Event Player, eventIsSelected, False);
        While(And(Compare((Event Player).eventIsSelected, ==, False), Compare((Event Player).eventLoopCount, <, 8)));
            If(Compare((Event Player).eventLoopCount, >, Null));
                Wait(False, Ignore Condition);
            End;
            Set Player Variable(Event Player, eventCandidateIndex, Random Value In Array((Event Player).eventTempIndex));
            If(Compare(Random Real(0, Global.eventWeight), <, Value In Array(Global.eventCatalogWeight, (Event Player).eventCandidateIndex)));
                Set Player Variable(Event Player, eventIsSelected, True);
                Break;
            End;
            Modify Player Variable(Event Player, eventLoopCount, Add, True);
        End;
        If(Compare((Event Player).eventIsSelected, ==, False));
            Set Player Variable(Event Player, eventIsSelected, True);
    }
}

rule ("[System] Clean expired health pools") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Count Of((Event Player).hp_data) > Null;
    }
    actions {
        Modify Player Variable(Event Player, hp_data, Remove From Array By Value, Null);
        If(Compare(Count Of((Event Player).hp_data), >, 1));
            Set Player Variable(Event Player, hp_data, Sorted Array((Event Player).hp_data, If-Then-Else(And(Compare(Count Of(Current Array Element), >, 2), Compare((Event Player).eventId, !=, Value In Array(Current Array Element, 2))), -1, First Of(Current Array Element))));
        End;
        For Global Variable(I, 0, 6, True);
            Skip If(Or(Compare(Count Of((Event Player).hp_data), ==, Null), And(Compare(First Of(First Of((Event Player).hp_data)), >, Total Time Elapsed), Or(Compare(Count Of(First Of((Event Player).hp_data)), <=, 2), Compare((Event Player).eventId, ==, Value In Array(First Of((Event Player).hp_data), 2))))), 4);
            Remove Health Pool From Player(Value In Array(First Of((Event Player).hp_data), True));
            Modify Player Variable(Event Player, hp_data, Remove From Array By Index, False);
            Wait(0.8, Ignore Condition);
        End;
        Wait(True, Ignore Condition);
        Loop If Condition Is True;
    }
}

rule ("[System] Enable phase tri­gger") {
