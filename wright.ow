rule ("[VishkarEvent]: 献祭") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 1), Compare((Event Player).eventId, ==, 2)), Current Array Element) == True;
    }
    actions {
        Set Player Variable(Event Player, target, Filtered Array(All Living Players(Team 1), Or(Is Using Ability 1(Current Array Element), Is Using Ability 2(Current Array Element))));
        If(Compare(Count Of((Event Player).target), >, Null));
            Set Player Variable(Event Player, passiveRegenBlocked, True);
            Play Effect(All Players(All Teams), Moira Fade Reappear Effect, Color(Team 2), Event Player, 200);
            If(Compare(Count Of((Event Player).target), >, 1));
                Set Player Variable(Event Player, target, First Of(Sorted Array((Event Player).target, Distance Between(Event Player, Current Array Element))));
            Else If(Compare(First Of((Event Player).target), !=, Null));
                Set Player Variable(Event Player, target, First Of((Event Player).target));
            Else;
                Set Player Variable(Event Player, target, Null);
            End;
            If(Compare((Event Player).target, !=, Null));
                Damage(Event Player, (Event Player).target, Divide(Multiply(Max Health(Event Player), 10), 100));
            End;
        End;
        Wait(0.5, Ignore Condition);
        Loop If Condition Is True;
        Set Player Variable(Event Player, target, Null);
        Call Subroutine(startCombatRegen);
    }
}

