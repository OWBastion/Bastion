        Is True For Any(Array(And(Array Contains(First Of(Global.phaseHero), Hero Of(Event Player)), Is Using Ability 1(Event Player)), And(Array Contains(Value In Array(Global.phaseHero, True), Hero Of(Event Player)), Is Using Ability 2(Event Player)), And(Array Contains(Value In Array(Global.phaseHero, 2), Hero Of(Event Player)), Is Firing Secondary(Event Player)), And(Array Contains(Value In Array(Global.phaseHero, 3), Hero Of(Event Player)), Is Button Held(Event Player, Button(Jump))), And(And(Compare(Hero Of(Event Player), ==, Hero(Brigitte)), Is Firing Secondary(Event Player)), Is Button Held(Event Player, Button(Primary Fire))), And(Array Contains(Value In Array(Global.phaseHero, 4), Hero Of(Event Player)), (Event Player).zenSnapKick)), Current Array Element) == True;
    }
    actions {
        Set Player Variable(Event Player, phaseState, True);
