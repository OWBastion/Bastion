        If(And(Compare(Global.controlJumpPosition, !=, Null), Compare(Global.portalPosition, ==, Null)));
            Create HUD Text(All Players(All Teams), Null, Null, If-Then-Else(Compare(Global.difficulty, !=, 5), Custom String("欢迎来到三合一大地图！你需要挑战所有小地图并到达终点！阵亡 {0} 次之后可跳过英雄", Global.maxDeath), Custom String("欢迎来到三合一大地图！你需要挑战所有小地图并到达终点！当前难度无法跳过英雄，加油吧！")), Top, False, Null, Null, Custom Color(255, 255, 255, 125), Visible To and String, Default Visibility);
        Else;
            Create HUD Text(All Players(All Teams), Null, Null, If-Then-Else(Compare(Global.difficulty, !=, 5), Custom String("使用全部英雄通关，一旦你解锁了一个英雄就可以在后续的游戏中随时使用！当阵亡 {0} 次之后可跳过英雄", Global.maxDeath), Custom String("使用全部英雄通关！当前难度无法跳过英雄，加油吧！")), Top, False, Null, Null, Custom Color(255, 255, 255, 125), Visible To and String, Default Visibility);
        End;
        Create HUD Text(All Players(All Teams), Null, Custom String("国服代码【SVMQK】| 亚服【1ACCZ】 | 500强交流群：445152554 | 加群给你喜欢的事件点赞 \n"), Null, Top, True, Null, Custom Color(255, 255, 255, 125), Null, Visible To and String, Default Visibility);
        Create HUD Text(All Players(All Teams), Null, Null, Custom String("{0}：{1}", If-Then-Else(Compare(Global.__currentMapText___, ==, Null), First Of(Filtered Array(Array(Map(Colosseo), Map(Esperança), Map(Samoa), Map(Throne of Anubis), Current Map), Compare(Custom String("{0}", Current Map), ==, String Split(Current Array Element, Empty Array)))), Global.__currentMapText___), First Of(Global.difficultyText)), Right, -6, Null, Null, Value In Array(Global.difficultyText, True), Visible To String and Color, Default Visibility);
        Create HUD Text(All Players(All Teams), Null, Custom String("距自动重开 {0}{1}{2}", If-Then-Else(Compare(Subtract(Global.rebootTime, Total Time Elapsed), >, 3599), Custom String("{0} 小时", Round To Integer(Divide(Subtract(Global.rebootTime, Total Time Elapsed), 3600), Down)), Char In String(Empty Array, False)), If-Then-Else(Compare(Subtract(Global.rebootTime, Total Time Elapsed), >, 59), Custom String("{0} 分", Round To Integer(Divide(Modulo(Subtract(Global.rebootTime, Total Time Elapsed), 3600), 60), Down)), Char In String(Empty Array, False)), Custom String("{0} 秒\n已运行 {1}{2}", Round To Integer(Modulo(Subtract(Global.rebootTime, Total Time Elapsed), 60), Down), If-Then-Else(Compare(Total Time Elapsed, >=, 3600), Custom String("{0} 小时", Round To Integer(Divide(Total Time Elapsed, 3600), Down)), Char In String(Empty Array, False)), Custom String("{0}{1} 秒", If-Then-Else(Compare(Total Time Elapsed, >=, 60), Custom String("{0} 分", Round To Integer(Divide(Modulo(Total Time Elapsed, 3600), 60), Down)), Char In String(Empty Array, False)), Round To Integer(Modulo(Total Time Elapsed, 60), Down)))), Null, Right, -4, Null, If-Then-Else(Compare(Subtract(Global.rebootTime, Total Time Elapsed), <=, 600), Color(Yellow), Color(Gray)), Null, Visible To String and Color, Default Visibility);
        Create HUD Text(All Players(All Teams), Null, Custom String("  服务器负载 {0}", Server Load Average), Null, Right, -2, Null, Color(Gray), Null, Visible To and String, Visible Never);
        Create HUD Text(All Players(All Teams), Null, Custom String("版本 26.0926.1{0}", If-Then-Else((Local Player).isWinner, Custom String("\n{0}", Global.masteryRunCode), Char In String(Empty Array, False))), Null, Right, -3, Null, Color(Gray), Null, Visible To and String, Visible Never);
        Create Effect(All Players(All Teams), Bad Aura, Color(Aqua), Global.creditsPosition, Random Real(1, 2), Visible To);
        Create Effect(All Players(All Teams), Bad Aura, Color(Sky Blue), Global.creditsPosition, Random Real(1, 2), Visible To);
        Create Effect(All Players(All Teams), Bad Aura, Color(White), Global.creditsPosition, Random Real(1, 2), Visible To);
        Wait(0.5, Ignore Condition);
        Create Effect(Local Player, Ring, Color(Purple), Global.thirdPersonPosition, 1.2, Visible To);
        Create In-World Text(Local Player, Custom String("      按{0}切换第三人称视角\n                    {1}", Input Binding String(Button(Jump)), Icon String(Arrow: Down)), Add(Global.thirdPersonPosition, Multiply(1.3, Up)), 1.2, Clip Against Surfaces, Visible To Position and String, Color(White), Default Visibility);
        Wait(0.5, Ignore Condition);
        Create Effect(If-Then-Else(Or(Compare((Local Player).heroNumber, >, Null), Compare((Local Player).runDeathCount, >, Null)), Local Player, Null), Ring, Color(Red), Global.resetPosition, 1.2, Visible To);
        Create In-World Text(If-Then-Else(Or(Compare((Local Player).heroNumber, >, Null), Compare((Local Player).runDeathCount, >, Null)), Local Player, Null), Custom String("重置进度\n                {0}", Icon String(Arrow: Down)), Add(Global.resetPosition, Multiply(1.3, Up)), 1.2, Clip Against Surfaces, Visible To Position and String, Color(White), Default Visibility);
        If(Compare(Global.springBoardPosition, !=, Null));
            Create Effect(Local Player, Ring, Color(Green), Global.springBoardPosition, 1.2, Visible To);
            Create In-World Text(Local Player, Custom String("      按{0}向上弹射\n                    {1}", Input Binding String(Button(Jump)), Icon String(Arrow: Down)), Add(Global.springBoardPosition, Multiply(1.3, Up)), 1.2, Clip Against Surfaces, Visible To Position and String, Color(White), Default Visibility);
    }
}

rule ("3rd person") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Is Alive(Event Player) == True;
        Is Button Held(Event Player, Button(Jump)) == True;
        Distance Between(Multiply(Event Player, Add(Left, Forward)), Multiply(Global.thirdPersonPosition, Add(Left, Forward))) <= 1.2;
    }
    actions {
        Wait(0.032, Ignore Condition);
        Call Subroutine(setThirdPerson);
    }
}

rule ("springboard") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Global.springBoardPosition != Null;
        Is Alive(Event Player) == True;
        Is Button Held(Event Player, Button(Jump)) == True;
        Y Component Of(Position Of(Event Player)) >= Y Component Of(Global.springBoardPosition);
        Distance Between(Multiply(Event Player, Add(Left, Forward)), Multiply(Global.springBoardPosition, Add(Left, Forward))) <= 1.2;
    }
    actions {
        Wait(0.032, Abort When False);
        Play Effect(All Players(All Teams), Ring Explosion Sound, Color(White), Event Player, 200);
        Apply Impulse(Event Player, Up, 14, To Player, Cancel Contrary Motion XYZ);
        Wait(0.032, Ignore Condition);
        Apply Impulse(Event Player, World Vector Of(Forward, Event Player, Rotation), 3.5, To World, Cancel Contrary Motion XYZ);
        Wait(5, Ignore Condition);
    }
}

rule ("portalPosition") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Global.portalPosition != Null;
        Is Alive(Event Player) == True;
        Is Button Held(Event Player, Button(Jump)) == True;
        Y Component Of(Position Of(Event Player)) >= Y Component Of(First Of(Global.portalPosition));
        Distance Between(Multiply(Event Player, Add(Left, Forward)), Multiply(First Of(Global.portalPosition), Add(Left, Forward))) <= 1.2;
    }
    actions {
        Wait(0.032, Abort When False);
        Play Effect(All Players(All Teams), Ring Explosion Sound, Color(White), Event Player, 200);
        Teleport(Event Player, Nearest Walkable Position(Last Of(Global.portalPosition)));
        Wait(5, Ignore Condition);
    }
}

rule ("initialize player nano effects") {
    event {
        Ongoing - Each Player;
        Team 2;
        All;
    }
    conditions {
        (Event Player).hasNano == True;
    }
    actions {
        Skip If(Compare((Event Player).nanoEffect, !=, Null), 2);
        Create Effect(If-Then-Else((Event Player).hasNano, All Players(All Teams), Null), Ana Nano Boosted Effect, Color(Team 2), Event Player, 200, Visible To Position and Radius);
        Set Player Variable(Event Player, nanoEffect, Last Created Entity);
        Set Status(Event Player, Null, Burning, 60);
        Wait Until(Or(Compare(Global.berserkerTime, ==, Null), Not((Event Player).hasNano)), 60);
        Set Player Variable(Event Player, hasNano, False);
        Clear Status(Event Player, Burning);
    }
}

rule ("clear nano effect when bastion leaves") {
    event {
        Player Left Match;
        Team 2;
        All;
    }
    actions {
        Destroy Effect((Event Player).nanoEffect);
        Set Player Variable(Event Player, nanoEffect, Null);
        Set Player Variable(Event Player, hasNano, False);
    }
}

disabled rule ("[Effects] Toggle dev rainbow") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        (Event Player).isDev == True;
        Is Button Held(Event Player, Button(Ultimate)) == True;
        Is Button Held(Event Player, Button(Interact)) == True;
    }
    actions {
        Set Player Variable(Event Player, rainbowOff, If-Then-Else((Event Player).rainbowOff, False, True));
        Stop Forcing Player Outlines(Event Player, All Players(All Teams));
        Small Message(Event Player, Custom String("DEV 特效{0}", If-Then-Else((Event Player).rainbowOff, Custom String("关闭"), Custom String("开启"))));
    }
}

rule ("[Effects] Refresh winner outlines") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        (Event Player).isWinner != False;
        Is Alive(Event Player) == True;
    }
    actions {
        Wait(Divide(Server Load Average, 100), Ignore Condition);
        Start Forcing Player Outlines(Event Player, All Players(Team 1), True, Color(Green), Always);
        Wait(30, Restart When True);
        Loop If Condition Is True;
    }
}

rule ("[Effects] Outline winners for joiners") {
    event {
        Player Joined Match;
        Team 1;
        All;
    }
    conditions {
        Is True For Any(All Players(Team 1), (Current Array Element).isWinner) == True;
    }
    actions {
        Wait(Divide(Server Load Average, 100), Ignore Condition);
        Start Forcing Player Outlines(Filtered Array(All Players(Team 1), (Current Array Element).isWinner), Event Player, True, Color(Green), Always);
    }
}

rule ("[Effects] Clear non-winner outlines") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        (Event Player).isWinner == False;
    }
    actions {
        Wait(Divide(Server Load Average, 100), Ignore Condition);
        Stop Forcing Player Outlines(Event Player, All Players(Team 1));
    }
}

rule ("[Player] [VishkarEvent]: reset player event state") {
    event {
        Subroutine;
        resetPlayerEventState;
    }
    actions {
        Call Subroutine(clearPlayerEvent);
        Destroy Effect(Value In Array((Event Player).invincibleEffect, 2));
        Destroy Effect(Value In Array((Event Player).invincibleEffect, 3));
        Destroy Effect((Event Player).nanoEffect);
        Set Player Variable(Event Player, invincibleEffect, Array(Null, Null, Null, Null));
        Set Player Variable(Event Player, nanoEffect, Null);
        Set Player Variable(Event Player, hasNano, False);
        Set Player Variable(Event Player, eventLastId, Empty Array);
        Set Player Variable(Event Player, eventCount, Array(Null, Null, Null));
        Set Player Variable(Event Player, eventLucky, Null);
        Set Player Variable(Event Player, eventDurationHud, Null);
        Set Player Variable(Event Player, eventLoopCount, Null);
        Set Player Variable(Event Player, eventIsSelected, False);
        Set Player Variable(Event Player, eventCandidateIndex, Null);
        Set Player Variable(Event Player, eventTempIndex, Empty Array);
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
    }
}

rule ("[Player] [VishkarEvent]: reset player progress state") {
    event {
        Subroutine;
        resetPlayerProgressState;
    }
    actions {
        Set Player Variable(Event Player, heroNumber, Null);
        Set Player Variable(Event Player, progressionDeathCount, Null);
        Set Player Variable(Event Player, skipCount, Null);
        Set Player Variable(Event Player, runDeathCount, Null);
        Set Player Variable(Event Player, isWinner, False);
        Set Player Variable(Event Player, winnerTime, Null);
        Set Player Variable(Event Player, dmgReduc, False);
        Set Player Variable(Event Player, invincible, False);
        Set Player Variable(Event Player, isAirWalkEnabled, False);
        Set Player Variable(Event Player, isPortalEnabled, False);
        Set Player Variable(Event Player, controlJumpIndex, Null);
        Set Player Variable(Event Player, controlPlayerRespawnPosition, Null);
        Set Player Variable(Event Player, mod_speed_perma, Null);
        Set Player Variable(Event Player, mod_dmg_perma, Null);
        Set Player Variable(Event Player, mod_heal_perma, Null);
        Set Player Variable(Event Player, heart_steel, Array(Null, 1, 0.75));
        Set Player Variable(Event Player, possess, Null);
        Set Player Variable(Event Player, possessed, Empty Array);
        Set Player Variable(Event Player, dlcTimeChallenge, Array(Null, Null, Null, Null, Null, Null, Null, Null, Null));
        Set Player Variable(Event Player, eventForceRoll, Null);
        Set Player Variable(Event Player, eventForceCount, Null);
        Set Player Variable(Event Player, playerOnceEventState, Array(Null));
        Set Player Variable(Event Player, tempUnlockId, Null);
        Set Player Variable(Event Player, earnedAchievements, Empty Array);
        Set Player Variable(Event Player, thiefBuffStolen, False);
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Call Subroutine(setPlayerHP);
        Call Subroutine(updatePlayerStats);
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
    }
}

rule ("[Player] [VishkarEvent]: reset player saved state") {
    event {
        Subroutine;
        resetPlayerSavedState;
    }
    actions {
        Abort If(Not(Array Contains(Global.savedIndex, Custom String("{0}", Event Player))));
        Set Global Variable At Index(savedData, False, Append To Array(Append To Array(Array Slice(First Of(Global.savedData), False, Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))), Array(Null)), Array Slice(First Of(Global.savedData), Add(Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player)), True), 999999999999)));
        Set Global Variable At Index(savedData, True, Append To Array(Append To Array(Array Slice(Value In Array(Global.savedData, True), False, Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))), Array(Null)), Array Slice(Value In Array(Global.savedData, True), Add(Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player)), True), 999999999999)));
        Set Global Variable At Index(savedData, 2, Append To Array(Append To Array(Array Slice(Value In Array(Global.savedData, 2), False, Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))), Array(False)), Array Slice(Value In Array(Global.savedData, 2), Add(Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player)), True), 999999999999)));
        Set Global Variable At Index(savedData, 3, Append To Array(Append To Array(Array Slice(Value In Array(Global.savedData, 3), False, Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))), Array(Null)), Array Slice(Value In Array(Global.savedData, 3), Add(Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player)), True), 999999999999)));
        Set Global Variable At Index(savedData, 4, Append To Array(Append To Array(Array Slice(Value In Array(Global.savedData, 4), False, Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))), Array((Event Player).joinTime)), Array Slice(Value In Array(Global.savedData, 4), Add(Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player)), True), 999999999999)));
        Set Global Variable At Index(savedData, 5, Append To Array(Append To Array(Array Slice(Value In Array(Global.savedData, 5), False, Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))), Array(Null)), Array Slice(Value In Array(Global.savedData, 5), Add(Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player)), True), 999999999999)));
        Set Global Variable At Index(savedData, 6, Append To Array(Append To Array(Array Slice(Value In Array(Global.savedData, 6), False, Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))), Array(Array(Null))), Array Slice(Value In Array(Global.savedData, 6), Add(Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player)), True), 999999999999)));
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
    }
}

rule ("[Player] [VishkarEvent]: finish reset progress") {
    event {
        Subroutine;
        finishResetProgress;
    }
    actions {
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Start Forcing Player To Be Hero(Event Player, First Of(Global.heroList));
        Wait(False, Ignore Condition);
        Stop Forcing Player To Be Hero(Event Player);
        Wait(Multiply(Divide(Server Load, 100), 0.5), Ignore Condition);
        Set Player Allowed Heroes(Event Player, Array Slice(Global.heroList, False, True));
    }
}

rule ("[Player] Track progression death") {
    event {
        Player Died;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Compare(Hero Of(Event Player), ==, Value In Array(Global.heroList, (Event Player).heroNumber)), Compare((Event Player).progressionDeathCount, <, Global.maxDeath), Compare(Add((Event Player).heroNumber, True), <, Count Of(Global.heroList)), Compare(Attacker, !=, Null), Compare(Attacker, !=, Event Player)), Current Array Element) == True;
    }
    actions {
        Modify Player Variable(Event Player, progressionDeathCount, Add, True);
    }
}

rule ("[Player] Sync ult progress") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Global.difficulty != 5;
        And(Compare((Event Player).eventType, ==, Null), Compare((Event Player).eventId, ==, 15)) == False;
        (Event Player).progressionDeathCount < Global.maxDeath;
        (Event Player).isWinner == False;
        And(Compare(Hero Of(Event Player), ==, Hero(D.Va)), Is In Alternate Form(Event Player)) == False;
        Round To Integer(Divide(Ultimate Charge Percent(Event Player), Divide(100, Global.maxDeath)), Nearest) != (Event Player).progressionDeathCount;
    }
    actions {
        Wait(Random Real(0.1, 0.5), Abort When False);
        Set Ultimate Charge(Event Player, Divide(Multiply(100, (Event Player).progressionDeathCount), Global.maxDeath));
        Loop If Condition Is True;
    }
}

rule ("[Player] Display skip ready") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Global.difficulty != 5;
        And(Compare((Event Player).eventType, ==, Null), Compare((Event Player).eventId, ==, 15)) == False;
        (Event Player).progressionDeathCount == Global.maxDeath;
        Add((Event Player).heroNumber, True) < Count Of(Global.heroList);
        And(Compare(Hero Of(Event Player), ==, Hero(D.Va)), Is In Alternate Form(Event Player)) == False;
        Is Alive(Event Player) == True;
    }
    actions {
        Wait(Divide(Server Load Average, 100), Ignore Condition);
        If(Compare(Ultimate Charge Percent(Event Player), ==, 100));
            Set Ultimate Charge(Event Player, False);
            Wait(0.2, Ignore Condition);
        End;
        Big Message(Event Player, Custom String("可跳过当前英雄"));
        Set Player Variable(Event Player, I, Null);
        While(Compare(Ultimate Charge Percent(Event Player), !=, 100));
            Set Ultimate Charge(Event Player, 100);
            Wait(0.05, Ignore Condition);
            Modify Player Variable(Event Player, I, Add, True);
            Abort If(Compare(Global.I, ==, 5));
        End;
    }
}

rule ("[Player] Skip hero with ultimate") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Global.difficulty != 5;
        (Event Player).progressionDeathCount >= Global.maxDeath;
        Or(Is Using Ultimate(Event Player), Is Duplicating(Event Player)) == True;
        Add((Event Player).heroNumber, True) < Count Of(Global.heroList);
        Hero Of(Event Player) != Hero(Bastion);
    }
    actions {
        Wait(True, Ignore Condition);
        Respawn(Event Player);
        Set Player Variable(Event Player, progressionDeathCount, Null);
        Modify Player Variable(Event Player, skipCount, Add, True);
        Call Subroutine(progressHero);
    }
}

rule ("[Player] Display reset hint") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Or(Compare((Event Player).heroNumber, >, Null), Compare((Event Player).runDeathCount, >, Null)) == True;
        Array Contains(Players Within Radius(Global.resetPosition, 20, Team 1, Off), Event Player) == True;
        Distance Between(Multiply(Position Of(Event Player), Add(Left, Forward)), Multiply(Global.resetPosition, Add(Left, Forward))) <= 1.2;
    }
    actions {
        Big Message(Event Player, Custom String("长按装填键重置"));
    }
}

rule ("[Player] Reset progress") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is Button Held(Event Player, Button(Reload)) == True;
        Or(Compare((Event Player).runDeathCount, >, Null), Compare((Event Player).heroNumber, >, Null)) == True;
        Distance Between(Multiply(Event Player, Add(Left, Forward)), Multiply(Global.resetPosition, Add(Left, Forward))) <= 1.2;
    }
    actions {
        Preload Hero(Event Player, First Of(Global.heroList));
        Small Message(Event Player, Custom String("  正在重置进度..."));
        Wait(2, Abort When False);
        Play Effect(Event Player, Debuff Impact Sound, Null, Position Of(Event Player), 100);
        Call Subroutine(resetPlayerEventState);
        Call Subroutine(resetPlayerProgressState);
        Call Subroutine(resetPlayerSavedState);
        Small Message(All Players(All Teams), Custom String("  {0} 重置了进度", Event Player));
        Call Subroutine(finishResetProgress);
    }
}

rule ("when a player joins, load player data if they have it and initialize them") {
    event {
        Player Joined Match;
        Team 1;
        All;
    }
    actions {
        Set Player Variable(Event Player, invincibleEffect, Array(Null, Null, Null, Null));
        Set Player Variable(Event Player, isDev, Array Contains(Global.devList, Custom String("{0}", Event Player)));
        Set Player Variable(Event Player, eventId, -1);
        Set Player Variable(Event Player, eventLastId, Empty Array);
        Set Player Variable(Event Player, playerOnceEventState, Array(Null));
        Set Player Variable(Event Player, heart_steel, Array(Null, 1, 0.75));
        Set Player Variable(Event Player, sizeHealth, 1);
        Wait(Multiply(Divide(Server Load Average, 200), Random Real(1, 3)), Ignore Condition);
        If(Array Contains(Global.savedIndex, Custom String("{0}", Event Player)));
            Set Player Variable(Event Player, heroNumber, Value In Array(First Of(Global.savedData), Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))));
            Wait(Add(Multiply(Slot Of(Event Player), 0.032), Multiply(Random Real(1, 3), 0.05)), Ignore Condition);
            Set Player Variable(Event Player, runDeathCount, Value In Array(Value In Array(Global.savedData, True), Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))));
            Set Player Variable(Event Player, isWinner, Value In Array(Value In Array(Global.savedData, 2), Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))));
            Set Player Variable(Event Player, skipCount, Value In Array(Value In Array(Global.savedData, 3), Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))));
            Set Player Variable(Event Player, winnerTime, Value In Array(Value In Array(Global.savedData, 5), Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))));
            Wait(Multiply(Slot Of(Event Player), 0.032), Ignore Condition);
            If(Compare(Value In Array(Value In Array(Global.savedData, 6), Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))), !=, Null));
                Set Player Variable(Event Player, playerOnceEventState, Array Slice(Value In Array(Value In Array(Global.savedData, 6), Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))), False, True));
            End;
            If(Or(Compare((Event Player).joinTime, ==, Null), Compare((Event Player).joinTime, ==, Null)));
                Set Player Variable(Event Player, joinTime, Value In Array(Value In Array(Global.savedData, 4), Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))));
            End;
        Else;
            If(Or(Compare((Event Player).joinTime, ==, Null), Compare((Event Player).joinTime, ==, Null)));
                Set Player Variable(Event Player, joinTime, Evaluate Once(Total Time Elapsed));
            End;
        End;
        Set Player Variable(Event Player, dmgReduc, False);
        Set Player Variable(Event Player, invincible, False);
        If(And(And(Compare((Event Player).playerOnceEventState, !=, Null), Compare(Count Of((Event Player).playerOnceEventState), >, Null)), Compare(First Of((Event Player).playerOnceEventState), ==, 2)));
            Set Player Variable At Index(Event Player, heart_steel, False, Null);
            Set Player Variable At Index(Event Player, heart_steel, True, 1.5);
            Set Player Variable At Index(Event Player, heart_steel, 2, 1);
        End;
        Start Forcing Player To Be Hero(Event Player, Value In Array(Global.heroList, (Event Player).heroNumber));
        Stop Forcing Player To Be Hero(Event Player);
        Set Player Allowed Heroes(Event Player, Array Slice(Global.heroList, False, Add((Event Player).heroNumber, True)));
        Set Player Variable(Event Player, obstrucVis, Empty Array);
        If(Array Contains(Global.savedIndex, Custom String("{0}", Event Player)));
            Small Message(Event Player, Custom String("  你的进度已成功加载"));
            Small Message(Remove From Array(All Players(All Teams), Event Player), Custom String("  {0} 载入 {1}{2}", Event Player, Hero Icon String(Value In Array(Global.heroList, (Event Player).heroNumber)), Value In Array(Global.heroList, (Event Player).heroNumber)));
    }
}

rule ("auto reboot") {
    event {
        Ongoing - Global;
    }
    conditions {
        Total Time Elapsed >= Subtract(Global.rebootTime, 60);
    }
    actions {
        Big Message(All Players(All Teams), Custom String("游戏将在 1 分钟后自动重开"));
        Wait(60, Ignore Condition);
        Restart Match;
    }
}

rule ("[DevTool] Toggle menu") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Is Button Held(Event Player, Button(Interact)) == True;
        Is Button Held(Event Player, Button(Melee)) == True;
    }
    actions {
        Abort If(And(Is Button Held(Event Player, Button(Interact)), Is Button Held(Event Player, Button(Crouch))));
        Skip If(Compare((Event Player).menu, !=, Null), 11);
        Disallow Button(Event Player, Button(Primary Fire));
        Disallow Button(Event Player, Button(Secondary Fire));
        Disallow Button(Event Player, Button(Ability 1));
        Disallow Button(Event Player, Button(Ability 2));
        Disallow Button(Event Player, Button(Ultimate));
        Disallow Button(Event Player, Button(Jump));
        Disallow Button(Event Player, Button(Crouch));
        Disallow Button(Event Player, Button(Melee));
        Disallow Button(Event Player, Button(Reload));
        Set Player Variable(Event Player, menu, 1);
        Abort;
        Set Player Variable(Event Player, menu, Null);
        Destroy HUD Text(First Of((Event Player).menuTextID));
        Destroy HUD Text(Value In Array((Event Player).menuTextID, True));
        Destroy HUD Text(Value In Array((Event Player).menuTextID, 2));
        Allow Button(Event Player, Button(Primary Fire));
        Allow Button(Event Player, Button(Secondary Fire));
        Allow Button(Event Player, Button(Ability 1));
        Allow Button(Event Player, Button(Ability 2));
        Allow Button(Event Player, Button(Ultimate));
        Allow Button(Event Player, Button(Jump));
        Allow Button(Event Player, Button(Melee));
        Allow Button(Event Player, Button(Reload));
        Allow Button(Event Player, Button(Crouch));
    }
}

rule ("[DevTool] Cleanup closed menu") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        (Event Player).menu == Null;
    }
    actions {
        Destroy HUD Text(First Of((Event Player).menuTextID));
        Destroy HUD Text(Value In Array((Event Player).menuTextID, True));
        Destroy HUD Text(Value In Array((Event Player).menuTextID, 2));
        Allow Button(Event Player, Button(Primary Fire));
        Allow Button(Event Player, Button(Secondary Fire));
        Allow Button(Event Player, Button(Ability 1));
        Allow Button(Event Player, Button(Ability 2));
        Allow Button(Event Player, Button(Ultimate));
        Allow Button(Event Player, Button(Jump));
        Allow Button(Event Player, Button(Melee));
        Allow Button(Event Player, Button(Reload));
        Allow Button(Event Player, Button(Crouch));
    }
}

rule ("[DevTool] Advance page") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        (Event Player).menu != Null;
        Is Button Held(Event Player, Button(Crouch)) == True;
    }
    actions {
        If(Compare((Event Player).isDev, ==, True));
            If(Compare((Event Player).menu, >=, 5));
                Set Player Variable(Event Player, menu, 1);
            Else;
                Modify Player Variable(Event Player, menu, Add, True);
            End;
        Else;
            If(Compare((Event Player).menu, >=, 2));
                Set Player Variable(Event Player, menu, 1);
            Else;
                Modify Player Variable(Event Player, menu, Add, True);
            End;
        End;
        Wait Until(Not(Is Button Held(Event Player, Button(Crouch))), 99999);
    }
}

rule ("[DevTool] Display mode page") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        (Event Player).menu == 1;
    }
    actions {
        Destroy HUD Text(First Of((Event Player).menuTextID));
        Destroy HUD Text(Value In Array((Event Player).menuTextID, True));
        Destroy HUD Text(Value In Array((Event Player).menuTextID, 2));
        Create HUD Text(Event Player, Custom String("游戏内面板（{0}+{1}）", Input Binding String(Button(Interact)), Input Binding String(Button(Melee))), Null, Null, Top, 2, Color(White), Null, Null, Visible To String and Color, Visible Never);
        Set Player Variable At Index(Event Player, menuTextID, False, Last Text ID);
        If((Event Player).isDev);
            Create HUD Text(Event Player, Null, Custom String("{0}    自动重开：延长5分钟    \n{1}    自动重开：缩短5分钟    \n{2}", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire)), Custom String("{0}    上一个称号    \n{1}    下一个称号    \n{2}", Input Binding String(Button(Ultimate)), Input Binding String(Button(Ability 2)), Custom String("{0}    标记玩家    {1}\n{2}", Input Binding String(Button(Ability 1)), If-Then-Else(Compare(Global.targetPlayer, !=, Null), Custom String("{0}（{1}）", Global.targetPlayer, Hero Of(Global.targetPlayer)), Custom String("空")), Custom String("{0}    移除标记玩家并临时拉黑    \n{1}    第三人称视角    {2}", Input Binding String(Button(Reload)), Input Binding String(Button(Jump)), Custom String("{0}\n{1}    下一页    ", If-Then-Else(Compare((Event Player).third, ==, True), Custom String("O"), Custom String("X")), Input Binding String(Button(Crouch))))))), Null, Top, 3, Null, Color(White), Null, Visible To and String, Visible Never);
        Else If(Compare(Event Player, ==, Host Player));
            Create HUD Text(Event Player, Null, Custom String("{0}    自动重开：延长5分钟    \n{1}    自动重开：缩短5分钟    \n{2}", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire)), Custom String("{0}    下一个称号    \n{1}    标记玩家    {2}", Input Binding String(Button(Ability 2)), Input Binding String(Button(Ability 1)), Custom String("{0}\n{1}    移除标记玩家并临时拉黑    \n{2}", If-Then-Else(Compare(Global.targetPlayer, !=, Null), Custom String("{0}（{1}）", Global.targetPlayer, Hero Of(Global.targetPlayer)), Custom String("空")), Input Binding String(Button(Reload)), Custom String("{0}    第三人称视角    {1}\n{2}    下一页    ", Input Binding String(Button(Jump)), If-Then-Else(Compare((Event Player).third, ==, True), Custom String("O"), Custom String("X")), Input Binding String(Button(Crouch)))))), Null, Top, 3, Null, Color(White), Null, Visible To and String, Visible Never);
        Else;
            Create HUD Text(Event Player, Null, Custom String("{0}    下一个称号    \n{1}    第三人称视角    {2}", Input Binding String(Button(Ability 2)), Input Binding String(Button(Jump)), Custom String("{0}\n{1}    下一页    ", If-Then-Else(Compare((Event Player).third, ==, True), Custom String("O"), Custom String("X")), Input Binding String(Button(Crouch)))), Null, Top, 3, Null, Color(White), Null, Visible To and String, Visible Never);
        End;
        Set Player Variable At Index(Event Player, menuTextID, True, Last Text ID);
    }
}

rule ("[DevTool] Display hero page") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Or(Or(Compare(Global.controlRespawnPosition, ==, Null), (Event Player).isWinner), Compare(Count Of(Global.controlRespawnPosition), <, 3)) == True;
        Or(And(Compare((Event Player).menu, ==, 2), Compare((Event Player).isDev, ==, False)), And(Compare((Event Player).menu, ==, 5), Compare((Event Player).isDev, ==, True))) == True;
    }
    actions {
        Destroy HUD Text(First Of((Event Player).menuTextID));
        Destroy HUD Text(Value In Array((Event Player).menuTextID, True));
        Destroy HUD Text(Value In Array((Event Player).menuTextID, 2));
        Create HUD Text(Event Player, Custom String("英雄选择/切换"), Null, Null, Top, 2, Color(White), Null, Null, Visible To String and Color, Visible Never);
        Set Player Variable At Index(Event Player, menuTextID, False, Last Text ID);
        Modify Player Variable(Event Player, menuHeroIndex, Modulo, Add(If-Then-Else(Compare((Event Player).heroNumber, >, Subtract(Count Of(Global.heroList), True)), Subtract(Count Of(Global.heroList), True), (Event Player).heroNumber), True));
        Create HUD Text(Event Player, Null, Custom String("{0}    选择英雄：{1}    \n{2}    应用切换（重生室）    \n", Input Binding String(Button(Primary Fire)), Value In Array(Global.heroList, (Event Player).menuHeroIndex), Input Binding String(Button(Reload))), Null, Top, 3, Null, Color(White), Null, Visible To and String, Visible Never);
        Set Player Variable At Index(Event Player, menuTextID, True, Last Text ID);
    }
}

rule ("[DevTool] Cycle hero selection") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Or(And(Compare((Event Player).menu, ==, 2), Compare((Event Player).isDev, ==, False)), And(Compare((Event Player).menu, ==, 5), Compare((Event Player).isDev, ==, True))) == True;
        Is Button Held(Event Player, Button(Primary Fire)) == True;
    }
    actions {
        Modify Player Variable(Event Player, menuHeroIndex, Add, True);
        Modify Player Variable(Event Player, menuHeroIndex, Modulo, Add(If-Then-Else(Compare((Event Player).heroNumber, >, Subtract(Count Of(Global.heroList), True)), Subtract(Count Of(Global.heroList), True), (Event Player).heroNumber), True));
        Wait Until(Not(Is Button Held(Event Player, Button(Primary Fire))), 99999);
    }
}

rule ("[DevTool] Apply hero selection") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Or(Or(Compare(Global.controlRespawnPosition, ==, Null), (Event Player).isWinner), Compare(Count Of(Global.controlRespawnPosition), <, 3)) == True;
        Or(And(Compare((Event Player).menu, ==, 2), Compare((Event Player).isDev, ==, False)), And(Compare((Event Player).menu, ==, 5), Compare((Event Player).isDev, ==, True))) == True;
        Is Button Held(Event Player, Button(Reload)) == True;
        Is In Spawn Room(Event Player) == True;
        Is Moving(Event Player) == False;
    }
    actions {
        Modify Player Variable(Event Player, menuHeroIndex, Modulo, Add(If-Then-Else(Compare((Event Player).heroNumber, >, Subtract(Count Of(Global.heroList), True)), Subtract(Count Of(Global.heroList), True), (Event Player).heroNumber), True));
        Start Forcing Player To Be Hero(Event Player, Value In Array(Global.heroList, (Event Player).menuHeroIndex));
        Wait Until(Compare(Hero Of(Event Player), ==, Value In Array(Global.heroList, (Event Player).heroNumber)), 0.5);
        Stop Forcing Player To Be Hero(Event Player);
        Wait(Multiply(Divide(Server Load, 100), 0.5), Ignore Condition);
        Set Player Allowed Heroes(Event Player, Array Slice(Global.heroList, False, Add((Event Player).heroNumber, True)));
        Wait Until(Not(Is Button Held(Event Player, Button(Reload))), 99999);
    }
}

