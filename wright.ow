rule ("[VishkarEvent]: 死亡延迟") {
    event {
        Player Took Damage;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Is Alive(Event Player), Compare((Event Player).eventType, ==, Null), Compare((Event Player).eventId, ==, 8), Compare(Hero Of(Attacker), !=, Hero Of(Event Player)), Compare(First Of((Event Player).invincibleEffect), ==, Null), Has Status(Event Player, Unkillable)), Current Array Element) == True;
        Is True For Any(Array(Compare(Event Damage, >=, Health(Event Player)), Compare(Health(Event Player), <=, Divide(Multiply(Max Health(Event Player), 15), 100)), And(And(Compare(Event Ability, ==, Button(Secondary Fire)), Compare(Hero Of(Attacker), ==, Hero(Bastion))), Compare(Max Health(Event Player), <=, 500))), Current Array Element) == True;
    }
    actions {
        Create Effect(All Players(All Teams), Baptiste Immortality Field Protected Effect, Color(Team 1), Event Player, 200, Position and Radius);
        Set Player Variable At Index(Event Player, invincibleEffect, False, Last Created Entity);
        Create Effect(All Players(All Teams), Baptiste Immortality Field Protected Sound, Color(Team 1), Event Player, 200, Position and Radius);
        Set Player Variable(Event Player, eventEffect, Last Created Entity);
        Small Message(Event Player, Custom String("  {0}  已触发死亡延迟，致命伤害已延后", Ability Icon String(Hero(Baptiste), Button(Ability 2))));
        Wait Until(Is True For Any(Array(Compare((Event Player).eventId, ==, -1), Is Dead(Event Player)), Current Array Element), (Event Player).eventDuration);
        Clear Status(Event Player, Unkillable);
        Destroy Effect(First Of((Event Player).invincibleEffect));
        Set Player Variable At Index(Event Player, invincibleEffect, False, Null);
        Abort If(Is Dead(Event Player));
        Wait(False, Ignore Condition);
        Skip If(Is True For Any(Array(Or(Or(Has Status(Event Player, Invincible), Has Status(Event Player, Unkillable)), Has Status(Event Player, Phased Out)), Not(Has Spawned(Event Player)), Is Dead(Event Player)), Current Array Element), 2);
        Small Message(Event Player, Custom String("  {0} 死亡延迟：致命伤害已施加", Icon String(Skull)));
        Damage(Event Player, Attacker, 9999999999);
    }
}

rule ("[VishkarEvent]: ↑↑↓↓←→←→BABA") {
    event {
        Player Died;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, Null), Compare((Event Player).eventId, ==, 9)), Current Array Element) == True;
        (Event Player).isWinner != True;
    }
    actions {
        Set Player Variable(Event Player, controlPlayerRespawnPosition, Array(Position Of(Event Player), Facing Direction Of(Event Player), Hero Of(Event Player)));
        Big Message(Event Player, Custom String("↑↑↓↓←→←→BABA"));
        Play Effect(All Players(All Teams), Tracer Recall Disappear Effect, Color(Team 1), Event Player, 200);
        Disable Built-In Game Mode Respawning(Event Player);
        Wait(3, Ignore Condition);
        Enable Built-In Game Mode Respawning(Event Player);
        Resurrect(Event Player);
        Teleport(Event Player, First Of((Event Player).controlPlayerRespawnPosition));
        Set Facing(Event Player, Value In Array((Event Player).controlPlayerRespawnPosition, True), To World);
        Play Effect(All Players(All Teams), Tracer Recall Reappear Effect, Color(Team 1), Event Player, 200);
        Wait(0.5, Ignore Condition);
        Set Player Variable(Event Player, controlPlayerRespawnPosition, Null);
        Set Player Variable(Event Player, eventDuration, Null);
    }
}

