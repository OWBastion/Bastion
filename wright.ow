rule ("[Bastion] Init spawn state") {
    event {
        Ongoing - Each Player;
        Team 2;
        Bastion;
    }
    conditions {
        Is Alive(Event Player) == True;
        Has Spawned(Event Player) == True;
    }
    actions {
        Wait(0.25, Ignore Condition);
        Set Damage Dealt(Event Player, Add(100, Multiply(50, Global.difficulty)));
        Teleport(Event Player, Value In Array(Global.bastionPosition, Slot Of(Event Player)));
        If(Not(Has Status(Event Player, Unkillable)));
            Set Status(Event Player, Null, Unkillable, 99999);
            Set Knockback Received(Event Player, 1);
    }
}

rule ("[Bastion] Freeze match time") {
    event {
        Ongoing - Global;
    }
    conditions {
        Is In Setup == False;
    }
    actions {
        If(Not(Global.debugMode));
            Disable Inspector Recording;
        End;
        Disable Built-In Game Mode Completion;
        Disable Built-In Game Mode Announcer;
        Disable Built-In Game Mode Music;
        Disable Built-In Game Mode Scoring;
        Wait(True, Ignore Condition);
        Pause Match Time;
        Set Slow Motion(90);
    }
}

rule ("[Bastion] Restart active match") {
    event {
        Ongoing - Global;
    }
    conditions {
        Current Game Mode != Game Mode(Skirmish);
        Or(Or(Is In Setup, Is Assembling Heroes), Is Game In Progress) == True;
    }
    actions {
        Disable Built-In Game Mode Announcer;
        Wait(False, Ignore Condition);
        Destroy All Dummy Bots;
        Destroy All Effects;
        Destroy All HUD Text;
        Destroy All Icons;
        Destroy All In-World Text;
        Destroy All Progress Bar HUD Text;
        Wait(False, Ignore Condition);
        Disable Messages(All Players(Team 1));
        Disable Game Mode HUD(All Players(Team 1));
        Disable Game Mode In-World UI(All Players(Team 1));
        Disable Built-In Game Mode Respawning(All Players(Team 1));
        Unpause Match Time;
        While(Not(Is Game In Progress));
            Set Match Time(False);
            Wait(False, Ignore Condition);
        End;
        Create Icon(All Players(Team 1), Vector(False, 101, -0.25), Warning, Color, Custom Color(Add(220, Multiply(Sine From Radians(Multiply(Total Time Elapsed, 3.141)), 35)), 0, 0, 255), False);
        Create In-World Text(All Players(Team 1), Custom String("主机开始了游戏模式.\n这将导致智械危机.\n\n                      正在重开..."), Multiply(101, Up), 3, Do Not Clip, Color, Custom Color(Add(220, Multiply(Sine From Radians(Multiply(Total Time Elapsed, 3.141)), 35)), 0, 0, 255), Visible Always);
        For Global Variable(I, 0, 5, True);
            Create Effect(All Players(Team 1), Orb, Color(Black), Multiply(Add(100, Divide(Multiply(0.5, Add(Global.I, True)), 5)), Up), Add(2, Multiply(2, Add(Global.I, 5))), None);
            Create Effect(All Players(Team 1), Sphere, Color(Black), Multiply(100, Up), Add(2, Multiply(2, Add(Global.I, 5))), None);
            Create Effect(All Players(Team 1), Bad Aura, Color(Black), Multiply(Add(100, Divide(Multiply(3, Add(Global.I, True)), 5)), Up), Add(2, Multiply(2, Add(Global.I, 5))), None);
            Wait(False, Ignore Condition);
        End;
        Start Forcing Player To Be Hero(All Players(Team 1), Hero(Sombra));
        Wait(False, Ignore Condition);
        Kill(All Players(Team 1), Host Player);
        Disable Hero HUD(All Players(Team 1));
        Start Camera(All Players(Team 1), Multiply(100, Up), Vector(False, 101, 0.01), 0);
        Wait(5, Ignore Condition);
        Enable Built-In Game Mode Music;
        Declare Team Victory(Team 2);
        Destroy All In-World Text;
        Destroy All Icons;
        Wait(2, Ignore Condition);
        Wait Until(Compare(Total Time Elapsed, >, 30), 30);
        Restart Match;
    }
}

rule ("[Bastion] Label bot names") {
    event {
        Player Joined Match;
        Team 2;
        All;
    }
    actions {
        Start Forcing Dummy Bot Name(Event Player, Custom String("看守{0} 击杀{1}", Add(Slot Of(Event Player), True), Value In Array(Global.kills, Slot Of(Event Player))));
    }
}

rule ("[Bastion] Apply player damage reduction") {
    event {
        Ongoing - Global;
    }
    conditions {
        Global.difficulty != 5;
        Global.dmgReduction == False;
    }
    actions {
        Start Damage Modification(All Players(Team 2), Filtered Array(All Players(Team 1), Not((Current Array Element).isDev)), 0.1, Receivers and Damagers);
    }
}

rule ("[Bastion] Disable player HUD") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Has Spawned(Event Player) == True;
    }
    actions {
        Disable Game Mode HUD(Event Player);
        Disable Game Mode In-World UI(Event Player);
        Disable Movement Collision With Players(Event Player);
    }
}

rule ("[Bastion] Maintain assault form") {
    event {
        Ongoing - Each Player;
        Team 2;
        Bastion;
    }
    conditions {
        Total Time Elapsed > 10;
        Ability Cooldown(Event Player, Button(Ability 1)) == Null;
    }
    actions {
        If(Compare((Event Player).target, !=, Null));
            Set Player Variable(Event Player, lastThreatTime, Total Time Elapsed);
        End;
        If(Not(Is In Alternate Form(Event Player)));
            Cancel Primary Action(Event Player);
            Set Ability Cooldown(Event Player, Button(Ability 1), False);
            Press Button(Event Player, Button(Ability 1));
        End;
        Wait(If-Then-Else(Or(Compare((Event Player).target, !=, Null), Compare(Subtract(Total Time Elapsed, (Event Player).lastThreatTime), <=, 1)), 0.064, 0.25), Abort When False);
        Loop If Condition Is True;
    }
}

rule ("[Bastion] Refresh assault form") {
    event {
        Ongoing - Each Player;
        Team 2;
        Bastion;
    }
    conditions {
        Total Time Elapsed > 10;
        Is In Alternate Form(Event Player) == False;
        (Event Player).target == False;
        First Of(Players Within Radius(Position Of(Event Player), 110, Team 1, Off)) != False;
    }
    actions {
        Wait(Random Real(0.2, 1), Abort When False);
        Press Button(Event Player, Button(Ability 1));
        Wait(Random Real(1, 3), Ignore Condition);
        Loop If Condition Is True;
    }
}

rule ("[Bastion] Acquire target") {
    event {
        Ongoing - Each Player;
        Team 2;
        Bastion;
    }
    conditions {
        Is Dummy Bot(Event Player) == True;
        Has Spawned(Event Player) == True;
        Is Alive(Event Player) == True;
    }
    actions {
        Wait(Random Real(If-Then-Else(Compare((Event Player).target, !=, Null), 0.2, 0.06), If-Then-Else(Compare((Event Player).target, !=, Null), 0.35, 0.12)), Ignore Condition);
        Skip If(And(And(And(And(And(And(Compare((Event Player).target, !=, Null), Has Spawned((Event Player).target)), Not(((Event Player).target).isWinner)), Not(Has Status((Event Player).target, Phased Out))), Not(((Event Player).target).targetSilence)), Compare(Distance Between(Event Player, (Event Player).target), <, 100)), Or(Is In Line of Sight(Eye Position(Event Player), Eye Position((Event Player).target), Barriers Do Not Block LOS), Is In Line of Sight(Eye Position(Event Player), Position Of((Event Player).target), Barriers Do Not Block LOS))), 22);
        If(Compare(First Of(Players Within Radius(Eye Position(Event Player), 105, Team 1, Surfaces)), ==, False));
            Set Player Variable(Event Player, target, Null);
            Wait(Random Real(0.06, 0.12), Abort When False);
            Loop;
        End;
        Set Player Variable(Event Player, temp, Filtered Array(All Living Players(Team 1), And(And(And(And(Has Spawned(Current Array Element), Not((Current Array Element).isWinner)), Not(Has Status(Current Array Element, Phased Out))), Not((Current Array Element).targetSilence)), Compare(Distance Between(Event Player, Current Array Element), <, 100))));
        Wait(False, Ignore Condition);
        Set Player Variable(Event Player, temp, Filtered Array((Event Player).temp, Or(Is In Line of Sight(Eye Position(Event Player), Eye Position(Current Array Element), Barriers Do Not Block LOS), Is In Line of Sight(Eye Position(Event Player), Position Of(Current Array Element), Barriers Do Not Block LOS))));
        Wait(False, Ignore Condition);
        If(Not((Event Player).temp));
            Set Player Variable(Event Player, target, Null);
            Skip(10);
        End;
        If(Compare(Count Of((Event Player).temp), >, 1));
            Set Player Variable(Event Player, temp, Sorted Array((Event Player).temp, If-Then-Else(Compare(Global.bastionBotTargetPrefer, ==, Null), Multiply(Health(Current Array Element), Distance Between(Event Player, Current Array Element)), If-Then-Else(Compare(Global.bastionBotTargetPrefer, ==, 1), Distance Between(Event Player, Current Array Element), Health(Current Array Element)))));
            Set Player Variable(Event Player, target, First Of((Event Player).temp));
            Wait(False, Ignore Condition);
        Else If(Compare(First Of((Event Player).temp), !=, Null));
            Set Player Variable(Event Player, target, First Of((Event Player).temp));
        Else;
            Set Player Variable(Event Player, target, Null);
        End;
        Wait(0.2, Ignore Condition);
        Loop If Condition Is True;
        Set Player Variable(Event Player, target, Null);
    }
}

rule ("[Bastion] Force primary fire") {
