    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 1), Compare((Event Player).eventId, ==, 9)), Current Array Element) == True;
        Hero Of(Attacker) == Hero(Bastion);
        Event Ability != Null;
    }
    actions {
        Damage(Filtered Array(All Living Players(Team 1), And(And(Not(Or(Has Status(Current Array Element, Phased Out), Has Status(Current Array Element, Invincible))), Compare(Distance Between(Event Player, Current Array Element), <=, 20)), Compare(Event Player, !=, Current Array Element))), Attacker, Multiply(Event Damage, 0.75));
        Wait(False, Ignore Condition);
    }
}

rule ("[VishkarEvent]: 狂欢盛宴") {
    event {
        Player Died;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 1), Compare((Event Player).eventId, ==, 10), Compare(Hero Of(Attacker), ==, Hero(Bastion))), Current Array Element) == True;
    }
    actions {
        Big Message(All Players(All Teams), Custom String("盛宴！"));
        Small Message(All Players(Team 1), Custom String("  {0} {1} 阵亡触发了狂欢盛宴", Icon String(Warning), Event Player));
        Set Player Variable(All Players(Team 2), hasNano, True);
        Modify Global Variable(berserkerTime, Add, 10);
        Wait(5, Ignore Condition);
    }
}

rule ("[VishkarEvent]: 狂欢盛宴计时器") {
    event {
        Ongoing - Global;
    }
    conditions {
        Global.berserkerTime != Null;
    }
    actions {
        Wait(2, Ignore Condition);
        Modify Global Variable(berserkerTime, Subtract, 2);
        Loop If Condition Is True;
        Set Player Variable(All Players(Team 2), hasNano, False);
        Set Global Variable(eventId, -1);
    }
}

rule ("[VishkarEvent]: 归于大地") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Is Alive(Event Player), Compare((Event Player).eventType, ==, 1), Compare((Event Player).eventId, ==, 11)), Current Array Element) == True;
    }
    actions {
        Wait(1.5, Abort When False);
        Set Status(All Living Players(Team 1), Event Player, Knocked Down, 2.5);
    }
}

rule ("[VishkarEvent]: 减半") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Compare((Event Player).eventType, ==, 1), Compare((Event Player).eventId, ==, 12), Compare(Health(Event Player), !=, Null)), Current Array Element) == True;
    }
    actions {
        Set Player Variable(Event Player, passiveRegenBlocked, True);
        If(Compare(Health(Event Player), <=, Divide(Multiply(Max Health(Event Player), 5), 100)));
            Kill(Event Player, Event Player);
            Play Effect(All Players(All Teams), DVa Self Destruct Explosion Effect, Color(Team 2), Event Player, 200);
        Else;
            Wait(3, Ignore Condition);
            Start Damage Over Time(Event Player, Null, 1, Multiply(Health(Event Player), 0.5));
            Play Effect(All Players(All Teams), Zarya Particle Cannon Explosion Effect, Color(Team 2), Event Player, 3);
        End;
        Loop If Condition Is True;
        Set Player Variable(Event Player, passiveRegenBlocked, False);
        Call Subroutine(startCombatRegen);
    }
}

rule ("[Event/舍己为人] Resolve giveaway") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 1), Compare((Event Player).eventId, ==, 13)), Current Array Element) == True;
    }
    actions {
        Modify Player Variable At Index(Event Player, dlcTimeChallenge, True, Add, True);
        If(Compare(Max Health(Event Player), <=, 125));
            Set Player Variable(Event Player, eventDuration, Null);
        Else;
            Modify Player Variable At Index(Remove From Array(All Players(Team 1), Event Player), heart_steel, False, Add, 2);
            Set Player Variable(Remove From Array(All Players(Team 1), Event Player), setPlayerHP, True);
            Modify Player Variable At Index(Event Player, heart_steel, False, Subtract, Multiply(2, Count Of(Remove From Array(All Players(Team 1), Event Player))));
            Call Subroutine(setPlayerHP);
        End;
        Play Effect(All Players(All Teams), Orisa Halt Implosion Effect, Color(Team 1), Event Player, 200);
        Play Effect(All Players(All Teams), Good Pickup Effect, Color(Green), Event Player, 100);
        Wait((Event Player).eventDuration, Ignore Condition);
    }
}

rule ("[Event/舍己为人] Rebuild max health") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), (Event Player).setPlayerHP), Current Array Element) == True;
    }
    actions {
        If(Is True For All(Array(Compare((Event Player).eventType, ==, Null), Compare((Event Player).eventId, ==, 14)), Current Array Element));
            Set Player Variable(Event Player, temp, Normalized Health(Event Player));
            Set Max Health(Event Player, Add(100, Multiply(First Of((Event Player).heart_steel), 2)));
            Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
            Set Player Health(Event Player, Multiply(Max Health(Event Player), (Event Player).temp));
        Else;
            Call Subroutine(setPlayerHP);
        End;
        Set Player Variable(Event Player, setPlayerHP, False);
    }
}

rule ("[VishkarEvent]: 保持距离 Track") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 1), Compare((Event Player).eventId, ==, 14)), Current Array Element) == True;
    }
    actions {
        Modify Player Variable At Index(Event Player, dlcTimeChallenge, 6, Add, True);
    }
}

rule ("[VishkarEvent]: 保持距离 (易伤光环)") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Is Alive(Event Player), Compare((Event Player).eventType, ==, 1), Compare((Event Player).eventId, ==, 14)), Current Array Element) == True;
    }
    actions {
        Set Player Variable(Event Player, target, Remove From Array(Players Within Radius(Event Player, 25, Team 1, Surfaces), Event Player));
        If(Compare(Count Of((Event Player).target), >, 1));
            Set Player Variable(Event Player, target, First Of(Sorted Array((Event Player).target, Distance Between(Event Player, Current Array Element))));
        Else If(Compare(First Of((Event Player).target), !=, Null));
            Set Player Variable(Event Player, target, First Of((Event Player).target));
        Else;
            Set Player Variable(Event Player, target, Null);
        End;
        If(Compare((Event Player).target, !=, Null));
            Set Player Variable(Event Player, mod_dmg_taken, Min(75, Max(False, Multiply(Subtract(25, Distance Between(Event Player, (Event Player).target)), 3))));
            Set Player Variable(Event Player, hudText, Custom String("受到伤害 +{0}%", (Event Player).mod_dmg_taken));
        Else;
            Set Player Variable(Event Player, mod_dmg_taken, Null);
            Set Player Variable(Event Player, hudText, Char In String(Empty Array, False));
        End;
        Call Subroutine(updatePlayerStats);
        Wait(True, Ignore Condition);
        Loop If Condition Is True;
        Set Player Variable(Event Player, mod_dmg_taken, Null);
        Set Player Variable(Event Player, hudText, Char In String(Empty Array, False));
        Call Subroutine(updatePlayerStats);
    }
}

rule ("[VishkarEvent]: 登月火箭") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 1), Compare((Event Player).eventId, ==, 15)), Current Array Element) == True;
    }
    actions {
        Modify Player Variable At Index(Event Player, dlcTimeChallenge, 2, Add, True);
        Play Effect(All Players(All Teams), DVa Self Destruct Explosion Effect, Color(Team 2), Event Player, 200);
        Play Effect(All Players(All Teams), Ring Explosion Sound, Color(Team 1), Event Player, 200);
        Start Forcing Throttle(Event Player, False, False, False, False, False, False);
        Set Gravity(Event Player, 5);
        Wait(0.32, Ignore Condition);
        Apply Impulse(Event Player, Up, 95, To World, Cancel Contrary Motion);
        Wait((Event Player).eventDuration, Ignore Condition);
        Stop Forcing Throttle(Event Player);
        Set Gravity(Event Player, 100);
    }
}

rule ("[Event/缺德导航] Random launch") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Is Alive(Event Player), Compare((Event Player).eventType, ==, 1), Compare((Event Player).eventId, ==, 17)), Current Array Element) == True;
    }
    actions {
        Wait(5, Abort When False);
        Apply Impulse(Event Player, Direction From Angles(Random Integer(False, 359), 0), 180, To World, Cancel Contrary Motion);
        Loop If Condition Is True;
    }
}

rule ("[Event/超重背包] Refresh damage taken") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 1), Compare((Event Player).eventId, ==, 18)), Current Array Element) == True;
    }
    actions {
        Set Player Variable(Event Player, temp, Multiply(Round To Integer(Divide(Max Health(Event Player), 100), Down), 10));
        If(Compare((Event Player).mod_dmg_taken, !=, (Event Player).temp));
            Set Player Variable(Event Player, mod_dmg_taken, (Event Player).temp);
            Call Subroutine(updatePlayerStats);
        End;
        Wait(0.25, Abort When False);
        Loop If Condition Is True;
        If(Compare((Event Player).mod_dmg_taken, !=, Null));
            Set Player Variable(Event Player, mod_dmg_taken, Null);
            Call Subroutine(updatePlayerStats);
    }
}

rule ("[VishkarEvent]: 阿德勒斯布鲁恩的冤魂") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 1), Compare((Event Player).eventId, ==, 16)), Current Array Element) == True;
    }
    actions {
        Set Player Variable(Event Player, eventMission, 7);
        Modify Player Variable(Event Player, mod_heal_perma, Add, Multiply((Event Player).eventMission, -10));
        Set Player Variable(Event Player, hudText, Custom String("诅咒：{0}层", (Event Player).eventMission));
        Call Subroutine(updatePlayerStats);
        Wait((Event Player).eventDuration, Ignore Condition);
        Set Player Variable(Event Player, hudText, Char In String(Empty Array, False));
    }
}

rule ("[VishkarEvent]: 阿德勒斯布鲁恩的冤魂 (抵消层数)") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 1), Compare((Event Player).eventId, ==, 16), Compare((Event Player).eventMission, >, Null), Is Button Held(Event Player, Button(Reload))), Current Array Element) == True;
    }
    actions {
        Wait(True, Abort When False);
        Damage(Event Player, Null, Divide(Multiply(Max Health(Event Player), 99), 100));
        Modify Player Variable(Event Player, eventMission, Subtract, True);
        Modify Player Variable(Event Player, mod_heal_perma, Add, 10);
        Set Player Variable(Event Player, hudText, Custom String("诅咒：{0}层", (Event Player).eventMission));
        Call Subroutine(updatePlayerStats);
        Wait(10, Ignore Condition);
    }
}

rule ("[Event/极限挑战] Apply challenge") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, Null)), Current Array Element) == True;
    }
    actions {
        Wait Until(Is Alive(Event Player), 999999999999);
        Set Player Variable(Event Player, mod_heal_event, -1000);
        Set Player Variable(Event Player, heal_recv, -1000);
        Create Effect(All Players(All Teams), Ana Biotic Grenade No Healing Effect, Color(Team 1), Event Player, 200, Position and Radius);
        Set Player Variable(Event Player, eventEffect, Last Created Entity);
        Play Effect(Event Player, Ana Biotic Grenade No Healing Sound, Color(White), Event Player, 200);
        Set Player Health(Event Player, Divide(Multiply(Max Health(Event Player), 15), 100));
        Set Player Variable(Event Player, mod_dmg_taken, Subtract(-99, (Event Player).mod_dmg_perma));
        Call Subroutine(updatePlayerStats);
        Wait Until(Is Dead(Event Player), (Event Player).eventDuration);
        Set Player Variable(Event Player, mod_dmg_taken, Null);
        Call Subroutine(updatePlayerStats);
        Set Player Variable(Event Player, mod_heal_event, Null);
        Set Player Variable(Event Player, heal_recv, Null);
        Call Subroutine(updatePlayerStats);
        Set Player Variable(Event Player, eventDuration, Null);
    }
}

rule ("[Event/极限挑战] Clamp health") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, Null)), Current Array Element) == True;
        Health(Event Player) > Divide(Multiply(Max Health(Event Player), 15), 100);
    }
    actions {
        Wait(0.5, Abort When False);
        Set Player Health(Event Player, Divide(Multiply(Max Health(Event Player), 15), 100));
        Wait(5, Ignore Condition);
        Loop If Condition Is True;
    }
}

rule ("[VishkarEvent]: 赌徒") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 1), Is Button Held(Event Player, Button(Reload))), Current Array Element) == True;
    }
    actions {
        Wait(True, Abort When False);
        If(Compare(Random Integer(False, 99), <, 50));
            Modify Player Variable At Index(Event Player, heart_steel, False, Add, Multiply(8, Value In Array((Event Player).heart_steel, True)));
            Small Message(Event Player, Custom String("  {0}  赢！获得 {1} 层心之钢层数（{2}%）", Icon String(Club), Multiply(8, Value In Array((Event Player).heart_steel, True)), Multiply(Multiply(8, Value In Array((Event Player).heart_steel, True)), Value In Array((Event Player).heart_steel, 2))));
        Else;
            Modify Player Variable At Index(Event Player, heart_steel, False, Subtract, 8);
            Modify Global Variable(gamblerHeartsteelJackpot, Add, 8);
            Small Message(Event Player, Custom String("  {0}  输！失去 8 层心之钢层数（{1}%）", Icon String(Diamond), Multiply(8, Value In Array((Event Player).heart_steel, 2))));
        End;
        Wait(False, Ignore Condition);
        Call Subroutine(setPlayerHP);
        Wait(False, Ignore Condition);
        Set Player Variable(Event Player, eventDuration, Null);
    }
}

rule ("[VishkarEvent]: 迷你形态") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 2)), Current Array Element) == True;
    }
    actions {
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Set Player Variable(Event Player, sizeHealth, 0.5);
        Start Scaling Player(Event Player, 0.4, False);
        Start Scaling Barriers(Event Player, 0.4, False);
        Start Modifying Hero Voice Lines(Event Player, 1.5, False);
        Set Player Variable(Event Player, mod_speed_event, 25);
        Call Subroutine(updatePlayerStats);
        Call Subroutine(setPlayerHP);
        Wait Until(Compare((Event Player).eventId, ==, -1), (Event Player).eventDuration);
        Set Player Variable(Event Player, sizeHealth, 1);
        Call Subroutine(setPlayerHP);
        Set Player Variable(Event Player, mod_speed_event, Null);
        Call Subroutine(updatePlayerStats);
        Stop Scaling Player(Event Player);
        Stop Scaling Barriers(Event Player);
        Stop Modifying Hero Voice Lines(Event Player);
    }
}

rule ("[Event/悄悄地进村] Create effect") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 3), Compare((Event Player).eventEffect, ==, Null)), Current Array Element) == True;
    }
    actions {
        Create Effect(If-Then-Else(Is Button Held(Event Player, Button(Crouch)), All Players(All Teams), Null), Reaper Wraith Form Effect, Color(Team 1), Event Player, 200, Visible To Position and Radius);
        Set Player Variable(Event Player, eventEffect, Last Created Entity);
        Wait Until(Or(Compare((Event Player).eventId, !=, 3), Compare((Event Player).eventType, !=, 2)), (Event Player).eventDuration);
    }
}

rule ("[Event/悄悄地进村] Apply stealth crouch") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 3)), Current Array Element) == True;
        Is Button Held(Event Player, Button(Crouch)) == True;
    }
    actions {
        Set Player Variable(Event Player, targetSilence, True);
        Modify Player Variable(Event Player, mod_speed_event, Add, 300);
        Call Subroutine(updatePlayerStats);
        Wait Until(Not(Is Button Held(Event Player, Button(Crouch))), (Event Player).eventDuration);
        Set Player Variable(Event Player, targetSilence, False);
        Set Player Variable(Event Player, mod_speed_event, Null);
        Call Subroutine(updatePlayerStats);
        Wait(0.25, Ignore Condition);
    }
}

rule ("[Event/悄悄地进村] Drain health") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 3), Is Button Held(Event Player, Button(Crouch)), Is Moving(Event Player), Compare(Speed Of(Event Player), !=, Null)), Current Array Element) == True;
    }
    actions {
        Wait(True, Abort When False);
        Damage(Event Player, Null, Divide(Multiply(Max Health(Event Player), 10), 100));
        Loop If Condition Is True;
        Wait(True, Ignore Condition);
