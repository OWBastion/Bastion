        Set Player Variable(Event Player, turnSpeed, Multiply(Angle Between Vectors(Facing Direction Of(Event Player), Direction Towards(Eye Position(Event Player), Eye Position((Event Player).target))), Global.turnSpeedMultiplier));
        Modify Player Variable(Event Player, turnSpeed, Add, Multiply(Speed Of((Event Player).target), Global.turnSpeedMultiplier));
        Wait(0.1, Ignore Condition);
        Loop If Condition Is True;
    }
}

rule ("[Bastion] Boost turn speed") {
    event {
        Ongoing - Each Player;
        Team 2;
        Bastion;
    }
    conditions {
        Is Dummy Bot(Event Player) == True;
