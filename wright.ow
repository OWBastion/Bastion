        Start Forcing Dummy Bot Name(Event Player, Custom String("看守{0} 击杀{1}", Add(Slot Of(Event Player), True), Value In Array(Global.kills, Slot Of(Event Player))));
        Stop Forcing Player Outlines((Victim).attacker, Victim);
        Wait(0.032, Ignore Condition);
        Set Player Variable(Victim, attacker, Attacker);
        Start Forcing Player Outlines((Victim).attacker, Victim, True, Color(Red), Always);
    }
}

rule ("[Core] Reset to control respawn") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Global.controlRespawnPosition != Null;
        Has Spawned(Event Player) == True;
        Is Alive(Event Player) == True;
        Is In Spawn Room(Event Player) == True;
        Value In Array(Global.controlRespawnPosition, (Event Player).controlJumpIndex) != Null;
        Is True For Any(Array(And(Compare(Global.controlRespawnAxis, ==, Null), Compare(Distance Between(Multiply(X Component Of(Position Of(Event Player)), Left), Multiply(X Component Of(Value In Array(Global.controlRespawnPosition, (Event Player).controlJumpIndex)), Left)), >=, Global.controlRespawnAxisThreshold)), And(Compare(Global.controlRespawnAxis, ==, 1), Compare(Distance Between(Multiply(Y Component Of(Position Of(Event Player)), Up), Multiply(Y Component Of(Value In Array(Global.controlRespawnPosition, (Event Player).controlJumpIndex)), Up)), >=, Global.controlRespawnAxisThreshold)), And(Compare(Global.controlRespawnAxis, ==, 2), Compare(Distance Between(Multiply(Z Component Of(Position Of(Event Player)), Forward), Multiply(Z Component Of(Value In Array(Global.controlRespawnPosition, (Event Player).controlJumpIndex)), Forward)), >=, Global.controlRespawnAxisThreshold))), Current Array Element) == True;
    }
    actions {
        Teleport(Event Player, Value In Array(Global.controlRespawnPosition, (Event Player).controlJumpIndex));
        Set Facing(Event Player, Direction Towards(Eye Position(Event Player), Position Of(Value In Array(Global.controlJumpPosition, (Event Player).controlJumpIndex))), To World);
        Wait(0.032, Ignore Condition);
    }
}

rule ("[Core] Advance control jump") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Global.controlRespawnPosition != Null;
        Has Spawned(Event Player) == True;
        Is Alive(Event Player) == True;
        Is In Spawn Room(Event Player) == False;
        Is Moving(Event Player) == True;
        Value In Array(Global.controlJumpPosition, (Event Player).controlJumpIndex) != Null;
    }
    actions {
        Wait(0.032, Abort When False);
        Wait(0.2, Ignore Condition);
        If(Compare(Y Component Of(If-Then-Else(And(And(Compare((Event Player).possess, !=, Null), Compare(First Of((Event Player).possess), !=, Null)), Entity Exists(First Of((Event Player).possess))), Position Of(First Of((Event Player).possess)), Position Of(Event Player))), >=, Y Component Of(Value In Array(Global.controlJumpPosition, (Event Player).controlJumpIndex))));
            If(Compare(Distance Between(Multiply(If-Then-Else(And(And(Compare((Event Player).possess, !=, Null), Compare(First Of((Event Player).possess), !=, Null)), Entity Exists(First Of((Event Player).possess))), Position Of(First Of((Event Player).possess)), Position Of(Event Player)), Add(Left, Forward)), Multiply(Value In Array(Global.controlJumpPosition, (Event Player).controlJumpIndex), Add(Left, Forward))), <=, 4));
                Modify Player Variable(Event Player, controlJumpIndex, Add, True);
                Wait(False, Ignore Condition);
                Skip If(Is True For Any(Array(Has Status(Event Player, Phased Out), Has Status(Event Player, Invincible)), Current Array Element), 2);
                Set Status(Event Player, Null, Phased Out, 0.5);
                Set Status(Event Player, Null, Invincible, 0.5);
                Teleport(Event Player, Value In Array(Global.controlRespawnPosition, (Event Player).controlJumpIndex));
                Set Facing(Event Player, Direction Towards(Eye Position(Event Player), Position Of(Value In Array(Global.controlJumpPosition, (Event Player).controlJumpIndex))), To World);
                Wait(2.16, Ignore Condition);
            End;
        End;
        Loop;
    }
}

rule ("[Core] Resolve finish") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Has Spawned(Event Player) == True;
        Is Alive(Event Player) == True;
        Y Component Of(If-Then-Else(And(And(Compare((Event Player).possess, !=, Null), Compare(First Of((Event Player).possess), !=, Null)), Entity Exists(First Of((Event Player).possess))), Position Of(First Of((Event Player).possess)), Position Of(Event Player))) >= Y Component Of(Global.endPosition);
        Distance Between(Multiply(If-Then-Else(And(And(Compare((Event Player).possess, !=, Null), Compare(First Of((Event Player).possess), !=, Null)), Entity Exists(First Of((Event Player).possess))), Position Of(First Of((Event Player).possess)), Position Of(Event Player)), Add(Left, Forward)), Multiply(Global.endPosition, Add(Left, Forward))) <= 4;
    }
    actions {
        If(Compare(Count Of((Event Player).possessed), >, Null));
            Set Player Variable(Event Player, possessed, Empty Array);
        End;
        Respawn(Event Player);
        Wait(0.032, Ignore Condition);
        Skip If(Compare(Global.controlRespawnPosition, ==, Null), 4);
        Set Player Variable(Event Player, controlJumpIndex, Null);
        Teleport(Event Player, First Of(Global.controlRespawnPosition));
        Wait(0.032, Ignore Condition);
        Set Facing(Event Player, Direction Towards(Eye Position(Event Player), Position Of(First Of(Global.controlJumpPosition))), To World);
        If(And(Compare(Add((Event Player).heroNumber, True), <, Count Of(Global.heroList)), Compare(Hero Of(Event Player), ==, Value In Array(Global.heroList, (Event Player).heroNumber))));
            Call Subroutine(progressHero);
        Else If(And(Compare(Hero Of(Event Player), ==, Last Of(Global.heroList)), Not((Event Player).isWinner)));
            Set Player Variable(Event Player, isWinner, True);
            Set Player Variable(Event Player, winnerTime, Subtract(Evaluate Once(Total Time Elapsed), (Event Player).joinTime));
            Skip If(Is True For Any(Array((Event Player).dmgReduc, (Event Player).invincible, (Event Player).isPortalEnabled, (Event Player).isAirWalkEnabled), Current Array Element), True);
            Big Message(All Players(Team 1), Custom String("祝贺 {0} 以 {1} 次阵亡 & {2}", Event Player, (Event Player).runDeathCount, Custom String("{0} 次跳过 耗时 {1}{2}", (Event Player).skipCount, If-Then-Else(And(Compare((Event Player).winnerTime, !=, Null), Compare((Event Player).winnerTime, >=, 3600)), Custom String("{0} 小时", Round To Integer(Divide((Event Player).winnerTime, 3600), Down)), Char In String(Empty Array, False)), Custom String("{0}{1} 通关!", If-Then-Else(And(Compare((Event Player).winnerTime, !=, Null), Compare((Event Player).winnerTime, >=, 60)), Custom String("{0} 分", Round To Integer(Divide(Modulo((Event Player).winnerTime, 3600), 60), Down)), Char In String(Empty Array, False)), If-Then-Else(Compare((Event Player).winnerTime, !=, Null), Custom String("{0} 秒", Round To Integer(Modulo((Event Player).winnerTime, 60), Down)), Custom String("0 秒"))))));
            If(Compare(Global.hashTag, ==, True));
                Small Message(Event Player, Custom String("  {0} 你已通关，可以加入聊天群 发送截图 获取通关称号", Icon String(Checkmark)));
            End;
            Call Subroutine(savePlayerData);
    }
}

rule ("[Core] Charge winner ult") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        (Event Player).isWinner != False;
        Ultimate Charge Percent(Event Player) < 100;
        Is Using Ultimate(Event Player) == False;
    }
    actions {
        Wait(15, Abort When False);
        Set Ultimate Charge(Event Player, Min(100, Add(Ultimate Charge Percent(Event Player), 25)));
        Loop If Condition Is True;
    }
}

rule ("initialize effects") {
    event {
        Ongoing - Global;
    }
    actions {
        Set Global Variable(hashTag, If-Then-Else(Compare(Global.hashTag, ==, False), False, True));
        Set Global Variable(eventId, -1);
        Wait(Random Real(1, 2), Ignore Condition);
        Call Subroutine(setDifficulty);
        Create HUD Text(If-Then-Else(And(Compare(Add((Local Player).heroNumber, True), <, Count Of(Global.heroList)), Compare(Hero Of(Local Player), ==, Value In Array(Global.heroList, (Local Player).heroNumber))), Local Player, Null), Custom String(" "), Custom String("阵亡  {0} / {1}\n进度  {2}", (Local Player).progressionDeathCount, If-Then-Else(Compare(Global.difficulty, !=, 5), Global.maxDeath, Custom String("∞")), Custom String("{0} / {1}", Add(Index Of Array Value(Global.heroList, Hero Of(Local Player)), True), Count Of(Global.heroList))), Null, Left, 2, Value In Array(Global.difficultyText, True), Color(White), Null, Visible To and String, Default Visibility);
        Create HUD Text(If-Then-Else(Or((Local Player).isWinner, Compare(Hero Of(Local Player), !=, Value In Array(Global.heroList, (Local Player).heroNumber))), Null, Local Player), Custom String(" "), Custom String("下一个英雄"), Custom String("{0} {1}", If-Then-Else(Compare(Add((Local Player).heroNumber, True), <, Count Of(Global.heroList)), Hero Icon String(Value In Array(Global.heroList, Add((Local Player).heroNumber, True))), Icon String(Flag)), If-Then-Else(Compare(Add((Local Player).heroNumber, True), <, Count Of(Global.heroList)), Value In Array(Global.heroList, Add((Local Player).heroNumber, True)), Custom String("逃脱成功"))), Left, 4, Custom Color(36, 205, 244, 255), Color(White), Color(White), Visible To and String, Default Visibility);
        Create HUD Text(If-Then-Else(Or((Local Player).isWinner, Compare(Hero Of(Local Player), ==, Value In Array(Global.heroList, (Local Player).heroNumber))), Null, Local Player), Icon String(No), Custom String("下一个英雄"), Custom String("{0} 已解锁！", Hero Icon String(Value In Array(Global.heroList, (Local Player).heroNumber))), Left, 4, Custom Color(235, 45, 79, 255), Custom Color(235, 45, 79, 255), Custom Color(235, 45, 79, 255), Visible To and String, Default Visibility);
        Create HUD Text(If-Then-Else((Local Player).isWinner, Local Player, Null), Icon String(Checkmark), Custom String("下一个英雄"), Custom String("挑战完成"), Left, 4, Color(Green), Color(Green), Color(Green), Visible To and String, Default Visibility);
        Create HUD Text(Local Player, Null, Custom String("┌───────────┐"), Null, Left, 6, Null, Custom Color(160, 169, 186, 255), Null, Visible To and String, Visible Never);
        Create HUD Text(Local Player, Null, Custom String("总计阵亡/跳过 \n{0}/{1}\r\n增益/减益/总计\r\n{2}", (Local Player).runDeathCount, (Local Player).skipCount, Custom String("{0}/{1}/{2}", First Of((Local Player).eventCount), Value In Array((Local Player).eventCount, True), Custom String("{0} \r\n心之钢/移速/减伤/治疗%\r\n{1}/{2}", Add(Add(First Of((Local Player).eventCount), Value In Array((Local Player).eventCount, True)), Value In Array((Local Player).eventCount, 2)), Round To Integer(First Of((Local Player).heart_steel), Nearest), Custom String("{0}/{1}/{2}", (Local Player).mod_speed_perma, Multiply((Local Player).mod_dmg_perma, -1), Custom String("{0}%{1}{2}", Add((Local Player).mod_heal_perma, (Local Player).mod_heal_event), If-Then-Else((Local Player).isWinner, Custom String("\n通关总计耗时\n{0}{1}{2}", If-Then-Else(And(Compare((Local Player).winnerTime, !=, Null), Compare((Local Player).winnerTime, >=, 3600)), Custom String("{0} 小时", Round To Integer(Divide((Local Player).winnerTime, 3600), Down)), Char In String(Empty Array, False)), If-Then-Else(And(Compare((Local Player).winnerTime, !=, Null), Compare((Local Player).winnerTime, >=, 60)), Custom String("{0} 分", Round To Integer(Divide(Modulo((Local Player).winnerTime, 3600), 60), Down)), Char In String(Empty Array, False)), If-Then-Else(Compare((Local Player).winnerTime, !=, Null), Custom String("{0} 秒", Round To Integer(Modulo((Local Player).winnerTime, 60), Down)), Custom String("0 秒"))), Char In String(Empty Array, False)), If-Then-Else((Local Player).isWinner, Custom String("\n{0}", Global.masteryRunCode), Char In String(Empty Array, False))))))), Null, Left, 7, Null, Custom Color(160, 169, 186, 255), Null, Visible To and String, Visible Never);
        Create HUD Text(Local Player, Null, Custom String("└───────────┘"), Null, Left, 8, Null, Custom Color(160, 169, 186, 255), Null, Visible To and String, Visible Never);
        Create HUD Text(All Players(All Teams), Null, Custom String("［随机事件 5.0］"), Null, Right, -5, Null, Value In Array(Global.difficultyText, True), Null, Visible To String and Color, Default Visibility);
        Create HUD Text(If-Then-Else(Compare((Local Player).eventId, ==, -1), Null, Local Player), Custom String("{0}", If-Then-Else(Compare((Local Player).eventType, ==, 1), Ability Icon String(Hero(Sombra), Button(Ultimate)), Ability Icon String(Hero(Zenyatta), Button(Ability 1)))), Custom String("{0}（{1}）\n{2}", (Local Player).eventName, If-Then-Else(Compare((Local Player).eventDuration, >, Null), Custom String("{0} 秒", (Local Player).eventDurationHud), Custom String("一次性")), (Local Player).eventDesc), Null, Left, 70, Color(White), Color(White), Null, Visible To and String, Default Visibility);
        Create HUD Text(If-Then-Else(And(Compare(Global.difficulty, !=, 5), Compare((Local Player).progressionDeathCount, ==, Global.maxDeath)), Local Player, Null), Null, Custom String("[秘籍] 使用终极技能跳过（{0}） ", Input Binding String(Button(Ultimate))), Null, Left, 5, Null, Color(Blue), Null, Visible To and String, Default Visibility);
        Wait(0.5, Ignore Condition);
        Create Effect(All Players(Team 1), Ring, Color(Team 1), Global.endPosition, 4, Visible To);
        Create Effect(All Players(Team 1), Light Shaft, Color(Team 1), Global.endPosition, 4, Visible To);
        Create Icon(If-Then-Else(Compare(Global.controlJumpPosition, ==, Null), All Players(Team 1), Filtered Array(All Players(Team 1), Compare((Current Array Element).controlJumpIndex, ==, Subtract(Evaluate Once(Count Of(Global.controlRespawnPosition)), True)))), Add(Global.endPosition, Multiply(5, Up)), Flag, Visible To and Position, Color(Blue), True);
