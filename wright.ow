rule ("[Event/刹车失灵] Force forward throttle") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Is Alive(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 4)), Current Array Element) == True;
    }
    actions {
        Start Throttle In Direction(Event Player, Forward, 1, To Player, Replace existing throttle, None);
        Wait((Event Player).eventDuration, Ignore Condition);
        Stop Throttle In Direction(Event Player);
        Set Player Variable(Event Player, hudText, Char In String(Empty Array, False));
    }
}

rule ("[Event/刹车失灵] Stack speed") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Is Alive(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 4)), Current Array Element) == True;
    }
    actions {
        While(Compare((Event Player).mod_speed_event, <, 75));
            Modify Player Variable(Event Player, mod_speed_event, Add, 5);
            Skip If(Compare((Event Player).mod_dmg_taken, ==, -50), True);
            Modify Player Variable(Event Player, mod_dmg_taken, Subtract, 5);
            Set Player Variable(Event Player, hudText, Custom String("移速+{0}% / 伤害减免 {1}%", (Event Player).mod_speed_event, Multiply((Event Player).mod_dmg_taken, -1)));
            Call Subroutine(updatePlayerStats);
            Wait(True, Ignore Condition);
        End;
    }
}

rule ("[VishkarEvent]: 赌徒：短期投资 (交易)") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 8), Is Button Held(Event Player, Button(Reload))), Current Array Element) == True;
    }
    actions {
        Wait(True, Abort When False);
        If(Compare(Random Integer(False, 99), <, 75));
            Modify Player Variable At Index(Event Player, heart_steel, False, Add, Multiply(4, Value In Array((Event Player).heart_steel, True)));
            Modify Player Variable At Index(Event Player, dlcTimeChallenge, 3, Add, True);
            Small Message(Event Player, Custom String("  {0}  赢！获得 {1} 层心之钢（{2}% 最大生命值）", Icon String(Club), Multiply(4, Value In Array((Event Player).heart_steel, True)), Multiply(Multiply(4, Value In Array((Event Player).heart_steel, True)), Value In Array((Event Player).heart_steel, 2))));
            Call Subroutine(setPlayerHP);
        Else;
            Small Message(Event Player, Custom String("  {0}  输！祝你好运", Icon String(Diamond)));
        End;
        Set Player Variable(Event Player, eventForceRoll, 50);
        Set Player Variable(Event Player, eventForceCount, 2);
        Small Message(Event Player, Custom String("  {0}  合约已生效：未来 3 个事件为 减益", Icon String(Diamond)));
        Call Subroutine(clearPlayerEvent);
    }
}

rule ("[VishkarEvent]: 屁动力") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 5), Is Button Held(Event Player, Button(Jump))), Current Array Element) == True;
    }
    actions {
        Skip If(Compare((Event Player).mod_dmg_taken, !=, Null), 2);
        Set Player Variable(Event Player, mod_dmg_taken, -25);
        Call Subroutine(updatePlayerStats);
        Apply Impulse(Event Player, Facing Direction Of(Event Player), 15, To World, Cancel Contrary Motion);
        Wait(False, Ignore Condition);
        Loop If Condition Is True;
        Set Player Variable(Event Player, mod_dmg_taken, Null);
        Call Subroutine(updatePlayerStats);
    }
}

rule ("[VishkarEvent]: 屁动力 eff") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 8), Compare((Event Player).nanoEffect, ==, Null)), Current Array Element) == True;
    }
    actions {
        Create Effect(If-Then-Else(Is Button Held(Event Player, Button(Jump)), All Players(All Teams), Null), Ana Nano Boosted Effect, Color(Team 2), Event Player, 200, Visible To Position and Radius);
        Set Player Variable(Event Player, nanoEffect, Last Created Entity);
        Wait((Event Player).eventDuration, Ignore Condition);
        Destroy Effect((Event Player).nanoEffect);
        Set Player Variable(Event Player, nanoEffect, Null);
    }
}

rule ("[VishkarEvent]: 赌徒：竞速挑战") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 6), Is Button Held(Event Player, Button(Reload))), Current Array Element) == True;
    }
    actions {
        Wait(True, Abort When False);
        If(Compare(First Of((Event Player).heart_steel), <=, Null));
            Small Message(Event Player, Custom String("  {0}  心之钢层数不足", Icon String(Diamond)));
        Else;
            Modify Player Variable At Index(Event Player, heart_steel, False, Subtract, 4);
            Set Player Variable(Event Player, temp, Random Real(0, 100));
            If(Compare((Event Player).temp, <=, 49));
                Modify Player Variable(Event Player, mod_speed_perma, Add, 5);
                Small Message(Event Player, Custom String("  {0}  赢！永久获得 5% 移动速度加成", Icon String(Club)));
            Else If(Compare((Event Player).temp, <=, 98));
                Modify Player Variable(Event Player, mod_speed_perma, Subtract, 5);
                Small Message(Event Player, Custom String("  {0}  输！永久失去 5% 移动速度加成", Icon String(Diamond)));
            Else If(Compare((Event Player).temp, <=, 99));
                Modify Player Variable(Event Player, mod_speed_perma, Add, 12);
                Small Message(Event Player, Custom String("  {0}  赢！永久获得 12% 移动速度加成", Icon String(Club)));
            Else;
                Modify Player Variable(Event Player, mod_speed_perma, Subtract, 12);
                Small Message(Event Player, Custom String("  {0}  输！永久失去 12% 移动速度加成", Icon String(Diamond)));
            End;
        End;
        Wait(False, Ignore Condition);
        Call Subroutine(updatePlayerStats);
        Set Player Variable(Event Player, eventDuration, Null);
    }
}

rule ("[VishkarEvent]: 作弊：我要验牌 (触发)") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 7), Is Button Held(Event Player, Button(Reload))), Current Array Element) == True;
    }
    actions {
        Wait(True, Abort When False);
        Modify Player Variable At Index(Event Player, heart_steel, False, Subtract, 2);
        Call Subroutine(setPlayerHP);
        Play Effect(All Players(All Teams), Bad Pickup Effect, Color(Team 1), Event Player, 100);
        Set Player Variable(Event Player, eventForceRoll, 20);
        Small Message(Event Player, Custom String("  {0}  已扣除 2 层心之钢（{1}% 最大生命值）", Ability Icon String(Hero(Mauga), Button(Ability 2)), Multiply(2, Value In Array((Event Player).heart_steel, 2))));
        Wait(0.2, Ignore Condition);
        Small Message(Event Player, Custom String("  {0}  下一个事件必然是增益，祝你好运", Icon String(Club)));
        Set Player Variable(Event Player, eventDuration, Null);
    }
}

rule ("[VishkarEvent]: 作弊：跳过 (更换英雄)") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Hero Of(Event Player) != Hero(Bastion);
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 9), Is Button Held(Event Player, Button(Reload)), Compare(Hero Of(Event Player), ==, Value In Array(Global.heroList, (Event Player).heroNumber))), Current Array Element) == True;
    }
    actions {
        Wait(True, Abort When False);
        Set Player Variable(Event Player, controlCenterIndex, (Event Player).controlJumpIndex);
        Respawn(Event Player);
        Call Subroutine(progressHero);
        Wait(0.032, Ignore Condition);
        If(Compare(Global.controlRespawnPosition, !=, Null));
            If(Or(Compare((Event Player).controlCenterIndex, >=, Count Of(Global.controlRespawnPosition)), Compare(Value In Array(Global.controlRespawnPosition, (Event Player).controlCenterIndex), ==, Null)));
                Set Player Variable(Event Player, controlJumpIndex, Null);
            Else;
                Set Player Variable(Event Player, controlJumpIndex, (Event Player).controlCenterIndex);
            End;
            Teleport(Event Player, Value In Array(Global.controlRespawnPosition, (Event Player).controlJumpIndex));
            If(And(Compare(Global.controlJumpPosition, !=, Null), Compare(Value In Array(Global.controlJumpPosition, (Event Player).controlJumpIndex), !=, Null)));
                Set Facing(Event Player, Direction Towards(Eye Position(Event Player), Position Of(Value In Array(Global.controlJumpPosition, (Event Player).controlJumpIndex))), To World);
            End;
        End;
        Set Player Variable(Event Player, eventDuration, Null);
        Call Subroutine(clearPlayerEvent);
    }
}

rule ("[VishkarEvent]: 俄罗斯套娃 (变小复活)") {
    event {
        Player Died;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 10)), Current Array Element) == True;
    }
    actions {
        Disable Built-In Game Mode Respawning(Event Player);
        Wait(2, Ignore Condition);
        Enable Built-In Game Mode Respawning(Event Player);
        Resurrect(Event Player);
        Modify Player Variable(Event Player, eventSize, Add, True);
        Start Scaling Player(Event Player, Max(0.2, Subtract(True, Multiply(0.08, (Event Player).eventSize))), False);
        Start Modifying Hero Voice Lines(Event Player, Max(1.8, Add(True, Multiply(0.05, (Event Player).eventSize))), False);
        Modify Player Variable(Event Player, mod_speed_event, Add, 5);
        Call Subroutine(updatePlayerStats);
    }
}

rule ("[VishkarEvent]: 赌徒：长期投资 (豪赌)") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 11), Is Button Held(Event Player, Button(Reload))), Current Array Element) == True;
    }
    actions {
        Wait(True, Abort When False);
        If(Compare(Random Integer(False, 99), <, 33));
            Modify Player Variable At Index(Event Player, heart_steel, False, Add, Multiply(24, Value In Array((Event Player).heart_steel, True)));
            Modify Player Variable At Index(Event Player, dlcTimeChallenge, 4, Add, True);
            Small Message(Event Player, Custom String("  {0}  赢！获得 {1} 层心之钢（{2}% 最大生命值）", Icon String(Club), Multiply(24, Value In Array((Event Player).heart_steel, True)), Multiply(Multiply(24, Value In Array((Event Player).heart_steel, True)), Value In Array((Event Player).heart_steel, 2))));
            Call Subroutine(setPlayerHP);
        Else;
            Small Message(Event Player, Custom String("  {0}  输！祝你好运", Icon String(Diamond)));
        End;
        Set Player Variable(Event Player, eventForceRoll, 50);
        Set Player Variable(Event Player, eventForceCount, 4);
        Small Message(Event Player, Custom String("  {0}  合约已生效：未来 5 个事件为 减益", Icon String(Diamond)));
        Call Subroutine(clearPlayerEvent);
    }
}

rule ("[VishkarEvent]: 瓦尔基里降临") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 12)), Current Array Element) == True;
    }
    actions {
        Set Player Variable(Event Player, sizeHealth, 10);
        Call Subroutine(setPlayerHP);
        Set Player Variable(Event Player, heal_recv, -1000);
        Set Player Variable(Event Player, mod_heal_event, -1000);
        Call Subroutine(updatePlayerStats);
        Set Player Variable(Event Player, eventMission, Max Health(Event Player));
        Wait((Event Player).eventDuration, Ignore Condition);
        Set Player Variable(Event Player, sizeHealth, 1);
        Call Subroutine(setPlayerHP);
        Set Player Variable(Event Player, heal_recv, Null);
        Set Player Variable(Event Player, mod_heal_event, Null);
        Call Subroutine(updatePlayerStats);
    }
}

rule ("[VishkarEvent]: 瓦尔基里降临 大招充能") {
    event {
        Player Took Damage;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Is Alive(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 12)), Current Array Element) == True;
        Attacker != Event Player;
        Ultimate Charge Percent(Event Player) < 100;
    }
    actions {
        Set Ultimate Charge(Event Player, Add(Ultimate Charge Percent(Event Player), 10));
        Wait(0.5, Ignore Condition);
    }
}

rule ("[VishkarEvent]: 瓦尔基里降临 (大招持续回血)") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Is Alive(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 12), Is Using Ultimate(Event Player)), Current Array Element) == True;
    }
    actions {
        If(Compare((Event Player).eventTargetHP, ==, Null));
            Set Player Variable(Event Player, eventTargetHP, Max Health(Event Player));
        End;
        Set Player Variable(Event Player, eventTargetHP, Add(Health(Event Player), Multiply(Subtract((Event Player).eventTargetHP, Health(Event Player)), 0.85)));
        While(Is True For All(Array(Is Using Ultimate(Event Player), Compare(Health(Event Player), <, (Event Player).eventTargetHP)), Current Array Element));
            Set Player Health(Event Player, Min((Event Player).eventTargetHP, Add(Health(Event Player), Divide(Multiply(Max Health(Event Player), 4), 100))));
            Play Effect(All Players(All Teams), Heal Target Active Effect, Color(Yellow), Event Player, 60);
            Wait(0.2, Ignore Condition);
        End;
    }
}

rule ("[VishkarEvent]: 三位一体 (SSR)") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 13)), Current Array Element) == True;
    }
    actions {
        If(Is Alive(Event Player));
            Set Player Variable(Event Player, mod_dmg_taken, Multiply(Min(85, Divide(Max Health(Event Player), 25)), -1));
            Set Player Variable(Event Player, mod_speed_event, Multiply((Event Player).mod_dmg_taken, -2.5));
            Call Subroutine(updatePlayerStats);
            Modify Player Variable At Index(Event Player, heart_steel, False, Add, Multiply(1, Value In Array((Event Player).heart_steel, True)));
            Call Subroutine(setPlayerHP);
            Set Player Variable(Event Player, hudText, Custom String("伤害减免：{0}% / 移速加成：{1}% / 心之钢：{2}层", Multiply((Event Player).mod_dmg_taken, -1), (Event Player).mod_speed_event, Round To Integer(First Of((Event Player).heart_steel), Nearest)));
        End;
        Wait(4, Ignore Condition);
        Loop If Condition Is True;
        Set Player Variable(Event Player, mod_dmg_taken, Null);
        Set Player Variable(Event Player, mod_speed_event, Null);
        Set Player Variable(Event Player, hudText, Char In String(Empty Array, False));
        Call Subroutine(updatePlayerStats);
    }
}

rule ("[VishkarEvent]: 赌徒：掷骰狂人") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 14), Is Button Held(Event Player, Button(Reload))), Current Array Element) == True;
    }
    actions {
        Wait(True, Abort When False);
        Set Player Variable(Event Player, temp, Random Integer(True, 6));
        If(Compare((Event Player).temp, ==, 1));
            Modify Player Variable At Index(Event Player, heart_steel, False, Subtract, 5);
            Modify Global Variable(gamblerHeartsteelJackpot, Add, 5);
            Call Subroutine(setPlayerHP);
            Small Message(Event Player, Custom String("  1点：永久损失 5 层心之钢（{0}%）", Multiply(5, Value In Array((Event Player).heart_steel, 2))));
            Play Effect(All Players(All Teams), Echo Sticky Bomb Explosion Effect, Color(Team 2), Event Player, 200);
            Play Effect(Event Player, Debuff Impact Sound, Color(Team 2), Event Player, 200);
        Else If(Compare((Event Player).temp, ==, 2));
            Modify Player Variable(Event Player, mod_speed_perma, Subtract, 2);
            Small Message(Event Player, Custom String("  2点：永久损失 2% 移速加成"));
            Play Effect(All Players(All Teams), Echo Sticky Bomb Explosion Effect, Color(Team 2), Event Player, 200);
            Play Effect(Event Player, Debuff Impact Sound, Color(Team 2), Event Player, 200);
        Else If(Compare((Event Player).temp, ==, 3));
            Modify Player Variable(Event Player, mod_speed_perma, Add, 2);
            Small Message(Event Player, Custom String("  4点：永久获得 2% 移速加成"));
            Play Effect(All Players(All Teams), Echo Sticky Bomb Explosion Effect, Color(Team 1), Event Player, 200);
            Play Effect(Event Player, Buff Explosion Sound, Color(Team 2), Event Player, 200);
        Else If(Compare((Event Player).temp, ==, 4));
            Modify Player Variable(Event Player, mod_dmg_perma, Add, 2);
            Modify Player Variable(Event Player, mod_heal_perma, Subtract, 2);
            Small Message(Event Player, Custom String("  3点：永久损失 2% 伤害减免与治疗强度"));
            Play Effect(All Players(All Teams), Echo Sticky Bomb Explosion Effect, Color(Team 2), Event Player, 200);
            Play Effect(Event Player, Debuff Impact Sound, Color(Team 2), Event Player, 200);
        Else If(Compare((Event Player).temp, ==, 5));
            Modify Player Variable At Index(Event Player, heart_steel, False, Add, Multiply(5, Value In Array((Event Player).heart_steel, True)));
            Call Subroutine(setPlayerHP);
            Small Message(Event Player, Custom String("  5点：永久获得 {0} 层心之钢（+{1}%）", Multiply(5, Value In Array((Event Player).heart_steel, True)), Multiply(Multiply(5, Value In Array((Event Player).heart_steel, True)), Value In Array((Event Player).heart_steel, 2))));
            Play Effect(All Players(All Teams), Echo Sticky Bomb Explosion Effect, Color(Team 1), Event Player, 200);
            Play Effect(Event Player, Buff Explosion Sound, Color(Team 2), Event Player, 200);
        Else;
            Modify Player Variable(Event Player, mod_dmg_perma, Subtract, 2);
            Modify Player Variable(Event Player, mod_heal_perma, Add, 2);
            Small Message(Event Player, Custom String("  6点：永久获得 2% 伤害减免与治疗强度"));
            Play Effect(All Players(All Teams), Echo Sticky Bomb Explosion Effect, Color(Team 1), Event Player, 200);
            Play Effect(Event Player, Buff Explosion Sound, Color(Team 2), Event Player, 200);
        End;
        Call Subroutine(updatePlayerStats);
        Wait(1.5, Abort When False);
    }
}

rule ("[VishkarEvent]: 赌徒：心之钢") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 15), Is Button Held(Event Player, Button(Reload))), Current Array Element) == True;
    }
    actions {
        Wait(True, Abort When False);
        If(Compare(Random Integer(False, 99), <, 40));
            If(Compare(First Of((Event Player).heart_steel), >, Null));
                Modify Player Variable At Index(Event Player, heart_steel, False, Multiply, 1.5);
            End;
            Small Message(Event Player, Custom String("  {0}  赢！心之钢层数变为 1.50 倍", Icon String(Club)));
        Else If(Compare(First Of((Event Player).heart_steel), >, Null));
            Small Message(Event Player, Custom String("  {0}  输！失去 {1} 层心之钢层数（{2}%）", Icon String(Diamond), First Of((Event Player).heart_steel), Multiply(First Of((Event Player).heart_steel), Value In Array((Event Player).heart_steel, 2))));
            Set Player Variable(Event Player, temp, Divide(Add(First Of((Event Player).heart_steel), True), 2));
            Modify Player Variable At Index(Event Player, heart_steel, False, Subtract, (Event Player).temp);
            Modify Global Variable(gamblerHeartsteelJackpot, Add, (Event Player).temp);
        Else;
            Small Message(Event Player, Custom String("  {0}  输！失去 25 层心之钢层数（{1}%）", Icon String(Diamond), Multiply(25, Value In Array((Event Player).heart_steel, 2))));
            Modify Player Variable At Index(Event Player, heart_steel, False, Subtract, 25);
            Modify Global Variable(gamblerHeartsteelJackpot, Add, 25);
        End;
        Wait(False, Ignore Condition);
        Call Subroutine(setPlayerHP);
        Wait(False, Ignore Condition);
        Set Player Variable(Event Player, eventDuration, Null);
    }
}

rule ("[VishkarEvent]: 赌徒：梭哈艺术 (下 注)") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 16), Compare((Event Player).eventDuration, >, Null), Compare((Event Player).eventMissionGoal, <, 4), Compare((Event Player).altFormActive, !=, True), Is Button Held(Event Player, Button(Reload))), Current Array Element) == True;
    }
    actions {
        Set Player Variable(Event Player, altFormActive, True);
        If(Compare(First Of((Event Player).heart_steel), <=, Null));
            Small Message(Event Player, Custom String("  {0}  心之钢层数不足", Icon String(Diamond)));
        Else;
            Modify Player Variable(Event Player, eventMission, Add, Multiply(First Of((Event Player).heart_steel), 0.25));
            Modify Player Variable(Event Player, eventMissionGoal, Add, True);
            Set Player Variable(Event Player, hudText, Custom String("已 下 注：{0}层（{1}%）", (Event Player).eventMission, Multiply((Event Player).eventMissionGoal, 25)));
            Small Message(Event Player, Custom String("  {0}  已 下 注 {1} 层", Icon String(Club), Max(True, Round To Integer(Multiply(First Of((Event Player).heart_steel), 0.25), Down))));
        End;
        Wait Until(Is True For Any(Array(Not(Is Button Held(Event Player, Button(Reload))), Compare((Event Player).eventType, !=, 2), Compare((Event Player).eventId, !=, 16), Compare((Event Player).eventDuration, <=, Null)), Current Array Element), (Event Player).eventDuration);
        Set Player Variable(Event Player, altFormActive, False);
    }
}

rule ("[VishkarEvent]: 赌徒：梭哈艺术 (结算)") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 16)), Current Array Element) == True;
    }
    actions {
        Wait Until(False, Subtract((Event Player).eventDuration, True));
        Skip If(Compare((Event Player).eventMission, <=, Null), 10);
        If(Compare(Random Integer(False, 99), <, 8));
            Modify Player Variable At Index(Event Player, heart_steel, False, Add, Multiply(Multiply((Event Player).eventMission, 5), Value In Array((Event Player).heart_steel, True)));
            Small Message(Event Player, Custom String("  {0}  赢！获得 {1} 层心之钢（{2}%）", Icon String(Club), Multiply(Multiply((Event Player).eventMission, 5), Value In Array((Event Player).heart_steel, True)), Multiply(Multiply(Multiply((Event Player).eventMission, 5), Value In Array((Event Player).heart_steel, True)), Value In Array((Event Player).heart_steel, 2))));
        Else;
            Modify Player Variable At Index(Event Player, heart_steel, False, Subtract, (Event Player).eventMission);
            Modify Global Variable(gamblerHeartsteelJackpot, Add, (Event Player).eventMission);
            Small Message(Event Player, Custom String("  {0}  输！失去 {1} 层心之钢（{2}%）", Icon String(Diamond), (Event Player).eventMission, Multiply((Event Player).eventMission, Value In Array((Event Player).heart_steel, 2))));
        End;
        Wait(False, Ignore Condition);
        Call Subroutine(setPlayerHP);
        Wait(True, Ignore Condition);
        Set Player Variable(Event Player, eventMission, Null);
        Set Player Variable(Event Player, eventMissionGoal, Null);
        Set Player Variable(Event Player, hudText, Char In String(Empty Array, False));
        Set Player Variable(Event Player, eventDuration, Null);
    }
}

rule ("[VishkarEvent]: 吸血鬼") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Is Alive(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 17)), Current Array Element) == True;
    }
    actions {
        Set Player Variable(Event Player, passiveRegenBlocked, True);
        Set Player Variable(Event Player, target, Remove From Array(All Living Players(Team 1), Event Player));
        If(Compare(Count Of((Event Player).target), >, Null));
            Set Player Variable(Event Player, eventMissionGoal, Add(10, Divide(Multiply(Max Health(Event Player), 2), 100)));
            Damage((Event Player).target, Event Player, (Event Player).eventMissionGoal);
            Heal(Event Player, Event Player, Multiply(Count Of((Event Player).target), (Event Player).eventMissionGoal));
            Modify Player Variable At Index(Event Player, dlcTimeChallenge, False, Add, Multiply(Count Of((Event Player).target), (Event Player).eventMissionGoal));
            Play Effect(All Players(All Teams), Moira Fade Reappear Effect, Color(Red), (Event Player).target, 200);
        End;
        Wait(True, Ignore Condition);
        Loop If Condition Is True;
        Set Player Variable(Event Player, target, Null);
        Set Player Variable(Event Player, eventMissionGoal, Null);
        Set Player Variable(Event Player, passiveRegenBlocked, False);
        Call Subroutine(startCombatRegen);
    }
}

rule ("[VishkarEvent]: 吸血鬼击杀增益") {
    event {
        Player Died;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Compare(Team Of(Attacker), ==, Team 1), Compare(Attacker, !=, Event Player), Has Spawned(Attacker), Compare((Attacker).eventType, ==, 2), Compare((Attacker).eventId, ==, 17)), Current Array Element) == True;
    }
    actions {
        Modify Player Variable(Attacker, mod_heal_perma, Add, 2.5);
        Set Healing Dealt(Attacker, Add(Add(100, (Attacker).mod_heal_perma), (Attacker).mod_heal_event));
    }
}

rule ("[VishkarEvent]: 窃贼") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 18), Is Button Held(Event Player, Button(Reload))), Current Array Element) == True;
    }
    actions {
        Wait(True, Abort When False);
        Wait(0.25, Ignore Condition);
        If(Compare(Count Of(Remove From Array(All Players(Team 1), Event Player)), ==, Null));
            Small Message(Event Player, Custom String("  {0}  没有可窃取的友方目标", Icon String(Warning)));
            Set Player Variable(Event Player, eventDuration, Null);
            Call Subroutine(clearPlayerEvent);
        Else;
            Set Player Variable(Event Player, target, Random Value In Array(Remove From Array(All Players(Team 1), Event Player)));
            Set Player Variable(Event Player, eventForceRoll, 20);
            Set Player Variable(Event Player, eventForceCount, Null);
            Set Player Variable((Event Player).target, thiefBuffStolen, True);
            Modify Player Variable At Index(Event Player, dlcTimeChallenge, 8, Add, True);
            Small Message(Event Player, Custom String("  {0}  已窃取一名友方的下一个增益事件", Icon String(Diamond)));
            Small Message((Event Player).target, Custom String("  {0}  你的下一个增益事件已被窃取", Icon String(Warning)));
            Set Player Variable(Event Player, eventDuration, Null);
            Call Subroutine(clearPlayerEvent);
    }
}

rule ("[VishkarEvent]: 赌徒：乐于助人") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 19), Is Button Held(Event Player, Button(Reload))), Current Array Element) == True;
    }
    actions {
        Wait(True, Abort When False);
        Set Player Variable(Event Player, target, All Living Players(Team 1));
        If(Compare(Random Integer(True, 100), <=, 75));
            Set Player Variable(Event Player, temp, Null);
            For Player Variable(Event Player, temp, 0, Count Of((Event Player).target), True);
                Heal(Value In Array((Event Player).target, (Event Player).temp), Event Player, Divide(Multiply(Max Health(Value In Array((Event Player).target, (Event Player).temp)), 85), 100));
            End;
            Small Message((Event Player).target, Custom String("  {0}  赌赢了！恢复85%最大生命值", Icon String(Club)));
        Else;
            Set Player Health((Event Player).target, 1);
            Small Message((Event Player).target, Custom String("  {0}  赌输了！所有友方生命值降至 1", Icon String(Diamond)));
        End;
        Set Player Variable(Event Player, target, Null);
        Set Player Variable(Event Player, eventDuration, Null);
        Call Subroutine(clearPlayerEvent);
    }
}

rule ("[VishkarEvent]: 赌徒：赢家通吃") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 22), Is Button Held(Event Player, Button(Reload))), Current Array Element) == True;
    }
    actions {
        Set Player Variable(Event Player, hudText, Custom String("当前奖池：{0}层", Round To Integer(Global.gamblerHeartsteelJackpot, Nearest)));
        Wait(True, Abort When False);
        Set Player Variable(Event Player, eventMission, Max(True, Round To Integer(Multiply(First Of((Event Player).heart_steel), 0.25), Down)));
        Modify Player Variable At Index(Event Player, heart_steel, False, Subtract, (Event Player).eventMission);
        Modify Global Variable(gamblerHeartsteelJackpot, Add, (Event Player).eventMission);
        Set Player Variable(Event Player, hudText, Custom String("当前奖池：{0}层", Round To Integer(Global.gamblerHeartsteelJackpot, Nearest)));
        If(Compare(Random Integer(False, 99), <, 10));
            Set Player Variable(Event Player, temp, Global.gamblerHeartsteelJackpot);
            Modify Player Variable At Index(Event Player, heart_steel, False, Add, (Event Player).temp);
            Set Global Variable(gamblerHeartsteelJackpot, Null);
            Big Message(All Players(All Teams), Custom String("  {0}  {1} 清空奖池，获得 {2} 层心之钢", Icon String(Club), Event Player, (Event Player).temp));
        Else;
            Small Message(Event Player, Custom String("  {0}  {1} 层心之钢已进入奖池", Icon String(Diamond), (Event Player).eventMission));
        End;
        Wait(False, Ignore Condition);
        Call Subroutine(setPlayerHP);
        Wait(False, Ignore Condition);
        Set Player Variable(Event Player, hudText, Char In String(Empty Array, False));
        Set Player Variable(Event Player, eventMission, Null);
        Set Player Variable(Event Player, eventDuration, Null);
    }
}

rule ("[VishkarEvent]: 作弊：暗箱操作 (触发)") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 20), Is Button Held(Event Player, Button(Reload))), Current Array Element) == True;
    }
    actions {
        Wait(True, Abort When False);
        Modify Player Variable At Index(Event Player, heart_steel, False, Subtract, 4);
        Call Subroutine(setPlayerHP);
        Play Effect(All Players(All Teams), Bad Pickup Effect, Color(Team 1), Event Player, 100);
        Set Player Variable(Event Player, eventForceRoll, 80);
        Small Message(Event Player, Custom String("  {0}  已扣除 4 层心之钢（{1}% 最大生命值）", Ability Icon String(Hero(Mauga), Button(Ability 2)), Multiply(4, Value In Array((Event Player).heart_steel, 2))));
        Wait(0.2, Ignore Condition);
        Small Message(Event Player, Custom String("  {0}  下一个事件必然是机制，祝你好运", Icon String(Diamond)));
        Set Player Variable(Event Player, eventDuration, Null);
        Call Subroutine(clearPlayerEvent);
    }
}

rule ("[VishkarEvent]: 镜像反转") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 21), Compare((Event Player).eventMission, ==, Null), Is Button Held(Event Player, Button(Reload))), Current Array Element) == True;
    }
    actions {
        Wait(True, Abort When False);
        Set Player Variable(Event Player, temp, Empty Array);
        If(Compare((Event Player).mod_dmg_perma, <, Null));
            Modify Player Variable(Event Player, temp, Append To Array, Null);
        End;
        If(Compare((Event Player).mod_speed_perma, <, Null));
            Modify Player Variable(Event Player, temp, Append To Array, 1);
        End;
        If(Compare((Event Player).mod_heal_perma, <, Null));
            Modify Player Variable(Event Player, temp, Append To Array, 2);
        End;
        If(Compare(First Of((Event Player).heart_steel), <, Null));
            Modify Player Variable(Event Player, temp, Append To Array, 3);
        End;
        If(Compare(Count Of((Event Player).temp), >, Null));
            Set Player Variable(Event Player, temp, Random Value In Array((Event Player).temp));
            If(Compare((Event Player).temp, ==, Null));
                Modify Player Variable(Event Player, mod_dmg_perma, Multiply, -1);
            Else If(Compare((Event Player).temp, ==, 1));
                Modify Player Variable(Event Player, mod_speed_perma, Multiply, -1);
            Else If(Compare((Event Player).temp, ==, 2));
                Modify Player Variable(Event Player, mod_heal_perma, Multiply, -1);
            Else If(Compare((Event Player).temp, ==, 3));
                Modify Player Variable At Index(Event Player, heart_steel, False, Multiply, -1);
            End;
            Set Player Variable(Event Player, eventMission, 1);
            Call Subroutine(updatePlayerStats);
            Call Subroutine(setPlayerHP);
            Small Message(Event Player, Custom String("  {0}  永久反转已生效", Icon String(Checkmark)));
    }
}

