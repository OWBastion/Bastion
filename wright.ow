rule ("initialize phase hero arrays") {
    event {
        Ongoing - Global;
    }
    conditions {
        Global.vishkarEventActivated == True;
    }
    actions {
        Set Global Variable At Index(phaseHero, False, Array(Hero(D.Va), Hero(Reinhardt), Hero(Winston), Hero(Mauga), Hero(Hazard), Hero(Doomfist), Hero(Ashe), Hero(Pharah), Hero(Echo), Hero(Cassidy), Hero(Soldier: 76), Hero(Reaper), Hero(Sojourn), Hero(Venture), Hero(Genji), Hero(Tracer), Hero(Moira), Hero(Mercy), Hero(Kiriko), Hero(Illari), Hero(Juno), Hero(Wuyang), Hero(Freja), Hero(Anran), Hero(Jetpack Cat), Hero(Emre), Hero(Mizuki), Hero(Widowmaker), Hero(Sierra), Hero(Vendetta)));
        Set Global Variable At Index(phaseHero, True, Array(Hero(Orisa), Hero(Sombra), Hero(Tracer), Hero(Freja), Hero(Reaper), Hero(Vendetta)));
        Set Global Variable At Index(phaseHero, 2, Array(Hero(Doomfist), Hero(Tracer), Hero(Jetpack Cat)));
        Set Global Variable At Index(phaseHero, 3, Array(Hero(Hanzo)));
        Set Global Variable At Index(phaseHero, 4, Array(Hero(Zenyatta)));
    }
}

rule ("initialize hero list") {
    event {
        Ongoing - Global;
    }
    actions {
        Set Global Variable(heroList, Array(Hero(Sombra), Hero(Reaper), Hero(Moira), Hero(Kiriko), Hero(Sigma), Hero(Wuyang), Hero(Mizuki), Hero(Emre), Hero(Genji), Hero(Orisa), Hero(Winston), Hero(D.Va), Hero(Tracer), Hero(Widowmaker), Hero(Domina), Hero(Sojourn), Hero(Baptiste), Hero(Symmetra), Hero(Mei), Hero(Echo), Hero(Brigitte), Hero(Soldier: 76), Hero(Juno), Hero(Wrecking Ball), Hero(Cassidy), Hero(Zarya), Hero(Lúcio), Hero(Pharah), Hero(Jetpack Cat), Hero(Mercy), Hero(Reinhardt), Hero(Hanzo), Hero(Doomfist), Hero(Roadhog), Hero(Junker Queen), Hero(Ashe), Hero(D.Mon), Hero(Torbjörn), Hero(Ana), Hero(Zenyatta), Hero(Junkrat), Hero(Bastion)));
        Modify Global Variable(heroList, Remove From Array By Value, Filtered Array(Global.heroList, Not(Array Contains(All Heroes, Current Array Element))));
        If(Is True For Any(All Heroes, Not(Array Contains(Global.heroList, Current Array Element))));
            Set Global Variable(missingHeroes, Filtered Array(All Heroes, Not(Array Contains(Global.heroList, Current Array Element))));
            For Global Variable(I, 0, Count Of(Global.missingHeroes), True);
                Set Global Variable(heroList, Sorted Array(Append To Array(Global.heroList, Value In Array(Global.missingHeroes, Global.I)), If-Then-Else(Compare(Current Array Element, !=, Value In Array(Global.missingHeroes, Global.I)), Current Array Index, 0.5)));
                Wait(False, Ignore Condition);
            End;
        End;
        Set Global Variable(heroList, Sorted Array(Global.heroList, Add(Current Array Index, Multiply(Count Of(Global.heroList), Compare(Current Array Element, ==, Hero(Bastion))))));
    }
}

rule ("initialize title array") {
