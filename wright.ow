rule ("[VishkarEvent]: 限速40") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, 1), Compare((Event Player).eventId, ==, 4), Is Moving(Event Player), Compare(Speed Of(Event Player), !=, Null)), Current Array Element) == True;
    }
    actions {
        Set Player Variable(Event Player, passiveRegenBlocked, True);
        Wait(True, Abort When False);
        Skip If(Has Status(Event Player, Burning), True);
        Set Status(Event Player, Null, Burning, 3);
        Start Damage Over Time(Event Player, Null, 1, Add(25, Round To Integer(Divide(Multiply(Max Health(Event Player), 7.5), 100), Nearest)));
        Wait(0.032, Ignore Condition);
        Loop If Condition Is True;
        Clear Status(Event Player, Burning);
        Set Player Variable(Event Player, passiveRegenBlocked, False);
        Call Subroutine(startCombatRegen);
    }
}

