            Create Effect(All Players(Team 1), Light Shaft, Color(Yellow), First Of(Global.controlJumpPosition), 4, Visible To);
            Create Icon(Filtered Array(All Players(Team 1), Compare((Current Array Element).controlJumpIndex, ==, Null)), Add(First Of(Global.controlJumpPosition), Multiply(5, Up)), Flag, Visible To and Position, Color(Yellow), True);
            Skip If(Compare(Value In Array(Global.controlJumpPosition, True), ==, Null), 3);
            Create Effect(All Players(Team 1), Ring, Color(Green), Value In Array(Global.controlJumpPosition, True), 4, Visible To);
            Create Effect(All Players(Team 1), Light Shaft, Color(Green), Value In Array(Global.controlJumpPosition, True), 4, Visible To);
            Create Icon(Filtered Array(All Players(Team 1), Compare((Current Array Element).controlJumpIndex, ==, 1)), Add(Value In Array(Global.controlJumpPosition, True), Multiply(5, Up)), Flag, Visible To and Position, Color(Green), True);
        End;
