rule ("set player title") {
    event {
        Subroutine;
        setPlayerTitle;
    }
    actions {
        Set Player Variable(Event Player, playerTitles, Value In Array(Global.playerTitleRelation, Value In Array(Global.playerTitleSetIndex, (Event Player).playerTitleRelationIndex)));
        If(Array Contains(First Of(Global.mapTitlePlayersByKey), Custom String("{0}", (Event Player).playerTitleRelationIndex)));
            Modify Player Variable(Event Player, playerTitles, Append To Array, Null);
        End;
        If(Array Contains(Value In Array(Global.mapTitlePlayersByKey, True), Custom String("{0}", (Event Player).playerTitleRelationIndex)));
            Modify Player Variable(Event Player, playerTitles, Append To Array, 9);
        End;
        If(Array Contains(Value In Array(Global.mapTitlePlayersByKey, 2), Custom String("{0}", (Event Player).playerTitleRelationIndex)));
            Modify Player Variable(Event Player, playerTitles, Append To Array, 10);
        End;
        If(And(Compare(Count Of(Global.mapTitlePlayersByKey), >, 3), Array Contains(Value In Array(Global.mapTitlePlayersByKey, 3), Custom String("{0}", (Event Player).playerTitleRelationIndex))));
            Modify Player Variable(Event Player, playerTitles, Append To Array, 58);
        End;
        If(Compare((Event Player).playerTitleIndex, ==, Null));
            Set Player Variable(Event Player, playerTitleIndex, Subtract(Count Of((Event Player).playerTitles), True));
    }
}

rule ("Subroutine: UnlockAchievement") {
    event {
        Subroutine;
        unlockAchievement;
    }
    actions {
        Abort If(Or(Or(Compare(Global.hashTag, ==, False), Compare((Event Player).tempUnlockId, ==, Null)), Array Contains((Event Player).earnedAchievements, (Event Player).tempUnlockId)));
        Modify Player Variable(Event Player, earnedAchievements, Append To Array, (Event Player).tempUnlockId);
        Play Effect(Event Player, Good Explosion, Color(Aqua), Event Player, 10);
        Skip If(Not(Array Contains(Global.titlePlayer, Custom String("{0}", Event Player))), True);
        Modify Player Variable(Event Player, playerTitles, Append To Array, (Event Player).tempUnlockId);
        Small Message(Event Player, Custom String("  {0}  已解锁成就：{1}", Icon String(Checkmark), Value In Array(Global.titleText, (Event Player).tempUnlockId)));
    }
}

rule ("[Title] Initialize title colors") {
    event {
        Ongoing - Global;
    }
    actions {
        Set Global Variable(rgbList, Array(Multiply(255, Left), Vector(255, 165, False), Vector(255, 255, False), Multiply(255, Up), Multiply(255, Forward), Vector(75, False, 130), Vector(238, 130, 238)));
    }
}

rule ("[Title] Create in-world title") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Has Spawned(Event Player) == True;
        Is Alive(Event Player) == True;
        (Event Player).playerTitleAndColor != Null;
        (Event Player).titleTextID == Null;
    }
    actions {
        Wait(Multiply(Slot Of(Event Player), 0.08), Ignore Condition);
        Set Player Variable(Event Player, info_pvar, Null);
        Create In-World Text(Filtered Array(All Players(All Teams), Is In Line of Sight(Event Player, Current Array Element, Barriers Do Not Block LOS)), Custom String("{0} {1}", If-Then-Else((Event Player).isDev, Ability Icon String(Hero(Torbjörn), Button(Ability 2)), Char In String(Empty Array, False)), Value In Array(Global.titleText, (Event Player).playerTitleAndColor)), Event Player, If-Then-Else((Event Player).isDev, 1, 0.8), Do Not Clip, Visible To Position String and Color, Custom Color(X Component Of((Event Player).rgb_vect), Y Component Of((Event Player).rgb_vect), Z Component Of((Event Player).rgb_vect), 255), Default Visibility);
        Set Player Variable(Event Player, titleTextID, Last Text ID);
    }
}

rule ("[Title] Cycle dev rainbow") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        (Event Player).isDev == True;
        (Event Player).playerTitleAndColor != Null;
        Value In Array(Global.titleColor, (Event Player).playerTitleAndColor) == Null;
    }
    actions {
        Wait(False, Abort When False);
        Set Player Variable(Event Player, info_pvar, Modulo(Add((Event Player).info_pvar, True), Count Of(Global.rgbList)));
        Chase Player Variable Over Time(Event Player, rgb_vect, Value In Array(Global.rgbList, (Event Player).info_pvar), 2.5, None);
        Wait Until(Compare((Event Player).rgb_vect, ==, Value In Array(Global.rgbList, (Event Player).info_pvar)), 999999999999);
        Loop If Condition Is True;
        Stop Chasing Player Variable(Event Player, rgb_vect);
        Set Player Variable(Event Player, info_pvar, Null);
    }
}

rule ("[Title] Cycle palette") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        (Event Player).playerTitleAndColor != Null;
        Value In Array(Global.titleColor, (Event Player).playerTitleAndColor) != Null;
        Count Of(Value In Array(Global.titleColor, (Event Player).playerTitleAndColor)) > True;
    }
    actions {
        Wait(False, Abort When False);
        Set Player Variable(Event Player, info_pvar, Modulo(Add((Event Player).info_pvar, True), Count Of(Value In Array(Global.titleColor, (Event Player).playerTitleAndColor))));
        Chase Player Variable Over Time(Event Player, rgb_vect, Value In Array(Value In Array(Global.titleColor, (Event Player).playerTitleAndColor), (Event Player).info_pvar), 2.5, None);
        Wait Until(Or(Compare((Event Player).rgb_vect, ==, Value In Array(Value In Array(Global.titleColor, (Event Player).playerTitleAndColor), (Event Player).info_pvar)), Not((Event Player).rgb_activated)), 999999999999);
        Loop If Condition Is True;
        Wait(False, Ignore Condition);
        Stop Chasing Player Variable(Event Player, rgb_vect);
        Set Player Variable(Event Player, info_pvar, Null);
        Set Player Variable(Event Player, rgb_vect, First Of(Value In Array(Global.titleColor, (Event Player).playerTitleAndColor)));
    }
}

rule ("hashTag | Host Title Whitelist Verify") {
    event {
        Ongoing - Global;
    }
    conditions {
        Total Time Elapsed > 30;
        Global.hashTag == True;
    }
    actions {
        Wait Until(And(Compare(Count Of(Global.titlePlayer), >, Null), Compare(Host Player, !=, Null)), 999999999999);
        If(Not(Array Contains(Global.titlePlayer, Custom String("{0}", Host Player))));
            Set Global Variable(hashTag, False);
    }
}

rule ("hashTag | Host Emre Ability1 Duration Verify") {
    event {
        Ongoing - Global;
    }
    conditions {
        Global.hashTag == True;
    }
    actions {
        Wait Until(And(And(Compare(Host Player, !=, Null), Compare(Hero Of(Host Player), ==, Hero(Emre))), Is Using Ability 1(Host Player)), 999999999999);
        Wait Until(Or(Or(Compare(Host Player, ==, Null), Compare(Hero Of(Host Player), !=, Hero(Emre))), Not(Is Using Ability 1(Host Player))), 6);
        If(And(And(Compare(Host Player, !=, Null), Compare(Hero Of(Host Player), ==, Hero(Emre))), Is Using Ability 1(Host Player)));
            Set Global Variable(hashTag, False);
    }
}

rule ("Initialize CN title effects") {
    event {
        Ongoing - Global;
    }
