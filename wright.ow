rule ("[Bastion] Update aim point") {
    event {
        Ongoing - Each Player;
        Team 2;
        Bastion;
    }
    conditions {
        Is Dummy Bot(Event Player) == True;
        Is Alive(Event Player) == True;
        (Event Player).target != Null;
    }
    actions {
        Set Player Variable(Event Player, tempAimPosition, Divide(Add(Position Of((Event Player).target), Eye Position((Event Player).target)), 2));
        If(Is In Line of Sight(Eye Position(Event Player), (Event Player).tempAimPosition, Barriers Do Not Block LOS));
            Set Player Variable(Event Player, aimPosition, (Event Player).tempAimPosition);
        Else If(Is In Line of Sight(Eye Position(Event Player), Eye Position((Event Player).target), Barriers Do Not Block LOS));
            Set Player Variable(Event Player, aimPosition, Eye Position((Event Player).target));
        Else;
            Set Player Variable(Event Player, aimPosition, Position Of((Event Player).target));
        End;
        Wait(0.064, Ignore Condition);
        Loop If Condition Is True;
    }
}

rule ("[Bastion] Pre-aim nearest target") {
    event {
        Ongoing - Each Player;
        Team 2;
        Bastion;
    }
    conditions {
        Is Dummy Bot(Event Player) == True;
        Is Alive(Event Player) == True;
        (Event Player).target == False;
    }
    actions {
        Wait(True, Abort When False);
        Set Player Variable(Event Player, nearestTargetOutOfLoS, First Of(Sorted Array(Filtered Array(All Living Players(Team 1), And(Has Spawned(Current Array Element), Not((Event Player).isWinner))), Distance Between(Eye Position(Event Player), Eye Position(Current Array Element)))));
        Skip If(Compare((Event Player).nearestTargetOutOfLoS, ==, Null), True);
        Set Player Variable(Event Player, aimPosition, Add(Eye Position((Event Player).nearestTargetOutOfLoS), Vector(Random Real(-1, 1), Random Real(-1, 1), Random Real(-1, 1))));
        Wait(Random Real(1, 4), Ignore Condition);
        Loop If Condition Is True;
    }
}

rule ("[Bastion] Update turn speed") {
    event {
        Ongoing - Each Player;
        Team 2;
        Bastion;
    }
    conditions {
        Is Dummy Bot(Event Player) == True;
        Is Alive(Event Player) == True;
        (Event Player).target != False;
    }
