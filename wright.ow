rule ("[VishkarEvent]: 任务：钢化你心 (记录基准)") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, Null), Compare((Event Player).eventId, ==, 23), Compare((Event Player).eventMissionGoal, ==, Null)), Current Array Element) == True;
    }
    actions {
        If(Compare(First Of((Event Player).playerOnceEventState), !=, 2));
            Set Player Variable At Index(Event Player, playerOnceEventState, False, 1);
        End;
        Set Player Variable(Event Player, eventMission, (Event Player).heroNumber);
        Set Player Variable(Event Player, eventMissionGoal, If-Then-Else(And(Compare(Global.controlJumpPosition, !=, Null), Compare(Global.portalPosition, ==, Null)), 2, 3));
    }
}

rule ("[VishkarEvent]: 任务：钢化你心 (结束判定)") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, Null), Compare((Event Player).eventId, ==, 23), Compare((Event Player).eventMissionGoal, >, Null)), Current Array Element) == True;
    }
    actions {
        Wait Until(Or(Compare(Subtract((Event Player).heroNumber, (Event Player).eventMission), >=, (Event Player).eventMissionGoal), Compare((Event Player).isWinner, ==, True)), (Event Player).eventDuration);
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        If(Or(Compare(Subtract((Event Player).heroNumber, (Event Player).eventMission), >=, (Event Player).eventMissionGoal), (Event Player).isWinner));
            Big Message(Event Player, Custom String("任务：钢化你心 成功！"));
            Small Message(Event Player, Custom String("  {0}  后续心之钢层数获取×1.50，每层生命值永久提升至 1%", Ability Icon String(Hero(Mauga), Button(Ability 2))));
            Set Player Variable At Index(Event Player, heart_steel, True, 1.5);
            Set Player Variable At Index(Event Player, heart_steel, 2, 1);
            Set Player Variable At Index(Event Player, playerOnceEventState, False, 2);
            Call Subroutine(setPlayerHP);
            Set Player Variable(Event Player, eventDuration, Null);
        Else;
            Big Message(Event Player, Custom String("任务：钢化你心 失败"));
    }
}

rule ("[VishkarEvent]: 战地医生 (记录基准)") {
