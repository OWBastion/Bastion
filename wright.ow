rule ("[Event/引力异常] Pull toward bastion") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Is Alive(Event Player), Compare((Event Player).eventType, ==, 1), Compare((Event Player).eventId, ==, 5)), Current Array Element) == True;
        First Of(All Players(Team 2)) != Null;
    }
    actions {
        Skip If(Compare((Event Player).mod_speed_event, !=, Null), 2);
        Modify Player Variable(Event Player, mod_speed_event, Subtract, 50);
        Call Subroutine(updatePlayerStats);
        Set Player Variable(Event Player, temp, All Players(Team 2));
        If(Compare(Value In Array((Event Player).temp, True), ==, Null));
            Set Player Variable(Event Player, target, First Of((Event Player).temp));
        Else;
            Set Player Variable(Event Player, target, First Of(Sorted Array((Event Player).temp, Distance Between(Event Player, Current Array Element))));
        End;
        Apply Impulse(Event Player, Direction Towards(Event Player, (Event Player).target), If-Then-Else(Is In Air(Event Player), 0.6, 0.85), To World, Incorporate Contrary Motion);
        Wait(False, Ignore Condition);
        Loop If Condition Is True;
        Set Player Variable(Event Player, mod_speed_event, Null);
        Call Subroutine(updatePlayerStats);
    }
}

