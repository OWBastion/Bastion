rule ("OverPy Map Detection") {
    event {
        Ongoing - Global;
    }
    actions {
        If(Array Contains(Array(Map(Ayutthaya), Map(Black Forest), Map(Blizzard World), Map(Busan), Map(Castillo), Map(Château Guillard), Map(Aatlis), Map(Circuit Royal), Map(Colosseo), Map(Dorado), Map(Ecopoint: Antarctica), Map(Eichenwalde), Map(Eichenwalde), Map(Esperança), Map(Throne of Anubis), Map(Hanamura), Map(Havana), Map(Hollywood), Map(Hollywood), Map(Horizon Lunar Colony), Map(Ilios), Map(Suravasa), Map(Junkertown), Map(New Junk City), Map(King's Row), Map(Lijiang Control Center), Map(Lijiang Garden), Map(Lijiang Night Market), Map(Lijiang Tower), Map(Malevento), Map(Midtown), Map(Necropolis), Map(Nepal), Map(Nepal), Map(Nepal), Map(Nepal), Map(Nepal), Map(New Queen Street), Map(Numbani), Map(Oasis), Map(Paraíso), Map(Paris), Map(Petra), Map(Practice Range), Map(Rialto), Map(Route 66), Map(Temple of Anubis), Map(Volskaya Industries), Map(Watchpoint: Gibraltar), Map(Neon Junction), Map(Workshop Expanse), Map(Workshop Green Screen), Map(Workshop Island), Map(Shambali Monastery)), First Of(Filtered Array(Array(Map(Colosseo), Map(Esperança), Map(Samoa), Map(Throne of Anubis), Current Map), Compare(Custom String("{0}", Current Map), ==, String Split(Current Array Element, Empty Array))))));
            Set Global Variable(__currentMap___, First Of(Filtered Array(Array(Map(Colosseo), Map(Esperança), Map(Samoa), Map(Throne of Anubis), Current Map), Compare(Custom String("{0}", Current Map), ==, String Split(Current Array Element, Empty Array)))));
            Abort;
        End;
        Set Global Variable(__currentMap___, Ray Cast Hit Position(Vector(500, 100, 500), Vector(-500, -100, -500), Null, Null, False));
        If(Or(Compare(Global.__currentMap___, ==, Add(Left, Right)), Compare(Global.__currentMap___, ==, Vector(-500, -100, -500))));
            Set Global Variable(__currentMap___, Ray Cast Hit Position(Vector(30, 5, False), Vector(-30, -10, -10), Null, Null, False));
            If(Compare(Global.__currentMap___, ==, Vector(-30, -10, -10)));
                Set Global Variable(__currentMap___, Ray Cast Hit Position(Vector(200, 20, 100), Vector(100, -100, -100), Null, Null, False));
                If(Compare(Global.__currentMap___, ==, Vector(100, -100, -100)));
                    Set Global Variable(__currentMap___, Ray Cast Hit Position(Vector(300, 20, -100), Vector(300, -100, 100), Null, Null, False));
                    If(Compare(Global.__currentMap___, ==, Vector(300, -100, 100)));
                        Set Global Variable(__currentMap___, Ray Cast Hit Position(Vector(50, 100, -150), Vector(-50, -100, -160), Null, Null, False));
                        If(Compare(Global.__currentMap___, ==, Vector(-50, -100, -160)));
                            Set Global Variable(__currentMap___, Ray Cast Hit Position(Vector(False, 300, 340), Vector(False, -100, -300), Null, Null, False));
                            If(Compare(Global.__currentMap___, ==, Vector(False, -100, -300)));
                                Set Global Variable(__currentMap___, Ray Cast Hit Position(Vector(140, 10, -240), Vector(200, -10, -300), Null, Null, False));
                                If(Compare(Global.__currentMap___, ==, Vector(200, -10, -300)));
                                    Set Global Variable(__currentMap___, Ray Cast Hit Position(Vector(-180, 30, 60), Vector(-180, -50, -60), Null, Null, False));
                                End;
                            End;
                        End;
                    End;
                End;
            End;
        End;
        Set Global Variable(__currentMap___, Add(Add(Multiply(100, Round To Integer(Y Component Of(Global.__currentMap___), Up)), Multiply(10, Round To Integer(X Component Of(Global.__currentMap___), Nearest))), Round To Integer(Z Component Of(Global.__currentMap___), Down)));
        If(Compare(Global.__currentMap___, ==, 10121));
            Set Global Variable(__currentMap___, Ray Cast Hit Position(Vector(-60, 20, -60), Vector(60, -10, 60), Null, Null, False));
            If(Compare(Global.__currentMap___, ==, Vector(60, -10, 60)));
                Set Global Variable(__currentMap___, Ray Cast Hit Position(Vector(-180, -70, 60), Vector(-180, -100, -60), Null, Null, False));
            End;
            Set Global Variable(__currentMap___, Add(Add(Multiply(100, Round To Integer(Y Component Of(Global.__currentMap___), Up)), Multiply(10, Round To Integer(X Component Of(Global.__currentMap___), Nearest))), Round To Integer(Z Component Of(Global.__currentMap___), Down)));
        End;
        Set Global Variable(controlCenterPosition, Array(Objective Position(False), Objective Position(True), Objective Position(2)));
    }
}

rule ("Setup Blacklist") {
    event {
        Ongoing - Global;
    }
    actions {
        Set Global Variable(blackList, Empty Array);
        Modify Global Variable(blackList, Append To Array, String Split(Custom String("Msm-船长-六十块就这样没了-Pakho-希望小晨永远开心-田哈哈-花终落"), Custom String("-")));
    }
}

rule ("Remove Player from Blacklist") {
    event {
        Player Joined Match;
        Team 1;
        All;
    }
    conditions {
        Array Contains(Global.blackList, Custom String("{0}", Event Player)) == True;
    }
    actions {
        Remove Player(Event Player);
    }
}

rule ("initialize event flag") {
    event {
        Ongoing - Global;
    }
    conditions {
        Total Time Elapsed > If-Then-Else(Evaluate Once(Global.debugMode), 20, 120);
        Global.vishkarEventActivated != True;
    }
    actions {
        Set Global Variable(vishkarEventActivated, True);
        Abort;
    }
}

rule ("when a mercy might rez, respawn time is increased") {
    event {
        Player Died;
        Team 1;
        All;
    }
    conditions {
        Is Hero Being Played(Hero(Mercy), Team 1) == True;
        (Event Player).controlPlayerRespawnPosition == Null;
    }
    actions {
        Abort If(And(Compare((Event Player).eventType, ==, 2), Compare((Event Player).eventId, ==, 10)));
        Abort If(And(Compare((Event Player).eventType, ==, Null), Compare((Event Player).eventId, ==, 7)));
        If(Is True For Any(Players On Hero(Hero(Mercy), Team 1), And(And(Compare(Distance Between(Position Of(Event Player), Position Of(Current Array Element)), <, 40), Is Alive(Current Array Element)), Compare(Ability Cooldown(Current Array Element, Button(Ability 2)), <, 8))));
            Big Message(Event Player, Custom String("附近有 天使 等待复活..."));
            Disable Built-In Game Mode Respawning(Event Player);
            Wait(4, Ignore Condition);
            Enable Built-In Game Mode Respawning(Event Player);
    }
}

rule ("[Hero/Symmetra] Break teleporter on interact") {
    event {
        Ongoing - Each Player;
        Team 1;
        Symmetra;
    }
    conditions {
        Is Button Held(Event Player, Button(Interact)) == True;
        Ability Cooldown(Event Player, Button(Ability 2)) > Null;
    }
    actions {
        Wait(0.5, Ignore Condition);
