rule ("[Bastion] Sustain nano secondary fire") {
    event {
        Ongoing - Each Player;
        Team 2;
        Bastion;
    }
    conditions {
        Is Dummy Bot(Event Player) == True;
        (Event Player).hasNano == True;
        Is Alive(Event Player) == True;
        Ability Cooldown(Event Player, Button(Secondary Fire)) == Null;
        First Of(Players Within Radius(Eye Position(Event Player), 150, Team 1, Off)) != False;
    }
    actions {
        Wait(Random Real(0.016, 0.032), Abort When False);
        Start Holding Button(Event Player, Button(Secondary Fire));
