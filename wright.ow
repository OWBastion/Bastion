rule ("save player data if the player has passed round 2") {
    event {
        Subroutine;
        savePlayerData;
    }
    actions {
        Wait(Multiply(Divide(Server Load Average, 100), 0.5), Ignore Condition);
        If(Compare((Event Player).heroNumber, >, 2));
            If(Not(Array Contains(Global.savedIndex, Custom String("{0}", Event Player))));
                Modify Global Variable(savedIndex, Append To Array, Custom String("{0}", Event Player));
            End;
            Wait(Add(Multiply(Slot Of(Event Player), 0.032), Multiply(Random Real(1, 2), 0.5)), Ignore Condition);
            Set Global Variable At Index(savedData, False, Append To Array(Append To Array(Array Slice(First Of(Global.savedData), False, Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))), Array((Event Player).heroNumber)), Array Slice(First Of(Global.savedData), Add(Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player)), True), 999999999999)));
            Wait(Multiply(Divide(Server Load Average, 100), 0.5), Ignore Condition);
            Set Global Variable At Index(savedData, True, Append To Array(Append To Array(Array Slice(Value In Array(Global.savedData, True), False, Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))), Array((Event Player).runDeathCount)), Array Slice(Value In Array(Global.savedData, True), Add(Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player)), True), 999999999999)));
            Wait(Multiply(Divide(Server Load Average, 100), 0.5), Ignore Condition);
            Set Global Variable At Index(savedData, 2, Append To Array(Append To Array(Array Slice(Value In Array(Global.savedData, 2), False, Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))), Array((Event Player).isWinner)), Array Slice(Value In Array(Global.savedData, 2), Add(Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player)), True), 999999999999)));
            Wait(Multiply(Divide(Server Load Average, 100), 0.5), Ignore Condition);
            Set Global Variable At Index(savedData, 3, Append To Array(Append To Array(Array Slice(Value In Array(Global.savedData, 3), False, Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))), Array((Event Player).skipCount)), Array Slice(Value In Array(Global.savedData, 3), Add(Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player)), True), 999999999999)));
            Wait(Multiply(Divide(Server Load Average, 100), 0.5), Ignore Condition);
            Skip If(Compare((Event Player).winnerTime, ==, Null), True);
            Set Global Variable At Index(savedData, 5, Append To Array(Append To Array(Array Slice(Value In Array(Global.savedData, 5), False, Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))), Array((Event Player).winnerTime)), Array Slice(Value In Array(Global.savedData, 5), Add(Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player)), True), 999999999999)));
            Wait(Multiply(Divide(Server Load Average, 100), 0.5), Ignore Condition);
            Set Global Variable At Index(savedData, 6, Append To Array(Append To Array(Array Slice(Value In Array(Global.savedData, 6), False, Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))), Array(If-Then-Else(Compare((Event Player).playerOnceEventState, !=, Null), Array Slice((Event Player).playerOnceEventState, False, True), Array(Null)))), Array Slice(Value In Array(Global.savedData, 6), Add(Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player)), True), 999999999999)));
            Set Global Variable At Index(savedData, 4, Append To Array(Append To Array(Array Slice(Value In Array(Global.savedData, 4), False, Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))), Array((Event Player).joinTime)), Array Slice(Value In Array(Global.savedData, 4), Add(Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player)), True), 999999999999)));
            Small Message(Event Player, Custom String("  你的挑战进度已保存"));
            Wait(2, Ignore Condition);
            If(Compare(Event Player, ==, Host Player));
                Small Message(Host Player, Custom String("  如果当前游戏重开，所有人的进度数据将被清空"));
            End;
            Wait(2, Ignore Condition);
            If(Compare(Random Integer(False, 2), ==, Null));
                Small Message(Event Player, Custom String("  为了保证房间处于公开状态，请确保房主赞赏等级为 3 级或以上"));
            End;
    }
}

rule ("player deaths are counted manually rather than relying on in-game statistics") {
    event {
        Player Died;
        Team 1;
        All;
    }
    conditions {
        (Event Player).isWinner == False;
    }
    actions {
        Wait(Divide(Multiply(0.5, Server Load), 100), Ignore Condition);
        Modify Player Variable(Event Player, runDeathCount, Add, True);
        If(Array Contains(Global.savedIndex, Event Player));
            Wait(0.032, Ignore Condition);
            Set Global Variable At Index(savedData, True, Append To Array(Append To Array(Array Slice(Value In Array(Global.savedData, True), False, Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player))), Array((Event Player).runDeathCount)), Array Slice(Value In Array(Global.savedData, True), Add(Index Of Array Value(Global.savedIndex, Custom String("{0}", Event Player)), True), 999999999999)));
        End;
        Set Facing(Event Player, Direction Towards(Eye Position(Event Player), If-Then-Else(Compare(Global.controlRespawnPosition, ==, Null), Position Of(Global.endPosition), Position Of(First Of(Global.controlJumpPosition)))), To World);
    }
}

rule ("add 1 to heroNumber, switch player to the newly unlocked hero, and set hero availability to that hero and all preceding") {
    event {
        Subroutine;
        progressHero;
    }
    actions {
        Modify Player Variable(Event Player, heroNumber, Add, True);
        Set Player Variable(Event Player, controlJumpIndex, Null);
        Set Player Variable(Event Player, controlPlayerRespawnPosition, Null);
        Play Effect(Event Player, Buff Explosion Sound, Color(White), Position Of(Event Player), 200);
        Set Player Variable(Event Player, progressionDeathCount, Null);
        Wait(0.032, Ignore Condition);
        Preload Hero(Event Player, Value In Array(Global.heroList, (Event Player).heroNumber));
        Start Forcing Player To Be Hero(Event Player, Value In Array(Global.heroList, (Event Player).heroNumber));
        Wait Until(Compare(Hero Of(Event Player), ==, Value In Array(Global.heroList, (Event Player).heroNumber)), 0.5);
        Stop Forcing Player To Be Hero(Event Player);
        Wait(Multiply(Divide(Server Load, 100), 0.5), Ignore Condition);
        Set Player Allowed Heroes(Event Player, Array Slice(Global.heroList, False, Add((Event Player).heroNumber, True)));
        Wait(Multiply(Divide(Server Load, 100), 0.5), Ignore Condition);
        Wait(Multiply(Divide(Server Load, 100), 0.5), Ignore Condition);
        Wait(3, Ignore Condition);
        Call Subroutine(savePlayerData);
        Wait(0.1, Ignore Condition);
    }
}

rule ("[System] Run passive regen") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        (Event Player).passiveRegenBlocked != True;
        (Event Player).combatRegen == True;
    }
    actions {
        Set Player Variable(Event Player, combatRegen, False);
        Abort If(Is True For Any(Array(Is Dead(Event Player), Compare(Normalized Health(Event Player), ==, 1), Compare((Event Player).heal_recv, <=, -100)), Current Array Element));
        Small Message(Event Player, Custom String("  {0}  脱战自动回复启动 ", Ability Icon String(Hero(Baptiste), Button(Ability 1))));
        Start Heal Over Time(Event Player, Event Player, 999999999999, Add(50, Divide(Multiply(Max Health(Event Player), 8), 100)));
        Set Player Variable(Event Player, healID, Last Heal Over Time ID);
        Wait Until(Is True For Any(Array((Event Player).passiveRegenBlocked, Is Dead(Event Player), Compare(Normalized Health(Event Player), ==, 1), Compare((Event Player).heal_recv, <=, -100), Compare((Event Player).healID, ==, Null)), Current Array Element), 999999999999);
        If(Compare((Event Player).healID, !=, Null));
            Stop Heal Over Time((Event Player).healID);
            Set Player Variable(Event Player, healID, Null);
    }
}

rule ("[System] Arm passive regen") {
    event {
        Player Took Damage;
        Team 1;
        All;
    }
    actions {
        Set Player Variable(Event Player, combatRegen, False);
        If(Compare((Event Player).healID, !=, Null));
            Stop Heal Over Time((Event Player).healID);
            Set Player Variable(Event Player, healID, Null);
        End;
        Wait(3, Restart When True);
        Set Player Variable(Event Player, combatRegen, True);
    }
}

rule ("initialize difficulty effects text") {
    event {
        Subroutine;
        setDifficulty;
    }
    actions {
        Wait(Divide(Server Load Average, 100), Ignore Condition);
        Set Global Variable At Index(difficultyText, False, Value In Array(Array(Custom String("简单"), Custom String("一般"), Custom String("困难"), Custom String("专家"), Custom String("传奇"), Custom String("地狱")), Global.difficulty));
        Set Global Variable At Index(difficultyText, True, Value In Array(Array(Color(Green), Color(Lime Green), Color(Yellow), Color(Orange), Color(Red), Custom Color(118, 93, 189, 255)), Global.difficulty));
    }
}

rule ("3rd camera function") {
    event {
        Subroutine;
        setThirdPerson;
    }
    actions {
        Set Player Variable(Event Player, third, Not((Event Player).third));
        If((Event Player).third);
            Start Camera(Event Player, Ray Cast Hit Position(Add(Event Player, Multiply(Up, Add(Distance Between(Eye Position(Event Player), Event Player), 0.5))), Ray Cast Hit Position(Add(Event Player, Multiply(Up, Add(Distance Between(Eye Position(Event Player), Event Player), 0.5))), Add(Add(Event Player, Multiply(Up, Add(Distance Between(Eye Position(Event Player), Event Player), 0.5))), Multiply(Facing Direction Of(Event Player), -3)), Null, Event Player, True), Null, Event Player, True), Add(Event Player, Multiply(Facing Direction Of(Event Player), 100)), 100);
        Else;
            Stop Camera(Event Player);
    }
}

rule ("create bastion bots") {
    event {
        Subroutine;
        createBastionBot;
    }
    actions {
        While(Compare(Number Of Players(Team 2), <, Count Of(Global.bastionPosition)));
            Create Dummy Bot(Hero(Bastion), Team 2, Number Of Players(Team 2), Random Value In Array(Spawn Points(Team 2)), Null);
            Wait(0.25, Ignore Condition);
            Abort If(Or(Compare(Number Of Players(Team 2), >=, Count Of(Global.bastionPosition)), Compare(Total Time Elapsed, >, 120)));
        End;
        If(Or(Compare(Global.kills, ==, Null), Compare(Count Of(Global.kills), ==, Null)));
            Set Global Variable(kills, Array(Null, Null, Null, Null, Null, Null));
    }
}

rule ("create bastion bots when the game starts and there are not enough") {
    event {
        Ongoing - Global;
    }
    conditions {
        Number Of Players(Team 2) < Count Of(Global.bastionPosition);
        Total Time Elapsed > 10;
    }
    actions {
        Wait(True, Ignore Condition);
        If(Compare(Number Of Players(Team 2), <, Count Of(Global.bastionPosition)));
            Call Subroutine(createBastionBot);
        End;
        Wait(2, Ignore Condition);
        Wait(Max(0.5, Multiply(Divide(Server Load Average, 100), 0.8)), Ignore Condition);
        Loop If Condition Is True;
    }
}

rule ("SAFE create bastion bots when the game start and there are no bastion bots - emergency backup") {
    event {
        Ongoing - Global;
    }
    conditions {
        Number Of Players(Team 2) == Null;
        Total Time Elapsed > 15;
        Number Of Players(Team 1) > Null;
    }
    actions {
        Wait(2, Ignore Condition);
        If(Compare(Number Of Players(Team 2), ==, Null));
            Destroy All Dummy Bots;
            Wait(0.5, Ignore Condition);
            Call Subroutine(createBastionBot);
        End;
        Wait(Max(True, Multiply(Divide(Server Load Average, 100), 3.2)), Ignore Condition);
        Loop If Condition Is True;
    }
}

rule ("hashTag | Event Weight Sum Verify") {
    event {
        Ongoing - Global;
    }
    conditions {
        Global.hashTag == True;
        Global.vishkarEventActivated == True;
        First Of(Global.hashTagWeightVerifyState) != True;
        Total Time Elapsed > 125;
    }
    actions {
        Wait Until(Compare(Count Of(Global.eventCatalogId), >, Null), 125);
        Set Global Variable At Index(hashTagWeightVerifyState, True, Null);
        Set Global Variable(I, Null);
        For Global Variable(I, 0, Count Of(Global.eventCatalogId), True);
            Modify Global Variable At Index(hashTagWeightVerifyState, True, Add, Value In Array(Global.eventCatalogWeight, Value In Array(Global.eventCatalogId, Global.I)));
        End;
        If(Compare(Round To Integer(Multiply(Value In Array(Global.hashTagWeightVerifyState, True), 1000), Nearest), !=, 62700));
            Set Global Variable(hashTag, False);
        End;
        Set Global Variable At Index(hashTagWeightVerifyState, False, True);
        Log To Inspector(Custom String("[hashTag]: {0},62700", Round To Integer(Multiply(Value In Array(Global.hashTagWeightVerifyState, True), 1000), Nearest)));
    }
}

rule ("Hashtag") {
    event {
        Ongoing - Global;
    }
    conditions {
        Global.hashTag == True;
        Global.vishkarEventActivated == True;
        Total Time Elapsed > 125;
        Is True For Any(Array(Compare(Count Of(Filtered Array(Global.eventCatalogId, Compare(Value In Array(Global.eventCatalogType, Current Array Element), ==, Null))), <, 25), Compare(Count Of(Filtered Array(Global.eventCatalogId, Compare(Value In Array(Global.eventCatalogType, Current Array Element), ==, 1))), <, 19), Compare(Count Of(Filtered Array(Global.eventCatalogId, Compare(Value In Array(Global.eventCatalogType, Current Array Element), ==, 2))), <, 23)), Current Array Element) == True;
    }
    actions {
        Wait(False, Ignore Condition);
        Set Global Variable(hashTag, False);
    }
}

rule ("[VishkarEvent]: update Player Stats") {
    event {
        Subroutine;
        updatePlayerStats;
    }
    actions {
        Set Move Speed(Event Player, Add(Add(100, (Event Player).mod_speed_perma), (Event Player).mod_speed_event));
        Set Damage Received(Event Player, Max(True, Add(Add(100, (Event Player).mod_dmg_perma), (Event Player).mod_dmg_taken)));
        Set Healing Dealt(Event Player, Add(Add(100, (Event Player).mod_heal_perma), (Event Player).mod_heal_event));
        Set Healing Received(Event Player, Add(100, (Event Player).heal_recv));
        Set Knockback Received(Event Player, Add(100, (Event Player).knockback));
    }
}

rule ("[VishkarEvent]: set Event Duration") {
    event {
        Subroutine;
        setEventDuration;
    }
    actions {
        Set Player Variable(Event Player, eventDurationHud, (Event Player).eventDuration);
    }
}

rule ("[VishkarEvent]: tick event duration hud") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        (Event Player).eventId != -1;
        (Event Player).eventDurationHud > Null;
    }
    actions {
        Wait(True, Abort When False);
        Modify Player Variable(Event Player, eventDurationHud, Subtract, True);
        Loop If Condition Is True;
    }
}

rule ("[VishkarEvent]: reset Player Ability CD") {
    event {
        Subroutine;
        resetPlayerCD;
    }
    actions {
        Set Ability Cooldown(Event Player, Button(Primary Fire), False);
        Set Ability Cooldown(Event Player, Button(Secondary Fire), False);
        Set Ability Cooldown(Event Player, Button(Ability 1), False);
        Set Ability Cooldown(Event Player, Button(Ability 2), False);
        Set Ability Cooldown(Event Player, Button(Jump), False);
        Set Ability Cooldown(Event Player, Button(Reload), False);
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
    }
}

rule ("子程序：设置玩家大小") {
    event {
        Subroutine;
        setPlayerSize;
    }
    actions {
        Start Scaling Player(Event Player, Add(True, (Event Player).eventSize), False);
    }
}

rule ("[VishkarEvent]: clear Player event effect") {
    event {
        Subroutine;
        clearEventEffect;
    }
    actions {
        If(Compare(Count Of((Event Player).eventEffect), >, Null));
            Destroy Effect(First Of((Event Player).eventEffect));
            If(Compare(Count Of((Event Player).eventEffect), >, 1));
                Destroy Effect(Value In Array((Event Player).eventEffect, True));
            End;
        Else;
            Destroy Effect((Event Player).eventEffect);
        End;
        Set Player Variable(Event Player, eventEffect, Null);
    }
}

rule ("[VishkarEvent]: commit player event category") {
    event {
        Subroutine;
        commitPlayerEventCategory;
    }
    actions {
        Abort If(Or(Compare((Event Player).eventCategoryCommitted, ==, True), Compare((Event Player).eventIsSelected, ==, False)));
        If(Compare((Event Player).eventType, ==, Null));
            Skip If(Compare((Event Player).eventId, ==, Null), True);
            Modify Player Variable At Index(Event Player, eventCount, False, Add, True);
            Set Player Variable(Event Player, eventLucky, If-Then-Else(Compare((Event Player).eventLucky, >, Null), Add((Event Player).eventLucky, True), 1));
        Else If(Compare((Event Player).eventType, ==, 1));
            Modify Player Variable At Index(Event Player, eventCount, True, Add, True);
            Set Player Variable(Event Player, eventLucky, If-Then-Else(Compare((Event Player).eventLucky, <, Null), Subtract((Event Player).eventLucky, True), -1));
        Else If(Compare((Event Player).eventType, ==, 2));
            Modify Player Variable At Index(Event Player, eventCount, 2, Add, True);
        Else;
            Abort;
        End;
        Set Player Variable(Event Player, eventCategoryCommitted, True);
    }
}

rule ("[VishkarEvent]: set player event") {
    event {
        Subroutine;
        setPlayerEvent;
    }
    actions {
        Call Subroutine(buildCandidatePool);
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Call Subroutine(rejecSampling);
        If(Compare((Event Player).thiefBuffStolen, ==, True));
            Set Player Variable(Event Player, thiefBuffStolen, False);
        End;
        Set Player Variable(Event Player, eventCategoryCommitted, False);
        Set Player Variable(Event Player, eventType, Value In Array(Global.eventCatalogType, (Event Player).eventCandidateIndex));
        Set Player Variable(Event Player, eventId, Value In Array(Global.eventCatalogEffectId, (Event Player).eventCandidateIndex));
        Set Player Variable(Event Player, eventName, Value In Array(Global.eventName, (Event Player).eventCandidateIndex));
        Set Player Variable(Event Player, eventDesc, Value In Array(Global.eventDesc, (Event Player).eventCandidateIndex));
        Set Player Variable(Event Player, eventDuration, Value In Array(Global.eventDuration, (Event Player).eventCandidateIndex));
        Call Subroutine(commitPlayerEventCategory);
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        If(Compare((Event Player).eventLastId, ==, Null));
            Set Player Variable(Event Player, eventLastId, Empty Array);
        End;
        If(Compare((Event Player).eventForceRoll, !=, Null));
            If(Compare((Event Player).eventForceCount, >, Null));
                Modify Player Variable(Event Player, eventForceCount, Subtract, True);
            Else;
                Set Player Variable(Event Player, eventForceRoll, Null);
            End;
        End;
        Modify Player Variable(Event Player, eventLastId, Append To Array, (Event Player).eventCandidateIndex);
        If(Compare(Count Of((Event Player).eventLastId), >, 10));
            Set Player Variable(Event Player, eventLastId, Array Slice((Event Player).eventLastId, Subtract(Count Of((Event Player).eventLastId), 10), 999999999999));
        End;
        Skip If(Compare((Event Player).eventDesc, ==, Null), 4);
        Skip If(Compare((Event Player).eventId, ==, 666), 2);
        Small Message(Event Player, Custom String("  {0}  触发事件：{1}（{2}）", Ability Icon String(Hero(Sombra), Button(Ultimate)), (Event Player).eventName, If-Then-Else(Compare((Event Player).eventDuration, >, Null), Custom String("{0}秒", (Event Player).eventDuration), Custom String("一次性"))));
        Small Message(Event Player, Custom String("  {0}  事件效果：{1}", Ability Icon String(Hero(Sombra), Button(Ultimate)), String Replace((Event Player).eventDesc, Custom String("\n"), Custom String("，"))));
        Call Subroutine(setEventDuration);
    }
}

rule ("[VishkarEvent]: player event end") {
    event {
        Subroutine;
        clearPlayerEvent;
    }
    actions {
        Call Subroutine(clearEventEffect);
        Stop Forcing Throttle(Event Player);
        Stop Throttle In Direction(Event Player);
        Set Player Variable(Event Player, combatRegen, False);
        Set Player Variable(Event Player, passiveRegenBlocked, False);
        Set Player Variable(Event Player, eventId, -1);
        Set Player Variable(Event Player, eventType, Null);
        Set Player Variable(Event Player, eventCategoryCommitted, False);
        Set Player Variable(Event Player, eventCandidateIndex, Null);
        Set Player Variable(Event Player, eventTempIndex, Empty Array);
        Set Player Variable(Event Player, eventLoopCount, Null);
        Set Player Variable(Event Player, eventIsSelected, False);
        Set Player Variable(Event Player, eventDuration, Null);
        Set Player Variable(Event Player, eventDurationHud, Null);
        Set Player Variable(Event Player, eventName, Null);
        Set Player Variable(Event Player, eventDesc, Null);
        Set Player Variable(Event Player, eventEffectPlayers, Null);
        Set Player Variable(Event Player, mod_speed_event, Null);
        Set Player Variable(Event Player, mod_heal_event, Null);
        Set Player Variable(Event Player, heal_recv, Null);
        Set Player Variable(Event Player, mod_dmg_taken, Null);
        Set Player Variable(Event Player, targetWeight, Null);
        Set Player Variable(Event Player, targetSilence, False);
        Set Player Variable(Event Player, knockback, Null);
        Set Player Variable(Event Player, sizeHealth, 1);
        Set Player Variable(Event Player, eventSize, Null);
        Set Player Variable(Event Player, eventTargetHP, Null);
        Set Player Variable(Event Player, altFormActive, False);
        Destroy Effect(First Of((Event Player).invincibleEffect));
        Set Player Variable At Index(Event Player, invincibleEffect, False, Null);
        Destroy Effect(Value In Array((Event Player).invincibleEffect, True));
        Set Player Variable At Index(Event Player, invincibleEffect, True, Null);
        Set Player Variable(Event Player, eventMission, Null);
        Set Player Variable(Event Player, eventMissionGoal, Null);
        Set Player Variable(Event Player, hudText, Char In String(Empty Array, False));
        Set Player Variable(Event Player, target, Null);
        Set Player Variable(Event Player, possess, Null);
        Stop Scaling Player(Event Player);
        Stop Scaling Barriers(Event Player);
        Stop Modifying Hero Voice Lines(Event Player);
        Call Subroutine(updatePlayerStats);
        Small Message(Event Player, Custom String("  {0} 事件已结束", Ability Icon String(Hero(Moira), Button(Ability 2))));
    }
}

rule ("[VishkarEvent]: set player HP") {
    event {
        Subroutine;
        setPlayerHP;
    }
    actions {
        Set Player Variable(Event Player, temp, Normalized Health(Event Player));
        Set Max Health(Event Player, Add(Multiply(100, (Event Player).sizeHealth), Multiply(First Of((Event Player).heart_steel), Value In Array((Event Player).heart_steel, 2))));
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Set Player Health(Event Player, Multiply(Max Health(Event Player), (Event Player).temp));
    }
}

rule ("[VishkarEvent]: stop Combat Regen") {
    event {
        Subroutine;
        startCombatRegen;
    }
    actions {
        Skip If((Event Player).combatRegen, True);
        Set Player Variable(Event Player, combatRegen, True);
    }
}

rule ("[VishkarEvent]: get player event") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Number Of Players(Team 2) == Count Of(Global.bastionPosition);
        Is True For All(Array(Global.vishkarEventActivated, Has Spawned(Event Player), Compare((Event Player).eventId, ==, -1)), Current Array Element) == True;
        Is True For Any(Array(And(Compare(Value In Array(First Of((Event Player).playerTitles), True), ==, Vector(149, 239, 66)), Compare((Event Player).heroNumber, >=, 1)), Compare((Event Player).heroNumber, >, 2)), Current Array Element) == True;
    }
    actions {
        Skip If(Compare((Event Player).hudTextId, !=, Null), 3);
        Set Player Variable(Event Player, hudText, Char In String(Empty Array, False));
        Create HUD Text(Event Player, Null, Custom String("\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r"), (Event Player).hudText, Top, 9, Null, Color(White), Color(White), Visible To and String, Default Visibility);
        Set Player Variable(Event Player, hudTextId, Last Text ID);
        Wait(If-Then-Else(Evaluate Once(Global.debugMode), 10, If-Then-Else((Event Player).isWinner, 40, Random Integer(30, 35))), Abort When False);
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Call Subroutine(setPlayerEvent);
        Wait Until(Compare((Event Player).eventDuration, ==, Null), (Event Player).eventDuration);
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Call Subroutine(clearPlayerEvent);
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Loop If Condition Is True;
    }
}

disabled rule ("未经原作者许可，任何人不得将以下代码进行二次创作与发布") {
    event {
        Ongoing - Global;
    }
}

rule ("[VishkarEvent]: 疾风祝福") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, Null), Compare((Event Player).eventId, ==, 1)), Current Array Element) == True;
    }
    actions {
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Create Effect(All Players(All Teams), Soldier: 76 Sprinting Effect, Color(Team 1), Event Player, 200, Position and Radius);
        Set Player Variable(Event Player, eventEffect, Last Created Entity);
        Set Player Variable(Event Player, mod_speed_event, 50);
        Call Subroutine(updatePlayerStats);
        Wait((Event Player).eventDuration, Ignore Condition);
        Set Player Variable(Event Player, mod_speed_event, Null);
        Call Subroutine(updatePlayerStats);
    }
}

rule ("[VishkarEvent]: 钢铁防线") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, Null), Compare((Event Player).eventId, ==, 2)), Current Array Element) == True;
    }
    actions {
        Wait(0.032, Ignore Condition);
        Skip If(Compare(Value In Array((Event Player).healthId, True), ==, Null), True);
        Remove Health Pool From Player(Value In Array((Event Player).healthId, True));
        Add Health Pool To Player(Event Player, Armor, Round To Integer(Add(500, Divide(Multiply(Max Health(Event Player), 100), 100)), Nearest), False, False);
        Set Player Variable At Index(Event Player, healthId, True, Last Created Health Pool);
        Play Effect(All Players(All Teams), Brigitte Repair Pack Armor Effect, Color(White), Event Player, 200);
        Set Player Variable(Event Player, mod_dmg_taken, -25);
        Call Subroutine(updatePlayerStats);
        Wait Until(Compare((Event Player).eventId, ==, -1), (Event Player).eventDuration);
        Remove Health Pool From Player(Value In Array((Event Player).healthId, True));
        Set Player Variable(Event Player, mod_dmg_taken, Null);
        Call Subroutine(updatePlayerStats);
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Set Player Variable At Index(Event Player, healthId, True, Null);
    }
}

rule ("[VishkarEvent]: 生命源泉") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, Null), Compare((Event Player).eventId, ==, 3)), Current Array Element) == True;
    }
    actions {
        Wait(0.032, Ignore Condition);
        Skip If(Compare(Value In Array((Event Player).healthId, 3), ==, Null), True);
        Remove Health Pool From Player(Value In Array((Event Player).healthId, 3));
        Add Health Pool To Player(Event Player, Health, Round To Integer(Divide(Multiply(Max Health(Event Player), 50), 100), Nearest), False, False);
        Set Player Variable At Index(Event Player, healthId, 3, Last Created Health Pool);
        Create Effect(All Players(All Teams), Heal Target Active Effect, Color(Yellow), Event Player, 200, Position and Radius);
        Set Player Variable(Event Player, eventEffect, Last Created Entity);
        Start Heal Over Time(Event Player, Event Player, 20, Divide(Multiply(Max Health(Event Player), 15), 100));
        Wait Until(Compare((Event Player).eventId, ==, -1), (Event Player).eventDuration);
        Remove Health Pool From Player(Value In Array((Event Player).healthId, 3));
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Set Player Variable At Index(Event Player, healthId, 3, Null);
    }
}

rule ("[VishkarEvent]: 黑粉来袭") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, Null), Compare((Event Player).eventId, ==, 4)), Current Array Element) == True;
    }
    actions {
        Wait(0.032, Ignore Condition);
        If(Compare((Event Player).eventEffect, ==, Null));
            Create Effect(If-Then-Else(Compare((Event Player).mod_speed_event, ==, 25), All Players(All Teams), Null), Soldier: 76 Sprinting Effect, Color(Team 1), Event Player, 200, Visible To Position and Radius);
            Set Player Variable(Event Player, eventEffect, Last Created Entity);
        End;
        If(Compare(Count Of(Filtered Array(All Players(Team 2), Compare((Current Array Element).target, ==, Event Player))), ==, Null));
            If(Compare((Event Player).mod_speed_event, !=, Null));
                Set Player Variable(Event Player, mod_speed_event, Null);
                Call Subroutine(updatePlayerStats);
            End;
            Wait(0.25, Ignore Condition);
            Loop If Condition Is True;
            Skip(12);
        End;
        Skip If(Compare((Event Player).mod_speed_event, ==, 25), 2);
        Set Player Variable(Event Player, mod_speed_event, 25);
        Call Subroutine(updatePlayerStats);
        Add Health Pool To Player(Event Player, Health, Add(25, Round To Integer(Divide(Multiply(Max Health(Event Player), 15), 100), Nearest)), False, False);
        Modify Player Variable(Event Player, hp_data, Append To Array, Array(Array(Add(Total Time Elapsed, 2), Last Created Health Pool, (Event Player).eventId)));
        Wait Until(Compare(Count Of(Filtered Array(All Players(Team 2), Compare((Current Array Element).target, ==, Event Player))), ==, Null), 1.96);
        Loop If(And(Compare(Count Of(Filtered Array(All Players(Team 2), Compare((Current Array Element).target, ==, Event Player))), >, Null), Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, Null), Compare((Event Player).eventId, ==, 4)), Current Array Element)));
        Set Player Variable(Event Player, mod_speed_event, Null);
        Call Subroutine(updatePlayerStats);
        Wait(0.25, Ignore Condition);
        Loop If Condition Is True;
    }
}

