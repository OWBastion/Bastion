rule ("[Hero/Ana] Track sleep lockout") {
    event {
        Player Dealt Damage;
        Team 1;
        Ana;
    }
    conditions {
        Event Ability == Button(Ability 1);
        (Victim).hasNano != True;
    }
    actions {
        If(Compare(Subtract(Total Time Elapsed, Value In Array((Event Player).anaSleepLimit, Slot Of(Victim))), >, 30));
            Set Status(Victim, Null, Invincible, 5);
            Set Player Variable At Index(Event Player, anaSleepLimit, Slot Of(Victim), Total Time Elapsed);
        Else;
            Big Message(Event Player, Custom String("{0} 我起了！ {0}时间到了！", Icon String(Warning)));
            Wait(0.1, Ignore Condition);
            While(Has Status(Victim, Asleep));
                Clear Status(Victim, Asleep);
                Wait(0.1, Ignore Condition);
            End;
    }
}

