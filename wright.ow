                Modify Global Variable At Index(eventCatalogWeight, Value In Array(Filtered Array(Global.eventCatalogId, Compare(Value In Array(Global.eventCatalogType, Current Array Element), ==, Global.devEventCategory)), Global.devEventIndex), Subtract, 0.1);
