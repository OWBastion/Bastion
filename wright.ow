    }
    actions {
        Teleport(Event Player, Value In Array(Global.bastionPosition, Slot Of(Event Player)));
        Wait(False, Ignore Condition);
        Start Forcing Player Position(Event Player, Value In Array(Global.bastionPosition, Slot Of(Event Player)), False);
    }
}

rule ("[Bastion] Handle grenade impact") {
    event {
        Player Took Damage;
        Team 1;
        All;
    }
    conditions {
        Hero Of(Attacker) == Hero(Bastion);
        Attacker != Event Player;
        Event Ability == Button(Secondary Fire);
    }
    actions {
        Skip If(Not((Attacker).hasNano), 2);
        Set Status(Event Player, Attacker, Burning, 3);
        Start Damage Over Time(Event Player, Attacker, 3, Round To Integer(Divide(Round To Integer(Divide(Multiply(Max Health(Victim), 0.5), 3), Up), 4), Up));
        Wait(False, Ignore Condition);
    }
}

rule ("[Bastion] Repel nearby players") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        First Of(Players Within Radius(Event Player, 2, Team 2, Off)) != False;
    }
    actions {
        Apply Impulse(Event Player, Direction From Angles(Horizontal Angle From Direction(Subtract(Position Of(Event Player), Position Of(First Of(Sorted Array(Filtered Array(All Living Players(Team 2), Has Spawned(Current Array Element)), Distance Between(Current Array Element, Event Player)))))), -20), 15, To World, Cancel Contrary Motion);
        Wait(0.5, Restart When True);
    }
}

rule ("[Bastion] Track kills and attacker") {
    event {
        Player Dealt Final Blow;
        Team 2;
        All;
    }
