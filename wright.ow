        Set Global Variable(heroColor, Array(Vector(124, 62, 82), Vector(214, 145, 65), Vector(236, 233, 189), Vector(185, 179, 137), Vector(191, 115, 110), Vector(148, 161, 165), Vector(60, 126, 204), Vector(160, 169, 186), Vector(157, 105, 166), Vector(124, 143, 122), Vector(45, 187, 209), Vector(236, 229, 128), Vector(149, 239, 66), Vector(179, 139, 80), Vector(173, 90, 95), Vector(236, 190, 82), Vector(231, 130, 184), Vector(109, 121, 149), Vector(132, 201, 81), Vector(237, 147, 199), Vector(9, 171, 235), Vector(118, 93, 189), Vector(131, 83, 76), Vector(110, 137, 177), Vector(69, 139, 66), Vector(139, 98, 94), Vector(151, 113, 228), Vector(219, 147, 66), Vector(198, 28, 65), Vector(105, 105, 104), Vector(154, 202, 243), Vector(85, 178, 204), Vector(212, 135, 143), Vector(142, 181, 215), Vector(148, 160, 165), Vector(157, 140, 208), Vector(224, 182, 198), Vector(220, 132, 125), Vector(183, 168, 142), Vector(121, 97, 78), Vector(173, 143, 203), Vector(114, 31, 163), Vector(54, 127, 221), Vector(238, 75, 43), Vector(93, 63, 211), Vector(196, 30, 58)));
