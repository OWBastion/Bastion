        (Event Player).aimPosition != Null;
        Angle Between Vectors(Facing Direction Of(Event Player), Direction Towards(Eye Position(Event Player), (Event Player).aimPosition)) >= True;
    }
    actions {
        Set Player Variable(Event Player, turnSpeed, Angle Between Vectors(Facing Direction Of(Event Player), Multiply(Direction Towards(Eye Position(Event Player), (Event Player).aimPosition), Global.turnSpeedMultiplier)));
        Wait(0.1, Ignore Condition);
        Loop If Condition Is True;
