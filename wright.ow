rule ("[DevTool] Step noclip") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        (Event Player).isDev == True;
        (Event Player).menu == Null;
        (Event Player).isPortalEnabled == True;
        Is Alive(Event Player) == True;
        Is Button Held(Event Player, Button(Reload)) == True;
        Is Communicating Any Emote(Event Player) == False;
        And(Compare(Current Map, ==, Map(Horizon Lunar Colony)), Compare(Distance Between(Event Player, Vector(-9.38, 8.74, 2.05)), <, 1)) == False;
    }
    actions {
        Set Gravity(Event Player, False);
        Skip If(Is Button Held(Event Player, Button(Primary Fire)), 2);
        Teleport(Event Player, Add(Position Of(Event Player), Multiply(Facing Direction Of(Event Player), 4)));
        Skip(True);
        Teleport(Event Player, Add(Position Of(Event Player), Multiply(Facing Direction Of(Event Player), 20)));
        Wait(0.16, Ignore Condition);
        Loop If Condition Is True;
        Abort If(Compare((Event Player).isAirWalkEnabled, ==, True));
        Set Gravity(Event Player, 100);
    }
}

rule ("[DevTool] Cycle control point") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        (Event Player).isDev == True;
        (Event Player).menu == 3;
        Is Button Held(Event Player, Button(Ability 1)) == True;
    }
    actions {
        If(Compare(Global.controlCenterPosition, ==, Null));
            Small Message(Event Player, Custom String("  {0}  开发者模式： 目标点坐标为空", Icon String(Bolt)));
            Abort;
        Else;
            Skip If(Compare((Event Player).controlCenterIndex, >=, 2), 3);
            Modify Player Variable(Event Player, controlCenterIndex, Add, True);
            Small Message(Event Player, Custom String("  {0}  开发者模式： 已选择目标点坐标：{1}", Icon String(Bolt), Value In Array(Global.controlCenterPosition, (Event Player).controlCenterIndex)));
            Abort;
            Set Player Variable(Event Player, controlCenterIndex, Null);
            Small Message(Event Player, Custom String("  {0}  开发者模式： 已选择目标点坐标：{1}", Icon String(Bolt), Value In Array(Global.controlCenterPosition, (Event Player).controlCenterIndex)));
    }
}

rule ("[DevTool] Teleport to control point") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        (Event Player).isDev == True;
        (Event Player).menu == 3;
        Is Button Held(Event Player, Button(Ability 2)) == True;
        Global.controlCenterPosition != Null;
    }
    actions {
        Teleport(Event Player, Nearest Walkable Position(Value In Array(Global.controlCenterPosition, (Event Player).controlCenterIndex)));
    }
}

rule ("[DevTool] Teleport to target") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        (Event Player).isDev == True;
        (Event Player).menu == 2;
        Is Button Held(Event Player, Button(Ability 2)) == True;
        Global.targetPlayer != Null;
    }
    actions {
        Teleport(Event Player, Nearest Walkable Position(Subtract(Position Of(Global.targetPlayer), Backward)));
        Set Facing(Event Player, Facing Direction Of(Global.targetPlayer), To World);
    }
}

rule ("[DevTool] Unlock all heroes") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        (Event Player).isDev == True;
        (Event Player).menu == 2;
        Is Button Held(Event Player, Button(Secondary Fire)) == True;
        (Event Player).isWinner == False;
    }
    actions {
        If(Compare((Event Player).heroNumber, <, Subtract(Count Of(Global.heroList), True)));
            Set Player Variable(Event Player, heroNumber, Subtract(Count Of(Global.heroList), True));
            Wait(Multiply(Divide(Server Load Average, 100), 0.5), Ignore Condition);
            Set Player Allowed Heroes(Event Player, Array Slice(Global.heroList, False, Add((Event Player).heroNumber, True)));
            Wait(Multiply(Divide(Server Load Average, 100), 0.5), Ignore Condition);
            Small Message(Event Player, Custom String("  {0} 开发者模式：已解锁全英雄", Icon String(Bolt)));
        Else If(Compare((Event Player).isWinner, ==, False));
            Set Player Variable(Event Player, isWinner, True);
            Wait(Multiply(Divide(Server Load Average, 100), 0.5), Ignore Condition);
            Small Message(Event Player, Custom String("  {0} 开发者模式：已通关", Icon String(Bolt)));
    }
}

