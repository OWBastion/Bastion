rule ("[VishkarEvent]: 胜利意志") {
    event {
        Player Took Damage;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Is Alive(Event Player), Compare((Event Player).eventType, ==, Null), Compare((Event Player).eventId, ==, 12), Compare(Value In Array((Event Player).invincibleEffect, True), ==, Null)), Current Array Element) == True;
