        Create HUD Text(If-Then-Else(Global.hashTag, Null, Local Player), Null, Custom String("成就挑战已禁用 {0}", Icon String(Warning)), Null, Left, 5, Null, Custom Color(160, 169, 186, 255), Null, Visible To and String, Visible Never);
        Create HUD Text(If-Then-Else(And(And(Compare(Global.hashTag, ==, True), Compare(Count Of((Local Player).earnedAchievements), >, Null)), Compare(Count Of(Global.titleText), >, 43)), Local Player, Null), Null, Custom String("\r\n{0} {1}{2}", Value In Array(Global.titleText, First Of((Local Player).earnedAchievements)), Icon String(Checkmark), Custom String("{0}{1}", If-Then-Else(Compare(Count Of((Local Player).earnedAchievements), >, 1), Custom String("\r\n{0} {1}", Value In Array(Global.titleText, Value In Array((Local Player).earnedAchievements, True)), Icon String(Checkmark)), Char In String(Empty Array, False)), If-Then-Else(Compare(Count Of((Local Player).earnedAchievements), >, 2), Custom String("\r\n{0} {1}{2}", Value In Array(Global.titleText, Value In Array((Local Player).earnedAchievements, 2)), Icon String(Checkmark), Custom String("{0}{1}{2}", If-Then-Else(Compare(Count Of((Local Player).earnedAchievements), >, 3), Custom String("\r\n{0} {1}", Value In Array(Global.titleText, Value In Array((Local Player).earnedAchievements, 3)), Icon String(Checkmark)), Char In String(Empty Array, False)), If-Then-Else(Compare(Count Of((Local Player).earnedAchievements), >, 4), Custom String("\r\n{0} {1}", Value In Array(Global.titleText, Value In Array((Local Player).earnedAchievements, 4)), Icon String(Checkmark)), Char In String(Empty Array, False)), Custom String("{0}{1}{2}", If-Then-Else(Compare(Count Of((Local Player).earnedAchievements), >, 5), Custom String("\r\n{0} {1}", Value In Array(Global.titleText, Value In Array((Local Player).earnedAchievements, 5)), Icon String(Checkmark)), Char In String(Empty Array, False)), If-Then-Else(Compare(Count Of((Local Player).earnedAchievements), >, 6), Custom String("\r\n{0} {1}", Value In Array(Global.titleText, Value In Array((Local Player).earnedAchievements, 6)), Icon String(Checkmark)), Char In String(Empty Array, False)), If-Then-Else(Compare(Count Of((Local Player).earnedAchievements), >, 7), Custom String("\r\n{0} {1}", Value In Array(Global.titleText, Value In Array((Local Player).earnedAchievements, 7)), Icon String(Checkmark)), Char In String(Empty Array, False))))), Char In String(Empty Array, False)))), Null, Left, 100, Null, Custom Color(X Component Of(Value In Array(Global.heroColor, 5)), Y Component Of(Value In Array(Global.heroColor, 5)), Z Component Of(Value In Array(Global.heroColor, 5)), 255), Null, Visible To and String, Default Visibility);
    }
}

rule ("Initialize CN player title state") {
    event {
        Player Joined Match;
        Team 1;
        All;
    }
    actions {
        Set Player Variable(Event Player, playerTitleRelationIndex, Null);
        Set Player Variable(Event Player, tempUnlockId, Null);
        Set Player Variable(Event Player, earnedAchievements, Empty Array);
        Wait(6, Ignore Condition);
        Abort If(Not(Array Contains(Global.titlePlayer, Custom String("{0}", Event Player))));
        Set Player Variable(Event Player, playerTitleRelationIndex, Index Of Array Value(Global.titlePlayer, Custom String("{0}", Event Player)));
        Call Subroutine(setPlayerTitle);
        Wait(0.032, Ignore Condition);
        Small Message(Event Player, Custom String("  称号已加载"));
        Set Player Variable(Event Player, playerTitleAndColor, Value In Array((Event Player).playerTitles, (Event Player).playerTitleIndex));
        If(Compare(Value In Array(Global.titleColor, (Event Player).playerTitleAndColor), ==, Null));
            Set Player Variable(Event Player, info_pvar, Null);
            Set Player Variable(Event Player, rgb_vect, Value In Array(Global.rgbList, (Event Player).info_pvar));
            Set Player Variable(Event Player, rgb_activated, True);
        Else If(Compare(Count Of(Value In Array(Global.titleColor, (Event Player).playerTitleAndColor)), >=, 1));
            Set Player Variable(Event Player, info_pvar, Null);
            Set Player Variable(Event Player, rgb_vect, First Of(Value In Array(Global.titleColor, (Event Player).playerTitleAndColor)));
            Set Player Variable(Event Player, rgb_activated, True);
        Else;
            Set Player Variable(Event Player, rgb_vect, Value In Array(Global.titleColor, (Event Player).playerTitleAndColor));
            Set Player Variable(Event Player, rgb_activated, False);
    }
}

rule ("[Title] Next title") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        (Event Player).menu == 1;
        Is Button Held(Event Player, Button(Ability 2)) == True;
        Count Of((Event Player).playerTitles) > Null;
    }
    actions {
        If(Compare((Event Player).playerTitleIndex, ==, Null));
            Set Player Variable(Event Player, playerTitleIndex, Null);
        End;
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Set Player Variable(Event Player, playerTitleIndex, Modulo(Add((Event Player).playerTitleIndex, True), Count Of((Event Player).playerTitles)));
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Set Player Variable(Event Player, playerTitleAndColor, Value In Array((Event Player).playerTitles, (Event Player).playerTitleIndex));
        Wait(False, Ignore Condition);
        If(Compare(Value In Array(Global.titleColor, (Event Player).playerTitleAndColor), ==, Null));
            Stop Chasing Player Variable(Event Player, rgb_vect);
            Set Player Variable(Event Player, info_pvar, Null);
            Set Player Variable(Event Player, rgb_vect, Value In Array(Global.rgbList, (Event Player).info_pvar));
            Set Player Variable(Event Player, rgb_activated, True);
        Else If(Compare(Count Of(Value In Array(Global.titleColor, (Event Player).playerTitleAndColor)), >=, 1));
            Stop Chasing Player Variable(Event Player, rgb_vect);
            Set Player Variable(Event Player, info_pvar, Null);
            Set Player Variable(Event Player, rgb_vect, First Of(Value In Array(Global.titleColor, (Event Player).playerTitleAndColor)));
            Set Player Variable(Event Player, rgb_activated, True);
        Else;
            Set Player Variable(Event Player, rgb_vect, Value In Array(Global.titleColor, (Event Player).playerTitleAndColor));
            Set Player Variable(Event Player, rgb_activated, False);
        End;
        Small Message(Event Player, Custom String("  {0}  已将称号更改为 {1}", Icon String(Bolt), Value In Array(Global.titleText, (Event Player).playerTitleAndColor)));
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
    }
}

rule ("[Title] Previous title") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        (Event Player).menu == 1;
        Is Button Held(Event Player, Button(Ultimate)) == True;
        Count Of((Event Player).playerTitles) > Null;
    }
    actions {
        If(Or(Compare((Event Player).playerTitleIndex, ==, Null), Compare((Event Player).playerTitleIndex, <=, Null)));
            Set Player Variable(Event Player, playerTitleIndex, Count Of((Event Player).playerTitles));
        End;
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Modify Player Variable(Event Player, playerTitleIndex, Subtract, True);
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Set Player Variable(Event Player, playerTitleAndColor, Value In Array((Event Player).playerTitles, (Event Player).playerTitleIndex));
        Wait(False, Ignore Condition);
        If(Compare(Value In Array(Global.titleColor, (Event Player).playerTitleAndColor), ==, Null));
            Stop Chasing Player Variable(Event Player, rgb_vect);
            Set Player Variable(Event Player, info_pvar, Null);
            Set Player Variable(Event Player, rgb_vect, Value In Array(Global.rgbList, (Event Player).info_pvar));
            Set Player Variable(Event Player, rgb_activated, True);
        Else If(Compare(Count Of(Value In Array(Global.titleColor, (Event Player).playerTitleAndColor)), >=, 1));
            Stop Chasing Player Variable(Event Player, rgb_vect);
            Set Player Variable(Event Player, info_pvar, Null);
            Set Player Variable(Event Player, rgb_vect, First Of(Value In Array(Global.titleColor, (Event Player).playerTitleAndColor)));
            Set Player Variable(Event Player, rgb_activated, True);
        Else;
            Set Player Variable(Event Player, rgb_vect, Value In Array(Global.titleColor, (Event Player).playerTitleAndColor));
            Set Player Variable(Event Player, rgb_activated, False);
        End;
        Small Message(Event Player, Custom String("  {0}  已将称号更改为 {1}", Icon String(Bolt), Value In Array(Global.titleText, (Event Player).playerTitleAndColor)));
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
    }
}

rule ("Init Achievement Data") {
    event {
        Ongoing - Global;
    }
    actions {
        Wait Until(Compare(Count Of(Global.titleText), >, Null), 999999999999);
        Set Global Variable(challengeTitleIds, Array(41, 53, 54, 55, 56, 57));
        If(Compare(Global.classicMapVariant, !=, Null));
            Set Global Variable(challengeTitleIds, Empty Array);
    }
}

rule ("[VishkarEvent]: Challenge 53 Track (GREAT_BENEFACTOR)") {
    event {
        Ongoing - Each Player;
        Team 1;
        All;
    }
    conditions {
        Global.hashTag == True;
        Count Of(Global.challengeTitleIds) != Null;
        Global.difficulty == 5;
        Value In Array((Event Player).dlcTimeChallenge, True) >= 15;
        Array Contains((Event Player).earnedAchievements, 53) == False;
    }
    actions {
        Set Player Variable(Event Player, tempUnlockId, 53);
        Call Subroutine(unlockAchievement);
    }
}

