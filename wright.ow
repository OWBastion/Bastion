        Set Player Variable At Index(Event Player, eventEffect, False, Last Created Entity);
        Create Effect(If-Then-Else(And(Is Alive(Event Player), Compare(First Of(All Players(Team 2)), !=, Null)), All Players(All Teams), Null), Sigma Gravitic Flux Target Sound, Color(Team 2), Event Player, 200, Visible To Position and Radius);
        Set Player Variable At Index(Event Player, eventEffect, True, Last Created Entity);
