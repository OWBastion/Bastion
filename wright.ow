        Wait(False, Ignore Condition);
        Set Global Variable At Index(textIDs, 4, Last Text ID);
        Set Global Variable At Index(textIDs, 3, Mapped Array(Global.bastionPosition, 0));
        For Global Variable(I, 0, Count Of(Global.bastionPosition), True);
            Create Progress Bar In-World Text(If-Then-Else(And(And(Compare(Hero Of(Local Player), ==, Hero(Ana)), Compare(Subtract(Total Time Elapsed, Value In Array((Local Player).anaSleepLimit, Evaluate Once(Global.I))), <, 30)), Compare(Distance Between(Add(Multiply(Distance Between(Eye Position(Local Player), Value In Array(Global.bastionPosition, Evaluate Once(Global.I))), Facing Direction Of(Local Player)), Eye Position(Local Player)), Value In Array(Global.bastionPosition, Evaluate Once(Global.I))), <=, 4)), Local Player, Null), Multiply(Divide(Subtract(30, Subtract(Total Time Elapsed, Value In Array((Local Player).anaSleepLimit, Evaluate Once(Global.I)))), 30), 100), Custom String("麻醉限制: 剩余 {0} 秒 ", Min(30, Subtract(30, Round To Integer(Subtract(Total Time Elapsed, Value In Array((Local Player).anaSleepLimit, Evaluate Once(Global.I))), Down)))), Value In Array(Global.bastionPosition, Evaluate Once(Global.I)), 1, Do Not Clip, Color(Blue), Color(White), Visible To and Values, Default Visibility);
            Set Global Variable At Index(textIDs, 3, Mapped Array(Value In Array(Global.textIDs, 3), If-Then-Else(Compare(Current Array Index, ==, Global.I), Last Text ID, Current Array Element)));
        End;
        Wait Until(Not(Is Hero Being Played(Hero(Ana), Team 1)), 999999999999);
        For Global Variable(I, 0, Count Of(Value In Array(Global.textIDs, 3)), True);
            Destroy Progress Bar In-World Text(Value In Array(Value In Array(Global.textIDs, 3), Global.I));
        End;
        Destroy HUD Text(Value In Array(Global.textIDs, 4));
    }
}

