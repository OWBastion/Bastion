    }
    actions {
        Set Player Variable(Event Player, eventMissionGoal, Max(6, Min(Round To Integer(Add(6, Multiply(Divide(Add(Random Real(0, 1), Random Real(0, 1)), 2), Subtract(Max(6, Round To Integer(Multiply(Count Of(Global.bastionPosition), 0.75), Nearest)), 6))), Nearest), Max(6, Round To Integer(Multiply(Count Of(Global.bastionPosition), 0.75), Nearest)))));
        Set Player Variable(Event Player, hudText, Custom String("{0}/{1}", Count Of((Event Player).eventMission), (Event Player).eventMissionGoal));
        Wait((Event Player).eventDuration, Ignore Condition);
    }
}

rule ("[VishkarEvent]: 任务：殉道者 (进度检测)") {
    event {
        Player Died;
        Team 1;
        All;
    }
    conditions {
        Is True For All(Array(Has Spawned(Event Player), Compare((Event Player).eventType, ==, Null), Compare((Event Player).eventId, ==, 18)), Current Array Element) == True;
        Team Of(Attacker) == Team 2;
        Array Contains((Event Player).eventMission, Attacker) == False;
    }
    actions {
        Modify Player Variable(Event Player, eventMission, Append To Array, Attacker);
        Set Player Variable(Event Player, hudText, Custom String("{0}/{1}", Count Of((Event Player).eventMission), (Event Player).eventMissionGoal));
        If(Compare(Count Of((Event Player).eventMission), ==, (Event Player).eventMissionGoal));
            Wait Until(Is Alive(Event Player), 3);
            Big Message(Event Player, Custom String("任务：殉道者 完成！"));
            Small Message(Event Player, Custom String("  {0}  任务奖励：永久获得 5% 伤害减免", Ability Icon String(Hero(Hazard), Button(Secondary Fire))));
            Modify Player Variable(Event Player, mod_dmg_perma, Add, -5);
            Call Subroutine(updatePlayerStats);
            Set Player Variable(Event Player, eventDuration, Null);
    }
}

