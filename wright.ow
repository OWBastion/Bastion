disabled rule ("在保留原作者署名与原模式代码来源说明的前提下，你可基于本模式及其代码进行非商用二次创作与发布") {
    event {
        Ongoing - Global;
    }
}

rule ("Initialize global variables") {
    event {
        Ongoing - Global;
    }
    actions {
        Set Global Variable(rebootTime, Multiply(Workshop Setting Real(Custom String("1. 游戏"), Custom String("自动重开时间间隔（小时）"), 3.5, 1, 4, 0), 3600));
        Set Global Variable(debugMode, Workshop Setting Toggle(Custom String("1. 游戏"), Custom String("Debug 模式"), False, 5));
        Set Global Variable(hashTag, If-Then-Else(Evaluate Once(Global.debugMode), False, True));
        Set Global Variable(hashTagWeightVerifyState, Array(False, Null));
        Set Global Variable(bastionBotTargetPrefer, Workshop Setting Combo(Custom String("1. 游戏"), Custom String("AI 堡垒瞄准规则"), 0, Array(Custom String("自动"), Custom String("近距离优先"), Custom String("低生命值优先")), 2));
        Set Global Variable(difficulty, Workshop Setting Combo(Custom String("1. 游戏"), Custom String("难度"), 0, Array(Custom String("简单"), Custom String("一般"), Custom String("困难"), Custom String("专家"), Custom String("传奇"), Custom String("地狱：无法跳过英雄")), 1));
        Set Global Variable(dmgReduction, Workshop Setting Toggle(Custom String("1. 游戏"), Custom String("全英雄威能充能"), True, 4));
        Set Global Variable(bastionBotSeconFire, Workshop Setting Toggle(Custom String("1. 游戏"), Custom String("AI 堡垒使用榴弹（忽略难度）"), False, 3));
        Set Global Variable(classicMapVariant, Workshop Setting Combo(Custom String("1. 游戏"), Custom String("经典版地图"), 0, Array(Custom String("关闭"), Custom String("皇家赛道"), Custom String("巴黎"), Custom String("花村")), 6));
        Set Global Variable(turnSpeedMultiplier, If-Then-Else(Compare(Global.difficulty, <, 4), Add(4, Global.difficulty), 9.600000000000001));
        Set Global Variable(maxDeath, Multiply(5, Global.difficulty));
        Set Global Variable(savedIndex, Empty Array);
        Set Global Variable(savedData, Array(Empty Array, Empty Array, Empty Array, Empty Array, Empty Array, Empty Array, Empty Array));
        Set Global Variable(masteryRunCode, Char In String(Empty Array, False));
        Set Global Variable(globalOnceEventState, Empty Array);
        Set Global Variable(gamblerHeartsteelJackpot, Null);
        Set Global Variable(devList, Array(Custom String("他又"), Custom String("别感冒")));
        Set Global Variable(obstrucVis, Empty Array);
        Set Global Variable(masteryRunCode, Custom String("{0}-{1}-{2}", Random Integer(1000, 9999), Random Integer(1000, 9999), Random Integer(1000, 9999)));
    }
}

rule ("Update targetPlayer when player left") {
    event {
        Player Left Match;
        Team 1;
        All;
    }
    actions {
        Destroy Effect(First Of((Event Player).invincibleEffect));
        Destroy Effect(Value In Array((Event Player).invincibleEffect, True));
        Destroy Effect(Value In Array((Event Player).invincibleEffect, 2));
        Destroy Effect(Value In Array((Event Player).invincibleEffect, 3));
        Set Player Variable(Event Player, invincibleEffect, Array(Null, Null, Null, Null));
        Wait(Multiply(Divide(Server Load Average, 100), 0.032), Ignore Condition);
        Set Global Variable(targetPlayerIndex, Null);
        Set Global Variable(targetPlayer, First Of(Sorted Array(All Players(Team 1), (Current Array Element).joinTime)));
        If(Compare((Event Player).hudTextId, !=, Null));
            Destroy HUD Text((Event Player).hudTextId);
    }
}

