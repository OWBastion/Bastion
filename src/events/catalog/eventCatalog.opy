#!mainFile "../../main.opy"

#Only remove the following directive if the gamemode does not use tricks such as A+0, A*0, "am" == "**", etc which would otherwise be optimized out.
#!optimizeStrict

rule "initialize event array":
    @Condition vishkarEventActivated == true

    eventWeight = EVT_INIT_EVENT_WEIGHT
    
    eventCatalogId = []
    eventName = []
    eventDesc = []
    eventDuration = []
    eventCatalogWeight = []
    eventCatalogType = []
    eventCatalogRows = [
    # 0: EventId.OLIVIA_GIFT
    [STR_EVT_BUFF_0_TITLE, STR_EVT_BUFF_0_DESC, EVT_BUFF_0_DURATION, EVT_BUFF_0_WEIGHT, EventType.BUFF],
    # 1: EventId.GALE_BLESSING
    [STR_EVT_BUFF_1_TITLE, STR_EVT_BUFF_1_DESC.format(EVT_1_SPEED_BOOST), EVT_BUFF_1_DURATION, EVT_BUFF_1_WEIGHT, EventType.BUFF],
    # 2: EventId.IRON_BULWARK
    [STR_EVT_BUFF_2_TITLE, STR_EVT_BUFF_2_DESC.format(EVT_2_ARMOR_FLAT, percent(EVT_2_ARMOR_MAXHP_FACTOR), negToPos(EVT_2_DMG_TAKEN)), EVT_BUFF_2_DURATION, EVT_BUFF_2_WEIGHT, EventType.BUFF],
    # 3: EventId.LIFE_SPRING
    [STR_EVT_BUFF_4_TITLE, STR_EVT_BUFF_4_DESC.format(percent(EVT_4_HEALTH_MAXHP_FACTOR), percent(EVT_4_HEAL_PERCENT)), EVT_BUFF_4_DURATION, EVT_BUFF_4_WEIGHT, EventType.BUFF],
    # 4: EventId.BLACK_FANS_ASSAULT
    [STR_EVT_BUFF_5_TITLE, STR_EVT_BUFF_5_DESC.format(EVT_5_BASE_HEALTH, percent(EVT_5_HEALTH_MAXHP_PERCENT), EVT_5_SPEED_BOOST), EVT_BUFF_5_DURATION, EVT_BUFF_5_WEIGHT, EventType.BUFF],
    # 5: EventId.SPEED_STACK
    [STR_EVT_BUFF_6_TITLE, STR_EVT_BUFF_6_DESC.format(EVT_6_SPEED_INC_PER_SEC), EVT_BUFF_6_DURATION, EVT_BUFF_6_WEIGHT, EventType.BUFF],
    # 6: EventId.FLESH_REGEN
    [STR_EVT_BUFF_7_TITLE, STR_EVT_BUFF_7_DESC.format(EVT_7_BASE_HEALTH, percent(EVT_7_HEALTH_PERCENT), EVT_7_REGEN_INTERVAL), EVT_BUFF_7_DURATION, EVT_BUFF_7_WEIGHT, EventType.BUFF],
    # 7: EventId.HEART_OF_STEEL
    [STR_EVT_BUFF_8_TITLE, STR_EVT_BUFF_8_DESC.format(EVT_8_HP_LAYER_PER_DEATH, EVT_8_HP_PERCENT_PER_STACK), EVT_BUFF_8_DURATION, EVT_BUFF_8_WEIGHT, EventType.BUFF],
    # 8: EventId.DEATH_DELAY
    [STR_EVT_BUFF_9_TITLE, STR_EVT_BUFF_9_DESC, EVT_BUFF_9_DURATION, EVT_BUFF_9_WEIGHT, EventType.BUFF],
    # 9: EventId.KONAMI_CODE
    [STR_EVT_BUFF_11_TITLE, STR_EVT_BUFF_11_DESC, EVT_BUFF_11_DURATION, EVT_BUFF_11_WEIGHT, EventType.BUFF],
    # 10: EventId.PHOTON_SHIELD
    [STR_EVT_BUFF_12_TITLE, STR_EVT_BUFF_12_DESC.format(EVT_12_BASE_SHIELD, percent(EVT_12_SHIELD_PERCENT)), EVT_BUFF_12_DURATION, EVT_BUFF_12_WEIGHT, EventType.BUFF],
    # 11: EventId.REGROUP_CALL
    [STR_EVT_BUFF_13_TITLE, STR_EVT_BUFF_13_DESC.format(EVT_13_CHECK_INTERVAL, EVT_13_INVINCIBLE_DURATION), EVT_BUFF_13_DURATION, EVT_BUFF_13_WEIGHT, EventType.BUFF],
    # 12: EventId.WILL_TO_WIN
    [STR_EVT_BUFF_14_TITLE, STR_EVT_BUFF_14_DESC.format(percent(EVT_14_TRIGGER_HP_PERCENT), EVT_14_INVINCIBLE_DURATION), EVT_BUFF_14_DURATION, EVT_BUFF_14_WEIGHT, EventType.BUFF],
    # 13: EventId.PHEIDIPPIDES_TRIAL
    [STR_EVT_BUFF_15_TITLE, STR_EVT_BUFF_15_DESC.format(EVT_15_DISTANCE_GOAL, EVT_15_REWARD_SPEED), EVT_BUFF_15_DURATION, EVT_BUFF_15_WEIGHT, EventType.BUFF],
    # 14: EventId.HEART_OF_STEEL_PRO
    [STR_EVT_BUFF_16_TITLE, STR_EVT_BUFF_16_DESC.format(EVT_16_HP_GAIN_FLAT, EVT_16_HP_MULTIPLIER), EVT_BUFF_16_DURATION, EVT_BUFF_16_WEIGHT, EventType.BUFF],
    # 15: EventId.ULT_MOMENTUM
    [STR_EVT_BUFF_18_TITLE, STR_EVT_BUFF_18_DESC.format(EVT_18_DMG_REDUCTION_DURING_ULT), EVT_BUFF_18_DURATION, EVT_BUFF_18_WEIGHT, EventType.BUFF],
    # 16: EventId.PHASE_SURGE
    [STR_EVT_BUFF_19_TITLE, STR_EVT_BUFF_19_DESC.format(EVT_19_SPEED_BOOST, EVT_19_SPEED_BONUS_PER_TRIGGER), EVT_BUFF_19_DURATION, EVT_BUFF_19_WEIGHT, EventType.BUFF],
    # 17: EventId.BODYGUARD
    [STR_EVT_BUFF_20_TITLE, STR_EVT_BUFF_20_DESC, EVT_BUFF_20_DURATION, EVT_BUFF_20_WEIGHT, EventType.BUFF],
    # 18: EventId.MARTYR_TRIAL
    [STR_EVT_BUFF_21_TITLE, STR_EVT_BUFF_21_DESC.format(negToPos(EVT_21_REWARD_DMG_PERMA)), EVT_BUFF_21_DURATION, EVT_BUFF_21_WEIGHT, EventType.BUFF],
    # 19: EventId.F5_REFRESH
    [STR_EVT_BUFF_24_TITLE, STR_EVT_BUFF_24_DESC.format(EVT_24_REFRESH_INTERVAL), EVT_BUFF_24_DURATION, EVT_BUFF_24_WEIGHT, EventType.BUFF],
    # 20: EventId.HEALING_TOWER_PROMAX
    [STR_EVT_BUFF_25_TITLE, STR_EVT_BUFF_25_DESC.format(EVT_25_HEAL_FLAT, percent(EVT_25_HEAL_MAXHP_FACTOR)), EVT_BUFF_25_DURATION, EVT_BUFF_25_WEIGHT, EventType.BUFF],
    # 21: EventId.MAGIC_MASTER
    [STR_EVT_BUFF_29_TITLE, STR_EVT_BUFF_29_DESC.format(EVT_29_SPEED_BOOST), EVT_BUFF_29_DURATION, EVT_BUFF_29_WEIGHT, EventType.BUFF],
    # 22: EventId.DIVINE_REINFORCEMENT
    [STR_EVT_BUFF_30_TITLE, STR_EVT_BUFF_30_DESC.format(Button.RELOAD, EVT_30_HEAL_FLAT, percent(EVT_30_HEAL_MAXHP_FACTOR), EVT_30_COOLDOWN), EVT_BUFF_30_DURATION, EVT_BUFF_30_WEIGHT, EventType.BUFF],
    # 23: EventId.TEMPER_HEART
    [STR_EVT_BUFF_31_TITLE, STR_EVT_BUFF_31_DESC.format(EVT_31_HERO_GOAL_MULTI if (controlJumpPosition != null and portalPosition == null) else EVT_31_HERO_GOAL, EVT_31_STACK_MULTIPLIER, EVT_8_HP_PERCENT_PER_STACK, EVT_8_HP_PERCENT_PER_STACK + EVT_31_PERCENT_PER_STACK_BONUS), EVT_BUFF_31_DURATION, EVT_BUFF_31_WEIGHT, EventType.BUFF],
    # 24: EventId.BATTLEFIELD_MEDIC
    [STR_EVT_BUFF_32_TITLE, STR_EVT_BUFF_32_DESC.format(EVT_32_HEAL_BASE, EVT_32_HEAL_PER_PLAYER, EVT_32_REWARD_HEAL_PERMA), EVT_BUFF_32_DURATION, EVT_BUFF_32_WEIGHT, EventType.BUFF],
    # 25: EventId.SHARED_BLESSING
    [STR_EVT_BUFF_34_TITLE, STR_EVT_BUFF_34_DESC.format(Button.INTERACT, EVT_34_REWARD_BASE, EVT_34_REWARD_PER_BASTION), EVT_BUFF_34_DURATION, EVT_BUFF_34_WEIGHT, EventType.BUFF],
    # 26: EventId.SOLO_RUN
    [STR_EVT_BUFF_36_TITLE, STR_EVT_BUFF_36_DESC.format(EVT_36_DMG_REDUCTION, EVT_36_HEAL_BONUS, EVT_36_SPEED_BONUS, EVT_36_KNOCKBACK_RESIST), EVT_BUFF_36_DURATION, EVT_BUFF_36_WEIGHT, EventType.BUFF],
    # 27: EventId.SOLO_LEVEL_UP
    [STR_EVT_BUFF_37_TITLE, STR_EVT_BUFF_37_DESC.format(EVT_37_REWARD_HEARTSTEEL, EVT_37_REWARD_DMG_REDUCTION, EVT_37_REWARD_SPEED, EVT_37_REWARD_HEAL, EVT_37_EXTEND_SECONDS), EVT_BUFF_37_DURATION, EVT_BUFF_37_WEIGHT, EventType.BUFF],
    # 28: EventId.GRAVITY_ANOMALY
    [STR_EVT_DEBUFF_0_TITLE, STR_EVT_DEBUFF_0_DESC, EVT_DEBUFF_0_DURATION, EVT_DEBUFF_0_WEIGHT, EventType.DEBUFF],
    # 29: EventId.EMP
    [STR_EVT_DEBUFF_1_TITLE, STR_EVT_DEBUFF_1_DESC, EVT_DEBUFF_1_HACK_DURATION, EVT_DEBUFF_1_WEIGHT, EventType.DEBUFF],
    # 30: EventId.SACRIFICE
    [STR_EVT_DEBUFF_2_TITLE, STR_EVT_DEBUFF_2_DESC.format(percent(EVT_DEBUFF_2_DMG_PERCENT)), EVT_DEBUFF_2_DURATION, EVT_DEBUFF_2_WEIGHT, EventType.DEBUFF],
    # 31: EventId.VULNERABLE
    [STR_EVT_DEBUFF_3_TITLE, STR_EVT_DEBUFF_3_DESC.format(EVT_DEBUFF_3_DMG_TAKEN), EVT_DEBUFF_3_DURATION, EVT_DEBUFF_3_WEIGHT, EventType.DEBUFF],
    # 32: EventId.SPEED_LIMIT_40
    [STR_EVT_DEBUFF_4_TITLE, STR_EVT_DEBUFF_4_DESC.format(EVT_DEBUFF_4_DMG_BASE, percent(EVT_DEBUFF_4_DMG_PERCENT)), EVT_DEBUFF_4_DURATION, EVT_DEBUFF_4_WEIGHT, EventType.DEBUFF],
    # 33: EventId.GRAVITY_PULL
    [STR_EVT_DEBUFF_5_TITLE, STR_EVT_DEBUFF_5_DESC.format(EVT_DEBUFF_5_SPEED_REDUCTION), EVT_DEBUFF_5_DURATION, EVT_DEBUFF_5_WEIGHT, EventType.DEBUFF],
    # 34: EventId.OSTEOPOROSIS
    [STR_EVT_DEBUFF_6_TITLE, STR_EVT_DEBUFF_6_DESC.format(negToPos(EVT_DEBUFF_6_MAX_SPEED_DEC)), EVT_DEBUFF_6_DURATION, EVT_DEBUFF_6_WEIGHT, EventType.DEBUFF],
    # 35: EventId.EMP_PROMAX
    [STR_EVT_DEBUFF_7_TITLE, STR_EVT_DEBUFF_7_DESC.format(EVT_DEBUFF_7_RADIUS), EVT_DEBUFF_7_DURATION, EVT_DEBUFF_7_WEIGHT, EventType.DEBUFF],
    # 36: EventId.ENERGY_LEAK
    [STR_EVT_DEBUFF_8_TITLE, STR_EVT_DEBUFF_8_DESC.format(percent(EVT_DEBUFF_8_DMG_PERCENT)), EVT_DEBUFF_8_DURATION, EVT_DEBUFF_8_WEIGHT, EventType.DEBUFF],
    # 37: EventId.SHARE_THE_PAIN
    [STR_EVT_DEBUFF_9_TITLE, STR_EVT_DEBUFF_9_DESC.format(percent(EVT_DEBUFF_9_DMG_FACTOR)), EVT_DEBUFF_9_DURATION, EVT_DEBUFF_9_WEIGHT, EventType.DEBUFF],
    # 38: EventId.FEAST_FRENZY
    [STR_EVT_DEBUFF_10_TITLE, STR_EVT_DEBUFF_10_DESC.format(EVT_DEBUFF_10_BERSERK_ADD), EVT_DEBUFF_10_DURATION, EVT_DEBUFF_10_WEIGHT, EventType.DEBUFF],
    # 39: EventId.POWERLESS_SPOUSE
    [STR_EVT_DEBUFF_11_TITLE, STR_EVT_DEBUFF_11_DESC.format(EVT_DEBUFF_11_DELAY, EVT_DEBUFF_11_KNOCKDOWN_DURATION), EVT_DEBUFF_11_DURATION, EVT_DEBUFF_11_WEIGHT, EventType.DEBUFF],
    # 40: EventId.HALVED
    [STR_EVT_DEBUFF_13_TITLE, STR_EVT_DEBUFF_13_DESC.format(EVT_DEBUFF_13_INTERVAL, percent(EVT_DEBUFF_13_DAMAGE_PERCENT), percent(EVT_DEBUFF_13_EXECUTE_THRESHOLD)), EVT_DEBUFF_13_DURATION, EVT_DEBUFF_13_WEIGHT, EventType.DEBUFF],
    # 41: EventId.SELFLESS_GIVEAWAY
    [STR_EVT_DEBUFF_14_TITLE, STR_EVT_DEBUFF_14_DESC.format(EVT_DEBUFF_14_STACKS_TAKE), EVT_DEBUFF_14_DURATION, EVT_DEBUFF_14_WEIGHT, EventType.DEBUFF],
    # 42: EventId.KEEP_DISTANCE_AURA
    [STR_EVT_DEBUFF_15_TITLE, STR_EVT_DEBUFF_15_DESC, EVT_DEBUFF_15_DURATION, EVT_DEBUFF_15_WEIGHT, EventType.DEBUFF],
    # 43: EventId.MOON_ROCKET
    [STR_EVT_DEBUFF_20_TITLE, STR_EVT_DEBUFF_20_DESC, EVT_DEBUFF_20_DURATION, EVT_DEBUFF_20_WEIGHT, EventType.DEBUFF],
    # 44: EventId.ADLERSBRUNN_WRAITH
    [STR_EVT_DEBUFF_21_TITLE, STR_EVT_DEBUFF_21_DESC.format(percent(EVT_DEBUFF_21_DRAIN_MAXHP_FACTOR), negToPos(EVT_DEBUFF_21_DEATH_HEAL_PERMA)), EVT_DEBUFF_21_DURATION, EVT_DEBUFF_21_WEIGHT, EventType.DEBUFF],
    # 45: EventId.WAYWARD_NAVIGATION
    [STR_EVT_DEBUFF_22_TITLE, STR_EVT_DEBUFF_22_DESC.format(EVT_DEBUFF_22_INTERVAL), EVT_DEBUFF_22_DURATION, EVT_DEBUFF_22_WEIGHT, EventType.DEBUFF],
    # 46: EventId.OVERWEIGHT_PACK
    [STR_EVT_DEBUFF_23_TITLE, STR_EVT_DEBUFF_23_DESC.format(EVT_DEBUFF_23_HP_UNIT, EVT_DEBUFF_23_DMG_TAKEN_PER_UNIT), EVT_DEBUFF_23_DURATION, EVT_DEBUFF_23_WEIGHT, EventType.DEBUFF],
    # 47: EventId.STATIC_FIELD
    [STR_EVT_DEBUFF_25_TITLE, STR_EVT_DEBUFF_25_DESC.format(EVT_DEBUFF_25_TRIGGER_RADIUS, EVT_DEBUFF_25_STUN), EVT_DEBUFF_25_DURATION, EVT_DEBUFF_25_WEIGHT, EventType.DEBUFF],
    # 48: EventId.EXTREME_CHALLENGE
    [STR_EVT_MECH_0_TITLE, STR_EVT_MECH_0_DESC.format(negToPos(EVT_MECH_0_DMG_TAKEN), percent(EVT_MECH_0_HP_PERCENT)), EVT_MECH_0_DURATION, EVT_MECH_0_WEIGHT, EventType.MECH],
    # 49: EventId.GAMBLER
    [STR_EVT_MECH_1_TITLE, STR_EVT_MECH_1_DESC.format(Button.RELOAD, EVT_MECH_1_WIN_RATE, EVT_MECH_1_REWARD_STACKS, 100 - EVT_MECH_1_WIN_RATE, EVT_MECH_1_STAKE), EVT_MECH_1_DURATION, EVT_MECH_1_WEIGHT, EventType.MECH],
    # 50: EventId.MINI_FORM
    [STR_EVT_MECH_2_TITLE, STR_EVT_MECH_2_DESC.format(percent(1 - EVT_MECH_2_MODEL_SCALE), percent(1 - EVT_MECH_2_HP_SCALE), EVT_MECH_2_SPEED_BOOST), EVT_MECH_2_DURATION, EVT_MECH_2_WEIGHT, EventType.MECH],
    # 51: EventId.STEALTH_CROUCH
    [STR_EVT_MECH_3_TITLE, STR_EVT_MECH_3_DESC.format(percent(EVT_MECH_3_HP_COST_RATIO), EVT_MECH_3_SPEED_BOOST), EVT_MECH_3_DURATION, EVT_MECH_3_WEIGHT, EventType.MECH],
    # 52: EventId.BRAKE_FAILURE
    [STR_EVT_MECH_4_TITLE, STR_EVT_MECH_4_DESC.format(100 + EVT_MECH_4_MAX_SPEED), EVT_MECH_4_DURATION, EVT_MECH_4_WEIGHT, EventType.MECH],
    # 53: EventId.JUMP_THRUST
    [STR_EVT_MECH_5_TITLE, STR_EVT_MECH_5_DESC.format(Button.JUMP, negToPos(EVT_MECH_5_DMG_TAKEN)), EVT_MECH_5_DURATION, EVT_MECH_5_WEIGHT, EventType.MECH],
    # 54: EventId.GAMBLER_SPEED_CHALLENGE
    [STR_EVT_MECH_6_TITLE, STR_EVT_MECH_6_DESC.format(Button.RELOAD, EVT_MECH_6_HEARTSTEEL_COST, EVT_MECH_6_PROB_LOSE_NORMAL - EVT_MECH_6_PROB_WIN_NORMAL, EVT_MECH_6_VAL_NORMAL, 100 - EVT_MECH_6_PROB_LOSE_NORMAL, EVT_MECH_6_VAL_RARE), EVT_MECH_6_DURATION, EVT_MECH_6_WEIGHT, EventType.MECH],
    # 55: EventId.CHEAT_CARD_COUNTING
    [STR_EVT_MECH_7_TITLE, STR_EVT_MECH_7_DESC.format(Button.RELOAD, EVT_MECH_7_HEART_STEEL_COST, EVT_MECH_7_HEART_STEEL_COST * EVT_8_HP_PERCENT_PER_STACK), EVT_MECH_7_DURATION, EVT_MECH_7_WEIGHT, EventType.MECH],
    # 56: EventId.GAMBLER_SHORT_INVESTMENT
    [STR_EVT_MECH_8_TITLE, STR_EVT_MECH_8_DESC.format(Button.RELOAD, EVT_MECH_8_CONTRACT_EVENTS, EVT_MECH_8_WIN_CHANCE, EVT_MECH_8_REWARD_STACKS), EVT_MECH_8_DURATION, EVT_MECH_8_WEIGHT, EventType.MECH],
    # 57: EventId.CHEAT_SKIP_HERO
    [STR_EVT_MECH_10_TITLE, STR_EVT_MECH_10_DESC.format(Button.RELOAD), EVT_MECH_10_DURATION, EVT_MECH_10_WEIGHT, EventType.MECH],
    # 58: EventId.NESTING_DOLL
    [STR_EVT_MECH_11_TITLE, STR_EVT_MECH_11_DESC.format(EVT_MECH_11_RESURRECT_DELAY, percent(EVT_MECH_11_SIZE_STEP), EVT_MECH_11_SPEED_STEP), EVT_MECH_11_DURATION, EVT_MECH_11_WEIGHT, EventType.MECH],
    # 59: EventId.GAMBLER_LONG_INVESTMENT
    [STR_EVT_MECH_12_TITLE, STR_EVT_MECH_12_DESC.format(Button.RELOAD, EVT_MECH_12_CONTRACT_EVENTS, EVT_MECH_12_WIN_CHANCE, EVT_MECH_12_REWARD_STACKS), EVT_MECH_12_DURATION, EVT_MECH_12_WEIGHT, EventType.MECH],
    # 60: EventId.VALKYRIE_DESCENT
    [STR_EVT_MECH_13_TITLE, STR_EVT_MECH_13_DESC.format(EVT_MECH_13_SIZE_HEALTH * 100, percent(EVT_MECH_13_HEAL_SMOOTHING)), EVT_MECH_13_DURATION, EVT_MECH_13_WEIGHT, EventType.MECH],
    # 61: EventId.TRINITY_SSR
    [STR_EVT_MECH_14_TITLE, STR_EVT_MECH_14_DESC.format(100 / EVT_MECH_14_DMG_REDUCE_DIVISOR, EVT_MECH_14_SPEED_FACTOR, EVT_MECH_14_INTERVAL / EVT_MECH_14_HEART_STEEL_PER_TICK), EVT_MECH_14_DURATION, EVT_MECH_14_WEIGHT, EventType.MECH],
    # 62: EventId.GAMBLER_DICE_MANIAC
    [STR_EVT_MECH_15_TITLE, STR_EVT_MECH_15_DESC.format(EVT_MECH_15_DURATION, Button.RELOAD, EVT_INTERACT_HOLD_TIME, EVT_MECH_15_HEART_STEEL_DELTA, EVT_MECH_15_SPEED_DELTA, EVT_MECH_15_DMG_HEAL_DELTA), EVT_MECH_15_DURATION, EVT_MECH_15_WEIGHT, EventType.MECH],
    # 63: EventId.GAMBLER_HEART_OF_STEEL
    [STR_EVT_MECH_16_TITLE, STR_EVT_MECH_16_DESC.format(Button.RELOAD, EVT_MECH_16_WIN_RATE, EVT_MECH_16_WIN_MULTIPLIER, 100 - EVT_MECH_16_WIN_RATE, percent(EVT_MECH_16_LOSE_RATIO)), EVT_MECH_16_DURATION, EVT_MECH_16_WEIGHT, EventType.MECH],
    # 64: EventId.GAMBLER_ALL_IN_ART_5
    [STR_EVT_MECH_17_TITLE, STR_EVT_MECH_17_DESC.format(Button.RELOAD, percent(EVT_MECH_17_STAKE_RATIO), EVT_MECH_17_WIN_RATE, EVT_MECH_17_WIN_MULTIPLIER), EVT_MECH_17_DURATION, EVT_MECH_17_WEIGHT, EventType.MECH],
    # 65: EventId.VAMPIRE
    [STR_EVT_MECH_18_TITLE, STR_EVT_MECH_18_DESC.format(EVT_MECH_18_DRAIN_FLAT, percent(EVT_MECH_18_DRAIN_MAXHP_FACTOR), EVT_MECH_18_KILL_HEAL_PERMA), EVT_MECH_18_DURATION, EVT_MECH_18_WEIGHT, EventType.MECH],
    # 66: EventId.THIEF
    [STR_EVT_MECH_19_TITLE, STR_EVT_MECH_19_DESC.format(Button.RELOAD), EVT_MECH_19_DURATION, EVT_MECH_19_WEIGHT, EventType.MECH],
    # 67: EventId.GAMBLER_HELPFUL_SOUL
    [STR_EVT_MECH_20_TITLE, STR_EVT_MECH_20_DESC.format(Button.RELOAD, EVT_MECH_20_WIN_RATE, percent(EVT_MECH_20_HEAL_MAXHP_FACTOR), 100 - EVT_MECH_20_WIN_RATE, EVT_MECH_20_HOT_DURATION, percent(EVT_MECH_20_HOT_MAXHP_FACTOR)), EVT_MECH_20_DURATION, EVT_MECH_20_WEIGHT, EventType.MECH],
    # 68: EventId.CHEAT_BACKROOM_DEAL
    [STR_EVT_MECH_22_TITLE, STR_EVT_MECH_22_DESC.format(Button.RELOAD, EVT_MECH_22_HEART_STEEL_COST, EVT_MECH_22_HEART_STEEL_COST * EVT_8_HP_PERCENT_PER_STACK), EVT_MECH_22_DURATION, EVT_MECH_22_WEIGHT, EventType.MECH],
    # 69: EventId.MIRROR_INVERSION
    [STR_EVT_MECH_23_TITLE, STR_EVT_MECH_23_DESC.format(Button.RELOAD), EVT_MECH_23_DURATION, EVT_MECH_23_WEIGHT, EventType.MECH],
    # 70: EventId.GAMBLER_WINNER_TAKE_ALL
    [STR_EVT_MECH_24_TITLE, STR_EVT_MECH_24_DESC.format(Button.RELOAD, percent(EVT_MECH_24_STAKE_RATIO), EVT_MECH_24_WIN_RATE), EVT_MECH_24_DURATION, EVT_MECH_24_WEIGHT, EventType.MECH],
    # 71: EventId.PROPHET
    [STR_EVT_MECH_25_TITLE, STR_EVT_MECH_25_DESC, EVT_MECH_25_DURATION, EVT_MECH_25_WEIGHT, EventType.MECH],
    # 72: EventId.SOLO_DECIDE
    [STR_EVT_MECH_26_TITLE, STR_EVT_MECH_26_DESC.format(Button.RELOAD, EVT_26_EXTEND_SECONDS, Button.INTERACT), EVT_MECH_26_DURATION, EVT_MECH_26_WEIGHT, EventType.MECH]
    ]

    for I in range(len(eventCatalogRows)):
        eventName[I] = eventCatalogRows[I][0]
        eventDesc[I] = eventCatalogRows[I][1]
        eventDuration[I] = eventCatalogRows[I][2]
        eventCatalogWeight[I] = eventCatalogRows[I][3]
        eventCatalogType[I] = eventCatalogRows[I][4]
    eventCatalogRows = null

    # 目录顺序由入口各自的 events/catalog/eventCatalog{Main,Dev}.opy 提供
    eventCatalogId = EVENT_CATALOG_ORDER
