{
  "name": "bastion",
  "private": true,
  "version": "1.0.0",
  "description": "Build tooling for OverPy workshop outputs",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build:main": "overpy compile -i src/main.opy -o build/main.ow -l zh-CN",
    "build:dev": "overpy compile -i src/devMain.opy -o build/devMain.ow -l zh-CN",
    "build:main:en": "overpy compile -i src/main.opy -o build/en-US.ow -l en-US",
    "build:main:zh": "overpy compile -i src/main.opy -o build/zh-CN.ow -l zh-CN",
    "tools": "tsx tools/cli.ts",
    "sync": "pnpm run tools -- sync",
    "sync:title-data": "pnpm run tools -- sync:title-data",
    "export:platform-title-catalog": "pnpm run tools -- export:platform-title-catalog",
    "sync:event-data": "pnpm run tools -- sync:event-data",
    "sync:platform-data": "pnpm run tools -- sync:platform-data",
    "sync:effect-glossary": "pnpm run tools -- sync:effect-glossary",
    "sync:grant-general-title-workflow": "pnpm run tools -- sync:grant-general-title-workflow",
    "event:finalize": "pnpm run tools -- event:finalize",
    "grant:title": "pnpm run tools -- grant:title",
    "perf:scan": "pnpm run tools -- perf:scan",
    "event:add": "pnpm run tools -- event:add",
    "event:remove": "pnpm run tools -- event:remove",
    "bump:env-version": "pnpm run tools -- bump:env-version",
    "test:title-data-sync": "pnpm run tools -- test:title-data-sync",
    "test:event-data-sync": "pnpm run tools -- test:event-data-sync",
    "test:platform-data-sync": "pnpm run tools -- test:platform-data-sync",
    "test:effect-glossary-sync": "pnpm run tools -- test:effect-glossary-sync",
    "test:title-grant": "pnpm run tools -- test:title-grant",
    "test:grant-general-title-workflow": "pnpm run tools -- test:grant-general-title-workflow",
    "test:event-allocation": "pnpm run tools -- test:event-allocation",
    "tools:test": "pnpm run tools -- test:title-data-sync && pnpm run tools -- test:event-data-sync && pnpm run tools -- test:platform-data-sync && pnpm run tools -- test:effect-glossary-sync && pnpm run tools -- test:title-grant && pnpm run tools -- test:grant-general-title-workflow && pnpm run tools -- test:event-allocation",
    "dev:title-query": "pnpm run tools -- sync && vite --config web/title-query/vite.config.ts",
    "build:title-query": "pnpm run tools -- sync && vite build --config web/title-query/vite.config.ts",
    "build:release": "pnpm run build:main:en && pnpm run build:main:zh",
    "build": "pnpm run build:main && pnpm run build:dev"
  },
  "dependencies": {
    "overpy": "^9.7.9",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "commander": "^15.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
